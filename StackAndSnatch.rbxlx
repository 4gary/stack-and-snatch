  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">220</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[--[[
	Animator: makes the world feel alive and wobbly (client-side only).

	  Towers     jiggle like jelly, more when the tower is wobblier; new creatures
	             drop in with a squash; Toastie hops; Disco Ball Bat spins;
	             Lord Jellington makes the whole tower dance
	  Conveyor   creatures ride the belt smoothly (ConveyorPath + server time)
	  Meadows    wild creatures bounce in place

	The server owns where everything really is; this only moves local copies.
]]

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ConveyorPath = require(Shared.ConveyorPath)

local Animator = {}

local C
local State
Animator.calm = false

local seen = {} -- [model] = first time this client saw it (for drop-in animation)
local initialized = false
local lastWarn = 0

local function rootOf(model: Instance): BasePart?
	return model:FindFirstChild("Root") :: BasePart?
end

local function dropOffset(model: Model, now: number): number
	local first = seen[model]
	if not first then
		seen[model] = initialized and now or -100
		first = seen[model]
	end
	local t = now - first
	if t >= 0.45 then
		return 0
	end
	-- fall from 4 studs with a little bounce
	if t < 0.3 then
		local k = t / 0.3
		return 4 * (1 - k * k)
	end
	return math.sin((t - 0.3) / 0.15 * math.pi) * 0.35
end

local function animateTower(towerFolder: Instance, plotModel: Instance, now: number, camPos: Vector3)
	if plotModel:GetAttribute("Toppling") then
		return
	end
	local children = towerFolder:GetChildren()
	local n = #children
	if n == 0 then
		return
	end
	local first = rootOf(children[1])
	if first and (first.Position - camPos).Magnitude > 420 then
		return
	end
	local wobble = plotModel:GetAttribute("Wobble") or 0
	local yaw = plotModel:GetAttribute("BaseYaw") or 0
	local basis = CFrame.Angles(0, yaw, 0)
	local right = basis.RightVector
	local back = basis.LookVector

	local dance = false
	for _, model in children do
		if model:GetAttribute("CreatureId") == "LordJellington" then
			dance = true
			break
		end
	end
	local amp = (0.12 + math.clamp(wobble, 0, 1.2) * 1.1) * (dance and 1.6 or 1) * (Animator.calm and 0.4 or 1)
	local speed = dance and 5.5 or 3.6

	for _, model in children do
		local root = rootOf(model)
		local basePos = model:GetAttribute("BasePos")
		local layer = model:GetAttribute("Layer") or 1
		if root and basePos then
			local h = layer / math.max(n, 1)
			local sway = amp * h ^ 1.5 * math.sin(now * speed + layer * 0.18)
			local swayZ = amp * 0.4 * h ^ 1.5 * math.sin(now * speed * 0.7 + layer * 0.25)
			local y = dropOffset(model, now)
			local id = model:GetAttribute("CreatureId")
			local spin = 0
			if id == "Toastie" then
				local phase = (now + layer * 7) % 60
				if phase < 0.5 then
					y += math.sin(phase / 0.5 * math.pi) * 1.2
				end
			elseif id == "DiscoBallBat" then
				spin = now * 0.8
			elseif id == "BouncyBean" then
				y += math.abs(math.sin(now * 5 + layer)) * 0.15
			end
			local pos = basePos + right * sway + back * swayZ + Vector3.new(0, y, 0)
			root.CFrame = CFrame.new(pos) * basis * CFrame.Angles(0, spin, 0) * CFrame.Angles(swayZ * 0.04, 0, -sway * 0.06)
		end
	end
end

local function animateConveyor(now: number)
	local folder = workspace:FindFirstChild("Conveyor")
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		local root = rootOf(model)
		local spawnAt = model:GetAttribute("SpawnAt")
		if root and spawnAt then
			local elapsed = now - spawnAt
			local hop = math.abs(math.sin(elapsed * 4)) * 0.4
			root.CFrame = ConveyorPath.cframeAt(elapsed) * CFrame.new(0, hop, 0)
		end
	end
end

local function animateWild(now: number)
	local folder = workspace:FindFirstChild("Wild")
	if not folder then
		return
	end
	for i, model in folder:GetChildren() do
		local root = rootOf(model)
		local basePos = model:GetAttribute("BasePos")
		if root and basePos then
			local t = now + i * 1.7
			local hop = math.abs(math.sin(t * 3)) * 1.6
			local wander = Vector3.new(math.cos(t * 0.4) * 2, hop, math.sin(t * 0.4) * 2)
			root.CFrame = CFrame.new(basePos + wander) * CFrame.Angles(0, t * 0.4 + math.pi / 2, 0)
		end
	end
end

function Animator.init(controllers)
	C = controllers
	State = C.State
end

function Animator.start()
	task.delay(2, function()
		initialized = true
	end)
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = State.now()
		local ok, err = pcall(function()
			animateConveyor(now)
			animateWild(now)
			acc += dt
			if acc < 1 / 40 then
				return
			end
			acc = 0
			local camera = workspace.CurrentCamera
			local camPos = camera and camera.CFrame.Position or Vector3.zero
			local plots = workspace:FindFirstChild("Plots")
			if plots then
				for _, plot in plots:GetChildren() do
					local tower = plot:FindFirstChild("Tower")
					if tower then
						animateTower(tower, plot, now, camPos)
					end
				end
			end
			local map = workspace:FindFirstChild("Map")
			local practice = map and map:FindFirstChild("PracticeTower")
			if practice and practice:FindFirstChild("Tower") then
				animateTower(practice.Tower, practice, now, camPos)
			end
		end)
		if not ok and os.clock() - lastWarn > 5 then
			lastWarn = os.clock()
			warn("[Animator]", err)
		end
	end)
	-- forget models that are gone
	while true do
		task.wait(10)
		for model in seen do
			if not model.Parent then
				seen[model] = nil
			end
		end
	end
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Dialog</string>
              <string name="Source"><![CDATA[--[[
	Dialog: the tutorial's NPC dialog box plus a bouncing arrow that points at
	what to do next (your plate, the conveyor, the practice tower, the shield).
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)
local Root = require(script.Parent.Parent.UI.Root)

local Dialog = {}

local C
local ui = {}
local arrowTarget = nil
local arrowGui: BillboardGui? = nil
local arrowPart: BasePart? = nil
local typing = 0

local function buildArrow()
	local part = Instance.new("Part")
	part.Name = "TutorialArrow"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Parent = workspace.CurrentCamera
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 6)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "⬇️"
	label.TextScaled = true
	label.Font = Kit.Font
	label.Parent = gui
	gui.Enabled = false
	gui.Parent = part
	arrowGui = gui
	arrowPart = part
end

local function targetPosition(): Vector3?
	if arrowTarget == "plate" then
		local origin = C.State.myOrigin()
		return origin and origin.Position + Vector3.new(0, 7, 0)
	elseif arrowTarget == "conveyor" then
		local hrp = C.State.rootPart()
		if hrp then
			local p = hrp.Position
			local flat = Vector3.new(p.X, 0, p.Z)
			local dir = flat.Magnitude > 1 and flat.Unit or Vector3.new(1, 0, 0)
			return dir * Config.Conveyor.Radius + Vector3.new(0, 7, 0)
		end
	elseif arrowTarget == "practice" then
		for _, pegs in CollectionService:GetTagged("SnatchPegs") do
			if pegs:GetAttribute("Practice") then
				return pegs.Position + Vector3.new(0, 16, 0)
			end
		end
	end
	return nil
end

local function setArrow(target: string?)
	arrowTarget = target
	C.Hud.pulseShield(target == "shield")
end

local function build()
	local box = Kit.panel({
		Name = "Dialog",
		Size = UDim2.fromOffset(420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(12, 290),
		BackgroundColor3 = Color3.fromRGB(255, 250, 235),
		Visible = false,
		Parent = Root.hud,
	})
	Kit.padding(12).Parent = box
	Kit.list(nil, 6).Parent = box
	ui.box = box
	ui.npc = Kit.label({ Text = "", TextSize = 22, LayoutOrder = 1, TextColor3 = Kit.Colors.Pink, Parent = box })
	ui.text = Kit.label({
		Text = "",
		TextSize = 19,
		LayoutOrder = 2,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = box,
	})
	ui.progress = Kit.label({ Text = "", TextSize = 17, LayoutOrder = 3, TextColor3 = Kit.Colors.Green, Visible = false, Parent = box })
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 4, Parent = box })
	Kit.list(Enum.FillDirection.Horizontal, 8).Parent = row
	ui.ok = Kit.button({
		Text = "Got it!",
		TextSize = 18,
		Size = UDim2.fromOffset(120, 38),
		Color = Kit.Colors.Green,
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			box.Visible = false
		end,
	})
	ui.skip = Kit.button({
		Text = "Skip tutorial",
		TextSize = 16,
		Size = UDim2.fromOffset(130, 38),
		Color = Kit.Colors.Grey,
		LayoutOrder = 2,
		Parent = row,
		OnClick = function()
			Remotes.get("Tutorial"):FireServer("skip")
			box.Visible = false
			setArrow(nil)
		end,
	})
end

function Dialog.show(payload)
	ui.box.Visible = true
	ui.npc.Text = payload.npc or ""
	ui.progress.Visible = payload.progress ~= nil
	ui.progress.Text = payload.progress or ""
	ui.skip.Visible = payload.canSkip == true
	ui.ok.Text = payload.final and "Let's stack!" or "Got it!"
	setArrow(payload.arrow)
	-- typewriter
	typing += 1
	local token = typing
	local text = payload.text or ""
	ui.text.Text = ""
	task.spawn(function()
		local len = utf8.len(text) or #text
		for i = 1, len, 2 do
			if token ~= typing then
				return
			end
			local cut = utf8.offset(text, i + 2)
			ui.text.Text = cut and string.sub(text, 1, cut - 1) or text
			task.wait(0.012)
		end
		if token == typing then
			ui.text.Text = text
		end
	end)
	if payload.final then
		setArrow(nil)
	end
end

function Dialog.init(controllers)
	C = controllers
	build()
	buildArrow()
	Remotes.get("Dialog").OnClientEvent:Connect(Dialog.show)
	C.State.changed:Connect(function(data)
		if data.tutorial >= 99 and arrowTarget then
			setArrow(nil)
		end
	end)
end

function Dialog.start()
	local t = 0
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		t += dt
		local pos = arrowTarget and targetPosition()
		if pos and arrowGui and arrowPart then
			arrowGui.Enabled = true
			arrowPart.Position = pos + Vector3.new(0, math.abs(math.sin(t * 4)) * 2, 0)
		elseif arrowGui then
			arrowGui.Enabled = false
		end
	end)
end

return Dialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--[[
	Effects: the signature sounds and silly visuals (design doc 3.3).

	  Stack "boop" (pitch rises with height)   Topple "wheeee" + "ta-da!"
	  Snatch "FWIP!"   Boop glove   Dizzy stars   Emote bubbles   Confetti
	  Coin pops over towers   Sprinkle Rain   Fluff-O-Matic sneezes
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureModel = require(Shared.CreatureModel)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Effects = {}

local C
local State
Effects.calm = false
local shakeUntil = 0

local function plotModel(index: number?)
	if not index or index == 0 then
		return nil
	end
	local plots = workspace:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. index)
end

local function towerTop(model: Instance?): Vector3?
	if not model then
		return nil
	end
	local plate = model:FindFirstChild("Plate")
	if not plate then
		return nil
	end
	return Vector3.new(plate.Position.X, Config.Map.PlateTopY + (model:GetAttribute("TowerHeight") or 0), plate.Position.Z)
end

local function characterOf(userId: number?)
	local player = userId and Players:GetPlayerByUserId(userId)
	local character = player and player.Character
	return character, character and character:FindFirstChild("HumanoidRootPart")
end

local function anchorAt(position: Vector3, life: number): BasePart
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position
	part.Parent = workspace.CurrentCamera
	Debris:AddItem(part, life)
	return part
end

-- Floating text that rises and fades ("FWIP!", "+12", "Wheeee!").
function Effects.popText(position: Vector3, text: string, color: Color3?, size: number?, life: number?)
	life = life or 1.4
	local part = anchorAt(position, life + 0.1)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(size or 8, (size or 8) * 0.3)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Adornee = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Kit.Font
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(255, 240, 120)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(70, 35, 80)
	label.Parent = gui
	gui.Parent = part
	TweenService:Create(part, TweenInfo.new(life), { Position = position + Vector3.new(0, 5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
end

local function burst(position: Vector3, colors: { Color3 }, count: number)
	local part = anchorAt(position, 3)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(1, 1.8)
	emitter.Speed = NumberRange.new(14, 26)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Size = NumberSequence.new(0.5)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-200, 200)
	local keys = {}
	for i, c in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	emitter.Color = ColorSequence.new(keys)
	emitter.Parent = part
	emitter:Emit(count)
end

local CONFETTI = {
	Color3.fromRGB(255, 110, 150),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(110, 210, 255),
	Color3.fromRGB(150, 230, 120),
	Color3.fromRGB(190, 130, 255),
}

local function billboardOn(adornee: BasePart, text: string, offset: number, life: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 2)
	gui.StudsOffset = Vector3.new(0, offset, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Kit.Font
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(70, 35, 80)
	label.Parent = gui
	gui.Parent = adornee
	Debris:AddItem(gui, life)
	return gui
end

local function boopGlove(hrp: BasePart)
	local glove = Instance.new("Part")
	glove.Shape = Enum.PartType.Ball
	glove.Size = Vector3.new(3, 3, 3)
	glove.Color = Color3.fromRGB(255, 120, 170)
	glove.Material = Enum.Material.SmoothPlastic
	glove.Anchored = true
	glove.CanCollide = false
	glove.CanQuery = false
	glove.CanTouch = false
	local start = hrp.CFrame * CFrame.new(0, 0.5, -1.5)
	glove.CFrame = start
	glove.Parent = workspace.CurrentCamera
	TweenService:Create(glove, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		CFrame = hrp.CFrame * CFrame.new(0, 0.5, -6),
		Size = Vector3.new(5, 5, 5),
	}):Play()
	task.delay(0.2, function()
		TweenService:Create(glove, TweenInfo.new(0.15), { Transparency = 1 }):Play()
	end)
	Debris:AddItem(glove, 0.5)
end

local function hopHome(from: Vector3, to: Vector3, creatureId: string)
	local model = CreatureModel.build(creatureId, nil, { ghost = true })
	if not model then
		return
	end
	model.Parent = workspace.CurrentCamera
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / 0.9)
		local pos = from:Lerp(to, t) + Vector3.new(0, math.sin(t * math.pi) * 18, 0)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, t * 8, 0))
		if t >= 1 then
			conn:Disconnect()
			model:Destroy()
		end
	end)
end

local HANDLERS = {}

function HANDLERS.Stack(e)
	local pos = towerTop(plotModel(e.plot))
	local height = e.height or 1
	C.Sound.play("Stack", { pitch = math.clamp(0.8 + height * 0.03, 0.8, 2.2), position = pos })
	if pos then
		Effects.popText(pos + Vector3.new(0, 2, 0), "boop!", Color3.fromRGB(150, 255, 170), 5)
		if e.confetti then
			burst(pos, CONFETTI, 60)
		end
	end
end

function HANDLERS.Topple(e)
	local model = e.practice and workspace.Map:FindFirstChild("PracticeTower") or plotModel(e.plot)
	local pos = model and model:FindFirstChild("Plate") and model.Plate.Position + Vector3.new(0, 8, 0)
	C.Sound.play("Topple", { position = pos })
	if pos then
		Effects.popText(pos + Vector3.new(0, 6, 0), "Wheeeee!", Color3.fromRGB(255, 200, 120), 10, 2)
	end
	if State.data and e.plot == State.data.plotIndex and not Effects.calm then
		shakeUntil = os.clock() + 0.6
	end
end

function HANDLERS.Restack(e)
	local pos = typeof(e.pos) == "Vector3" and e.pos or nil
	C.Sound.play("Restack", { pitch = 1.2, position = pos })
	if pos then
		Effects.popText(pos + Vector3.new(0, 8, 0), "Ta-da!", Color3.fromRGB(180, 255, 200), 7, 1.6)
	end
end

function HANDLERS.Snatch(e)
	local _, hrp = characterOf(e.userId)
	C.Sound.play("Snatch", { position = hrp and hrp.Position })
	if hrp then
		Effects.popText(hrp.Position + Vector3.new(0, 5, 0), "FWIP!", Color3.fromRGB(255, 240, 120), 8)
	end
end

function HANDLERS.SnatchHome(e)
	local _, hrp = characterOf(e.userId)
	if hrp then
		Effects.popText(hrp.Position + Vector3.new(0, 6, 0), "Snatched!", Color3.fromRGB(255, 200, 120), 8)
		burst(hrp.Position, CONFETTI, 30)
	end
end

function HANDLERS.Boop(e)
	local _, hrp = characterOf(e.userId)
	if hrp then
		boopGlove(hrp)
		C.Sound.play("Boop", { pitch = 1.4, position = hrp.Position })
		Effects.popText(hrp.Position + Vector3.new(0, 5, 0), "BOOP!", Color3.fromRGB(255, 140, 190), 6, 0.8)
	end
end

function HANDLERS.Knockback(e)
	local hrp = State.rootPart()
	if hrp and typeof(e.dir) == "Vector3" then
		hrp.AssemblyLinearVelocity = e.dir
	end
end

function HANDLERS.HopHome(e)
	local to = towerTop(plotModel(e.plot))
	if to and typeof(e.from) == "Vector3" and e.id then
		hopHome(e.from, to, e.id)
	end
end

function HANDLERS.Dizzy(e)
	local _, hrp = characterOf(e.userId)
	if hrp then
		billboardOn(hrp, "💫 💫 💫", 4, Config.Snatch.StunSeconds)
	end
end

function HANDLERS.Emote(e)
	local _, hrp = characterOf(e.userId)
	if hrp then
		local gui = billboardOn(hrp, e.text or "", 5.5, 3)
		gui.Size = UDim2.fromScale(7, 1.8)
		local label = gui:FindFirstChildOfClass("TextLabel")
		if label then
			label.BackgroundTransparency = 0
			label.BackgroundColor3 = Color3.fromRGB(255, 250, 240)
			label.TextColor3 = Color3.fromRGB(90, 50, 100)
			label.TextStrokeTransparency = 1
			Kit.corner(12).Parent = label
		end
	end
end

function HANDLERS.Sneeze(e)
	local chimney = workspace:FindFirstChild("Map")
		and workspace.Map:FindFirstChild("FluffOMatic")
		and workspace.Map.FluffOMatic:FindFirstChild("Chimney")
	local puff = chimney and chimney:FindFirstChild("SneezePuff")
	if puff then
		puff:Emit(12)
	end
	if e.rarity and e.rarity ~= "Common" and e.rarity ~= "Uncommon" and chimney then
		C.Sound.play("Sneeze", { position = chimney.Position })
		Effects.popText(chimney.Position + Vector3.new(0, 6, 0), "AH-CHOO!", Color3.fromRGB(255, 220, 240), 10)
	end
end

function HANDLERS.Shield(e)
	local pos = towerTop(plotModel(e.plot))
	C.Sound.play("Rare", { pitch = 0.8, position = pos })
end

function HANDLERS.Ribbon(e)
	local pos = towerTop(plotModel(e.plot))
	if pos then
		burst(pos, CONFETTI, 80)
		Effects.popText(pos + Vector3.new(0, 4, 0), "🎀 " .. tostring(e.height) .. " TALL!", Color3.fromRGB(255, 200, 230), 12, 3)
	end
	C.Sound.play("Rare", { pitch = 1.5, position = pos })
end

function HANDLERS.Alarm(e)
	local pos = towerTop(plotModel(e.plot))
	C.Sound.play("Rare", { pitch = 2, volume = 0.7, position = pos })
	if pos then
		Effects.popText(pos + Vector3.new(0, 3, 0), "Tweeeeet!", Color3.fromRGB(150, 240, 220), 8)
	end
end

function HANDLERS.Quest()
	C.Sound.play("Rare", { pitch = 1.6 })
end

function HANDLERS.Upgrade()
	C.Sound.play("Rare", { pitch = 1.2 })
end

function HANDLERS.Buy(e)
	local _, hrp = characterOf(e.userId)
	C.Sound.play("Coin", { pitch = 1.4, position = hrp and hrp.Position })
end

function HANDLERS.Scoop(e)
	local _, hrp = characterOf(e.userId)
	if hrp then
		Effects.popText(hrp.Position + Vector3.new(0, 5, 0), e.ok and "Scooped!" or "Boing!", nil, 6)
	end
	C.Sound.play(e.ok and "Stack" or "Wobble", { pitch = e.ok and 1.6 or 0.8, position = hrp and hrp.Position })
end

function HANDLERS.Hop(e)
	local _, hrp = characterOf(e.userId)
	C.Sound.play("Wobble", { pitch = 1.5, position = hrp and hrp.Position })
end

-- Coin pops over nearby towers ------------------------------------------------------------
local function coinPops()
	local plots = workspace:FindFirstChild("Plots")
	local camera = workspace.CurrentCamera
	if not plots or not camera then
		return
	end
	for _, plot in plots:GetChildren() do
		local rate = plot:GetAttribute("Rate") or 0
		local pos = towerTop(plot)
		if rate > 0 and pos and (pos - camera.CFrame.Position).Magnitude < 160 and not plot:GetAttribute("Toppling") then
			Effects.popText(pos + Vector3.new(0, 1.5, 0), "+" .. Format.number(rate * Config.Economy.CoinPopEvery), Color3.fromRGB(255, 220, 80), 4, 1.2)
		end
	end
end

-- Sprinkle Rain -----------------------------------------------------------------------------
local weatherPart: BasePart? = nil
local function updateWeather()
	local gs = ReplicatedStorage:FindFirstChild("GameState")
	local active = gs and gs:GetAttribute("WeatherActive") == true
	if active and not weatherPart then
		local part = Instance.new("Part")
		part.Name = "SprinkleRain"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(120, 1, 120)
		part.Parent = workspace.CurrentCamera
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = 220
		emitter.Lifetime = NumberRange.new(2.5, 3.5)
		emitter.Speed = NumberRange.new(20, 30)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Size = NumberSequence.new(0.35)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-150, 150)
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, CONFETTI[1]),
			ColorSequenceKeypoint.new(0.25, CONFETTI[2]),
			ColorSequenceKeypoint.new(0.5, CONFETTI[3]),
			ColorSequenceKeypoint.new(0.75, CONFETTI[4]),
			ColorSequenceKeypoint.new(1, CONFETTI[5]),
		})
		emitter.Parent = part
		weatherPart = part
	elseif not active and weatherPart then
		weatherPart:Destroy()
		weatherPart = nil
	end
end

function Effects.init(controllers)
	C = controllers
	State = C.State
	Remotes.get("Effect").OnClientEvent:Connect(function(e)
		local handler = type(e) == "table" and HANDLERS[e.kind]
		if handler then
			local ok, err = pcall(handler, e)
			if not ok then
				warn("[Effects]", e.kind, err)
			end
		end
	end)
end

function Effects.start()
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if weatherPart and camera then
			weatherPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
		end
		if camera and os.clock() < shakeUntil then
			local k = (shakeUntil - os.clock()) * 0.6
			camera.CFrame = camera.CFrame * CFrame.new(math.random(-10, 10) / 100 * k, math.random(-10, 10) / 100 * k, 0)
		end
	end)
	local t = 0
	while true do
		task.wait(0.5)
		t += 0.5
		pcall(updateWeather)
		if t % Config.Economy.CoinPopEvery < 0.5 then
			pcall(coinPops)
		end
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud: everything on screen during play (design doc 4.7).

	  Top center   Giggle Coins, coins per second, event timers
	  Top left     tower height, wobble, Fair Snatch Range, protections
	  Top right    the other towers in this server
	  Right        big Shield and Boop buttons
	  Bottom       Index, Shops, Tower, Box, Emotes, Codes, Settings (+ Dev in Studio)
	  Bottom mid   what you're holding, with DROP / Box it
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Creatures = require(Shared.Creatures)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Wobble = require(Shared.Wobble)

local Kit = require(script.Parent.Parent.UI.Kit)
local Root = require(script.Parent.Parent.UI.Root)

local Hud = {}

local C -- controllers
local State
local ui = {}

local function creatureTitle(entry): (string, Color3)
	local def = Creatures.ById[entry.id]
	if not def then
		return "???", Kit.Colors.Text
	end
	local rarity = Rarities.get(def.Rarity)
	local name = def.Name
	if entry.m then
		name = (Mutations.name(entry.m) or entry.m) .. " " .. name
	end
	return name .. "  " .. rarity.Badge .. " " .. rarity.Name, rarity.Color
end

-- Builders --------------------------------------------------------------------------

local function buildCoins(parent)
	local pill = Kit.panel({
		Name = "Coins",
		Size = UDim2.fromOffset(320, 58),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 244, 205),
		Parent = parent,
	})
	ui.coins = Kit.label({
		Text = "💰 0",
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 2),
		TextColor3 = Color3.fromRGB(150, 95, 20),
		Parent = pill,
	})
	ui.rate = Kit.label({
		Text = "+0/s",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 36),
		TextColor3 = Color3.fromRGB(120, 160, 60),
		Parent = pill,
	})
	ui.timers = Kit.label({
		Name = "Timers",
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(640, 22),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Kit.Colors.TextLight,
		Parent = parent,
	})
	Kit.textStroke(nil, 2).Parent = ui.timers
	ui.carry = Kit.label({
		Name = "Carry",
		Text = "",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(700, 30),
		Position = UDim2.new(0.5, 0, 0, 94),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Kit.Colors.Yellow,
		Visible = false,
		Parent = parent,
	})
	Kit.textStroke(nil, 2.5).Parent = ui.carry
end

local function buildTowerCard(parent)
	local card = Kit.panel({
		Name = "TowerCard",
		Size = UDim2.fromOffset(270, 126),
		Position = UDim2.fromOffset(12, 10),
		Parent = parent,
	})
	Kit.padding(10).Parent = card
	Kit.list(nil, 4).Parent = card
	ui.height = Kit.label({ Text = "🗼 Tower 0 / 10", TextSize = 22, LayoutOrder = 1, Parent = card })
	local barHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 2, Parent = card })
	Kit.label({ Text = "Wobble", TextSize = 16, Size = UDim2.fromOffset(62, 18), Parent = barHolder })
	local _, setWobble = Kit.bar({ Size = UDim2.new(1, -66, 0, 14), Position = UDim2.fromOffset(64, 2), Parent = barHolder })
	ui.setWobble = setWobble
	ui.range = Kit.label({ Text = "Snatch range: 0-6 tall", TextSize = 16, LayoutOrder = 3, TextColor3 = Kit.Colors.Muted, Parent = card })
	ui.saveNote = Kit.label({
		Text = "⚠️ Not saving (Studio test)",
		TextSize = 14,
		LayoutOrder = 4,
		TextColor3 = Kit.Colors.Orange,
		Visible = false,
		Parent = card,
	})

	ui.chips = Kit.new("Frame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(270, 140),
		Position = UDim2.fromOffset(12, 142),
		Parent = parent,
	})
	Kit.list(nil, 4).Parent = ui.chips
end

local function chip(text: string, color: Color3, order: number)
	local label = Kit.label({
		Text = text,
		TextSize = 16,
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		TextColor3 = Kit.Colors.Text,
		LayoutOrder = order,
		TextWrapped = false,
		Parent = ui.chips,
	})
	Kit.corner(10).Parent = label
	Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = label })
	return label
end

local function buildServerList(parent)
	local panel = Kit.panel({
		Name = "ServerTowers",
		Size = UDim2.fromOffset(230, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1, -12, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 0.1,
		Parent = parent,
	})
	Kit.padding(8).Parent = panel
	Kit.list(nil, 2).Parent = panel
	Kit.label({ Text = "Server Towers", TextSize = 18, LayoutOrder = 0, TextXAlignment = Enum.TextXAlignment.Center, Parent = panel })
	ui.serverList = panel
	ui.serverRows = {}
end

local function roundButton(parent, props)
	local btn = Kit.button({
		Name = props.Name,
		Text = props.Text,
		TextSize = props.TextSize or 22,
		Size = UDim2.fromOffset(props.Size, props.Size),
		Position = props.Position,
		AnchorPoint = Vector2.new(1, 0.5),
		Color = props.Color,
		Radius = props.Size,
		Parent = parent,
		OnClick = props.OnClick,
	})
	local sub = Kit.label({
		Name = "Sub",
		Text = props.Sub or "",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 20, 0, 18),
		Position = UDim2.new(0.5, 0, 1, 2),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Kit.Colors.TextLight,
		Parent = btn,
	})
	Kit.textStroke(nil, 2).Parent = sub
	return btn, sub
end

local function buildActions(parent)
	ui.shield, ui.shieldSub = roundButton(parent, {
		Name = "Shield",
		Text = "🛡️\nShield",
		Size = 96,
		Position = UDim2.new(1, -14, 0.5, -70),
		Color = Kit.Colors.Blue,
		Sub = "Ready! [G]",
		OnClick = function()
			Remotes.get("ActivateShield"):FireServer()
		end,
	})
	ui.boop, ui.boopSub = roundButton(parent, {
		Name = "Boop",
		Text = "✋\nBoop",
		Size = 84,
		Position = UDim2.new(1, -20, 0.5, 52),
		Color = Kit.Colors.Pink,
		Sub = "[F]",
		OnClick = function()
			Hud.boop()
		end,
	})
	local pulse = Kit.new("UIStroke", {
		Color = Kit.Colors.Yellow,
		Thickness = 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = ui.shield,
	})
	ui.shieldPulse = pulse
end

local BOTTOM = {
	{ Id = "Index", Icon = "📖", Label = "Index" },
	{ Id = "Shop", Icon = "🛒", Label = "Shops" },
	{ Id = "Tower", Icon = "🗼", Label = "Tower" },
	{ Id = "Box", Icon = "📦", Label = "Box" },
	{ Id = "Emotes", Icon = "😄", Label = "Emotes" },
	{ Id = "Codes", Icon = "🎁", Label = "Codes" },
	{ Id = "Settings", Icon = "⚙️", Label = "Settings" },
	{ Id = "Dev", Icon = "🛠️", Label = "Dev", StudioOnly = true },
}

local function buildBottomBar(parent)
	local bar = Kit.new("Frame", {
		Name = "BottomBar",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 70),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = parent,
	})
	local layout = Kit.list(Enum.FillDirection.Horizontal, 8)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = bar
	ui.bottomButtons = {}
	for i, item in BOTTOM do
		local btn = Kit.button({
			Name = item.Id,
			Text = item.Icon,
			TextSize = 30,
			Size = UDim2.fromOffset(64, 64),
			Color = i % 2 == 0 and Kit.Colors.Purple or Kit.Colors.Pink,
			LayoutOrder = i,
			Visible = not item.StudioOnly,
			Parent = bar,
			OnClick = function()
				C.Panels.toggle(item.Id)
			end,
		})
		local caption = Kit.label({
			Text = item.Label,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 14),
			Position = UDim2.new(0, 0, 1, -16),
			TextColor3 = Kit.Colors.TextLight,
			Parent = btn,
		})
		Kit.textStroke(nil, 1.5).Parent = caption
		ui.bottomButtons[item.Id] = btn
	end
end

local function buildHeldPanel(parent)
	local panel = Kit.panel({
		Name = "Held",
		Size = UDim2.fromOffset(520, 84),
		Position = UDim2.new(0.5, 0, 1, -86),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		Parent = parent,
	})
	ui.held = panel
	ui.heldTitle = Kit.label({
		Text = "",
		TextSize = 22,
		Size = UDim2.new(1, -250, 0, 28),
		Position = UDim2.fromOffset(14, 8),
		Parent = panel,
	})
	ui.heldHint = Kit.label({
		Text = "",
		TextSize = 16,
		Size = UDim2.new(1, -250, 0, 40),
		Position = UDim2.fromOffset(14, 36),
		TextColor3 = Kit.Colors.Muted,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = panel,
	})
	ui.drop = Kit.button({
		Name = "Drop",
		Text = "DROP! [Q]",
		TextSize = 24,
		Size = UDim2.fromOffset(130, 62),
		Position = UDim2.new(1, -110, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Kit.Colors.Green,
		Parent = panel,
		OnClick = function()
			C.Placement.drop()
		end,
	})
	ui.store = Kit.button({
		Name = "Store",
		Text = "📦 Box it",
		TextSize = 18,
		Size = UDim2.fromOffset(92, 62),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Kit.Colors.Purple,
		Parent = panel,
		OnClick = function()
			Remotes.get("StoreHeld"):FireServer()
		end,
	})

	-- the placement wobble preview ("jelly-bean bar")
	local preview = Kit.panel({
		Name = "Preview",
		Size = UDim2.fromOffset(360, 44),
		Position = UDim2.new(0.5, 0, 1, -180),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		Parent = parent,
	})
	ui.preview = preview
	ui.previewText = Kit.label({
		Text = "",
		TextSize = 17,
		Size = UDim2.new(0, 150, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Parent = preview,
	})
	local _, setPreview = Kit.bar({ Size = UDim2.new(1, -176, 0, 16), Position = UDim2.new(0, 166, 0.5, -8), Parent = preview })
	ui.setPreview = setPreview
end

-- Updates ----------------------------------------------------------------------------

function Hud.setPreview(visible: boolean, ratio: number?)
	ui.preview.Visible = visible
	if visible and ratio then
		local text = ratio > 1 and "TOPPLE RISK!" or ("Wobble after drop: " .. Format.percent(ratio))
		ui.previewText.Text = text
		ui.previewText.TextColor3 = ratio > 1 and Kit.Colors.Red or Kit.Colors.Text
		ui.setPreview(ratio, Kit.wobbleColor(ratio))
	end
end

function Hud.pulseShield(on: boolean)
	ui.shieldPulse.Thickness = on and 6 or 0
	ui.pulseShield = on
end

function Hud.boop()
	Remotes.get("Boop"):FireServer()
end

local function updateCoins(data)
	ui.coins.Text = "💰 " .. Format.number(data.coins)
	local napping = data.protection and data.protection.napping
	ui.rate.Text = "+" .. Format.number(data.rate) .. "/s" .. (napping and "  💤 napping (50%)" or "")
end

local function updateProtection(data)
	for _, child in ui.chips:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local p = data.protection
	if not p then
		return
	end
	local order = 0
	local function add(text, color)
		order += 1
		chip(text, color, order)
	end
	if p.shieldLeft > 0 then
		add("🛡️ Bubble Shield " .. Format.time(p.shieldLeft), Color3.fromRGB(190, 235, 255))
	end
	if p.arrival then
		local text = p.arrivalLeft > 0 and ("💠 Arrival Bubble " .. Format.time(p.arrivalLeft)) or "💠 Arrival Bubble (until you move)"
		add(text, Color3.fromRGB(255, 215, 240))
	end
	if p.newStacker then
		add("🌱 New Stacker " .. Format.time(p.newStackerLeft), Color3.fromRGB(205, 255, 200))
	end
	if p.napping then
		add("💤 Nap Mode (move to wake)", Color3.fromRGB(220, 210, 255))
	end
	if p.ruffledLeft > 0 then
		add("🐤 Ruffled Feathers " .. Format.time(p.ruffledLeft), Color3.fromRGB(255, 235, 190))
	end
	if p.devNoProtection then
		add("🛠️ Dev: protections off", Color3.fromRGB(255, 200, 200))
	end
	local ticket = data.ticket
	if ticket then
		local left = ticket.expires - State.now()
		if left > 0 then
			add("🎟️ Bounce-Back vs " .. ticket.name .. " " .. Format.time(left), Color3.fromRGB(255, 225, 160))
		end
	end

	-- shield button
	if p.shieldLeft > 0 then
		ui.shieldSub.Text = "Up " .. Format.time(p.shieldLeft)
		Kit.setButtonEnabled(ui.shield, false)
	elseif p.shieldReadyIn > 0 then
		ui.shieldSub.Text = "Recharge " .. Format.time(p.shieldReadyIn)
		Kit.setButtonEnabled(ui.shield, false)
	else
		ui.shieldSub.Text = "Ready! [G]"
		Kit.setButtonEnabled(ui.shield, true, Kit.Colors.Blue)
	end
end

local function updateTower(data)
	local slots = Economy.maxSlots(data)
	ui.height.Text = string.format("🗼 Tower %d / %d tall", #data.tower, slots)
	local ratio = Wobble.ratio(data.tower, Economy.glueReduce(data))
	ui.setWobble(ratio, Kit.wobbleColor(ratio))
	local lo, hi = Economy.fairRange(#data.tower)
	ui.range.Text = string.format("Snatch range: %d-%d tall", lo, hi)
	ui.saveNote.Visible = not data.canSave
	ui.bottomButtons.Dev.Visible = data.isStudio == true
end

local function updateHeld(data)
	local held = data.held
	local carrying = data.carrying
	if carrying then
		ui.held.Visible = false
		local left = Config.Snatch.CarryTimeout - (State.now() - carrying.started)
		local def = Creatures.ById[carrying.id]
		ui.carry.Visible = true
		ui.carry.Text = string.format("🏃 Run home with %s's %s! (%s)", carrying.fromName, def and def.Name or "creature", Format.time(left))
		return
	end
	ui.carry.Visible = false
	if not held then
		ui.held.Visible = false
		return
	end
	ui.held.Visible = true
	local title, color = creatureTitle(held)
	ui.heldTitle.Text = title
	ui.heldTitle.TextColor3 = color:Lerp(Kit.Colors.Text, 0.45)
	local onPad = State.onOwnPad()
	local full = #data.tower >= Economy.maxSlots(data)
	local toppling = State.myTowerToppling()
	if toppling then
		ui.heldHint.Text = "Your tower is bouncing back..."
	elseif full then
		ui.heldHint.Text = "Tower full! Upgrade your base or Box it."
	elseif onPad then
		ui.heldHint.Text = #data.tower == 0 and "Tap DROP to set it on your plate!" or "Tap DROP when the ghost is centered over the tower!"
	else
		ui.heldHint.Text = "Walk to your base pad to stack it."
	end
	Kit.setButtonEnabled(ui.drop, onPad and not full and not toppling, Kit.Colors.Green)
end

local function updateServerList()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return
	end
	local rows = {}
	for _, model in plots:GetChildren() do
		local name = model:GetAttribute("OwnerName")
		if name and name ~= "" then
			table.insert(rows, {
				name = name,
				height = model:GetAttribute("Height") or 0,
				status = model:GetAttribute("Status") or "",
				shield = (model:GetAttribute("ShieldUntil") or 0) > State.now(),
				mine = State.data and model:GetAttribute("PlotIndex") == State.data.plotIndex,
			})
		end
	end
	table.sort(rows, function(a, b)
		return a.height > b.height
	end)
	for i, row in rows do
		local label = ui.serverRows[i]
		if not label then
			label = Kit.label({ TextSize = 15, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = i, Parent = ui.serverList })
			ui.serverRows[i] = label
		end
		local icon = ""
		if row.shield then
			icon = " 🛡️"
		elseif string.find(row.status, "💤", 1, true) then
			icon = " 💤"
		elseif row.status ~= "" then
			icon = " 💠"
		end
		label.Text = string.format("%s%s - %d tall%s", row.mine and "⭐ " or "", row.name, row.height, icon)
		label.Visible = true
	end
	for i = #rows + 1, #ui.serverRows do
		ui.serverRows[i].Visible = false
	end
end

local function updateTimers()
	local gs = ReplicatedStorage:FindFirstChild("GameState")
	if not gs then
		return
	end
	local now = State.now()
	local parts = {}
	local nextLeg = gs:GetAttribute("NextLegendaryAt")
	if nextLeg then
		table.insert(parts, "★ Legendary in " .. Format.time(nextLeg - now))
	end
	local nextMyth = gs:GetAttribute("NextMythicAt")
	if nextMyth then
		table.insert(parts, "✦ Mythic in " .. Format.time(nextMyth - now))
	end
	if gs:GetAttribute("WeatherActive") then
		table.insert(parts, "🌈 Sprinkle Rain! " .. Format.time((gs:GetAttribute("WeatherEndsAt") or now) - now) .. " left")
	elseif gs:GetAttribute("NextWeatherAt") then
		table.insert(parts, "🌈 Sprinkle Rain in " .. Format.time(gs:GetAttribute("NextWeatherAt") - now))
	end
	ui.timers.Text = table.concat(parts, "   ·   ")
end

local function refresh(data)
	if not data then
		return
	end
	updateCoins(data)
	updateProtection(data)
	updateTower(data)
	updateHeld(data)
end

function Hud.init(controllers)
	C = controllers
	State = C.State
	local parent = Root.hud
	buildCoins(parent)
	buildTowerCard(parent)
	buildServerList(parent)
	buildActions(parent)
	buildBottomBar(parent)
	buildHeldPanel(parent)

	State.changed:Connect(refresh)
	State.ticked:Connect(function(data)
		updateCoins(data)
		updateProtection(data)
	end)

	ContextActionService:BindAction("StackShield", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Remotes.get("ActivateShield"):FireServer()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.G, Enum.KeyCode.ButtonL1)
	ContextActionService:BindAction("StackBoop", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Hud.boop()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
end

function Hud.start()
	local pulseT = 0
	while true do
		task.wait(0.25)
		pulseT += 0.25
		pcall(updateTimers)
		pcall(updateServerList)
		if State.data then
			pcall(updateHeld, State.data)
		end
		if ui.pulseShield then
			ui.shieldPulse.Thickness = (math.floor(pulseT * 2) % 2 == 0) and 6 or 2
		end
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Minigames</string>
              <string name="Source"><![CDATA[--[[
	Minigames: the two skill moments.

	Snatch (3-5 seconds, design doc 4.3): hold down and keep the jiggling dot
	inside the ring while you pull. The steady bar fills while you hold inside
	the ring; wiggle outside too long and the tower topples.
	  PC: hold the mouse button and drag   Mobile: hold and drag your thumb
	  Console: hold R2 / A and steer with the left stick

	Scoop (Muffin Meadows): stop the marker in the green zone.

	The client only reports what happened; the server sanity-checks and decides.
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Creatures = require(Shared.Creatures)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)
local Root = require(script.Parent.Parent.UI.Root)

local Minigames = {}

local C
local AREA = 300 -- pixels across the snatch play area
local snatchUi = {}
local scoopUi = {}
local snatchConn = nil
local scoopConn = nil

-- Snatch ----------------------------------------------------------------------------------

local function buildSnatch()
	local overlay = Kit.new("TextButton", {
		Name = "SnatchOverlay",
		Text = "",
		AutoButtonColor = false,
		Modal = true, -- frees the mouse in first person / shift-lock
		BackgroundColor3 = Color3.fromRGB(40, 20, 60),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = Root.overlay,
	})
	local panel = Kit.panel({
		Name = "Panel",
		Size = UDim2.fromOffset(AREA + 60, AREA + 150),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = overlay,
	})
	local title = Kit.label({
		Text = "Steady... steady...",
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 8),
		Parent = panel,
	})
	local area = Kit.new("Frame", {
		Name = "Area",
		Size = UDim2.fromOffset(AREA, AREA),
		Position = UDim2.new(0.5, 0, 0, 46),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(240, 230, 250),
		Parent = panel,
	})
	Kit.round().Parent = area
	local ring = Kit.new("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(200, 255, 210),
		BackgroundTransparency = 0.3,
		Parent = area,
	})
	Kit.round().Parent = ring
	local ringStroke = Kit.stroke(Kit.Colors.Green, 4)
	ringStroke.Parent = ring
	local dot = Kit.new("Frame", {
		Name = "Dot",
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Kit.Colors.Pink,
		ZIndex = 3,
		Parent = area,
	})
	Kit.round().Parent = dot
	Kit.stroke(Color3.fromRGB(120, 40, 80), 3).Parent = dot
	local steadyFrame, setSteady = Kit.bar({
		Size = UDim2.new(1, -40, 0, 18),
		Position = UDim2.new(0.5, 0, 1, -64),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Kit.Colors.Green,
		Parent = panel,
	})
	Kit.label({ Text = "Steady", TextSize = 14, Size = UDim2.fromOffset(60, 14), Position = UDim2.fromOffset(4, -15), Parent = steadyFrame })
	local _, setTime = Kit.bar({
		Size = UDim2.new(1, -40, 0, 10),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Kit.Colors.Blue,
		Parent = panel,
	})
	local hint = Kit.label({
		Text = "",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.new(0.5, 0, 1, -26),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Kit.Colors.Muted,
		Parent = panel,
	})
	snatchUi = {
		overlay = overlay,
		title = title,
		area = area,
		ring = ring,
		ringStroke = ringStroke,
		dot = dot,
		setSteady = setSteady,
		setTime = setTime,
		hint = hint,
	}
end

local function pointerPosition(): Vector2
	return UserInputService:GetMouseLocation()
end

function Minigames.startSnatch(sessionId: string, params)
	if snatchConn then
		snatchConn:Disconnect()
	end
	local ui = snatchUi
	ui.overlay.Visible = true
	local ringPx = params.ring * AREA
	ui.ring.Size = UDim2.fromOffset(ringPx * 2, ringPx * 2)
	local def = params.creatureId and Creatures.ById[params.creatureId]
	ui.title.Text = (params.practice and "Practice: " or "") .. "Steady... " .. (def and def.Name or "")
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	ui.hint.Text = touch and "Hold your thumb down and drag to keep the dot in the ring!"
		or (UserInputService.GamepadEnabled and not UserInputService.MouseEnabled) and "Hold R2 and steer with the stick!"
		or "Hold the mouse button and drag to keep the dot in the ring!"

	local seedX, seedY = math.random() * 100, math.random() * 100
	local driftAngle = math.random() * math.pi * 2
	local start = os.clock()
	local holding = false
	local anchor = Vector2.zero
	local correction = Vector2.zero
	local stickOffset = Vector2.zero
	local stickAccum = Vector2.zero
	local lastPointer = Vector2.zero
	local steady, outside = 0, 0
	local done = false

	local function finish(success: boolean)
		if done then
			return
		end
		done = true
		if snatchConn then
			snatchConn:Disconnect()
			snatchConn = nil
		end
		ui.title.Text = success and "FWIP!" or "Wheeee!"
		Remotes.get("SnatchResult"):FireServer(sessionId, success, { steady = steady, outside = outside })
		task.delay(0.6, function()
			ui.overlay.Visible = false
		end)
	end

	local holdInput: InputObject? = nil -- the press (mouse / finger / button) doing the pulling
	local function isHoldInput(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonR2
			or input.KeyCode == Enum.KeyCode.ButtonA
	end
	local inputs = {}
	table.insert(inputs, UserInputService.InputBegan:Connect(function(input)
		if holdInput == nil and isHoldInput(input) then
			holdInput = input
			holding = true
			local pos = input.UserInputType == Enum.UserInputType.Touch and Vector2.new(input.Position.X, input.Position.Y) or pointerPosition()
			anchor = pos - correction
			lastPointer = pos
		end
	end))
	table.insert(inputs, UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if holdInput and holdInput.UserInputType == Enum.UserInputType.MouseButton1 then
				lastPointer = pointerPosition()
			end
		elseif input.UserInputType == Enum.UserInputType.Touch then
			if input == holdInput then
				lastPointer = Vector2.new(input.Position.X, input.Position.Y)
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
			stickOffset = Vector2.new(input.Position.X, -input.Position.Y)
		end
	end))
	table.insert(inputs, UserInputService.InputEnded:Connect(function(input)
		if input == holdInput or (holdInput and input.UserInputType == holdInput.UserInputType and input.KeyCode == holdInput.KeyCode and input.UserInputType ~= Enum.UserInputType.Touch) then
			holdInput = nil
			holding = false
		end
	end))

	local function step(dt: number)
		local t = os.clock() - start
		-- The dot wanders: smooth noise plus a slow drift that keeps growing.
		driftAngle += dt * 0.7
		local wander = Vector2.new(math.noise(t * 0.9, seedX), math.noise(t * 0.9, seedY)) * ringPx * params.drift * 2.4
		local slide = Vector2.new(math.cos(driftAngle), math.sin(driftAngle)) * ringPx * params.drift * 0.45 * t
		if holding then
			if holdInput and holdInput.UserInputType == Enum.UserInputType.MouseButton1 then
				lastPointer = pointerPosition()
			end
			correction = (lastPointer - anchor)
		end
		stickAccum += stickOffset * dt * 260
		local scale = Root.scale.Scale > 0 and Root.scale.Scale or 1
		local offset = wander + slide + correction / scale + stickAccum
		local limit = AREA / 2 - 8
		if offset.Magnitude > limit then
			offset = offset.Unit * limit
		end
		ui.dot.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
		local inside = offset.Magnitude <= ringPx
		ui.ringStroke.Color = inside and Kit.Colors.Green or Kit.Colors.Red
		if holding then
			if inside then
				steady += dt
			else
				outside += dt
			end
		end
		ui.setSteady(steady / params.required)
		ui.setTime(1 - t / params.limit)
		if steady >= params.required then
			finish(true)
		elseif outside >= params.maxOutside or t >= params.limit then
			finish(false)
		end
	end
	snatchConn = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[Minigames] snatch error:", err)
			finish(false)
		end
		if done then
			for _, conn in inputs do
				conn:Disconnect()
			end
		end
	end)
end

-- Scoop -------------------------------------------------------------------------------

local function buildScoop()
	local panel = Kit.panel({
		Name = "Scoop",
		Size = UDim2.fromOffset(440, 190),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		Parent = Root.overlay,
	})
	local title = Kit.label({
		Text = "Gently...",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.fromOffset(0, 8),
		Parent = panel,
	})
	local bar = Kit.new("Frame", {
		Name = "Bar",
		Size = UDim2.new(1, -40, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 50),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 220, 220),
		Parent = panel,
	})
	Kit.corner(12).Parent = bar
	Kit.stroke(Kit.Colors.Stroke, 2).Parent = bar
	local zone = Kit.new("Frame", {
		Name = "Zone",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.3, 1),
		BackgroundColor3 = Kit.Colors.Green,
		Parent = bar,
	})
	Kit.corner(10).Parent = zone
	local marker = Kit.new("Frame", {
		Name = "Marker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 10, 1, 14),
		BackgroundColor3 = Color3.fromRGB(90, 50, 110),
		ZIndex = 3,
		Parent = bar,
	})
	Kit.corner(4).Parent = marker
	local button = Kit.button({
		Name = "Scoop",
		Text = "SCOOP! [E]",
		TextSize = 26,
		Size = UDim2.fromOffset(220, 58),
		Position = UDim2.new(0.5, 0, 1, -14),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = Kit.Colors.Green,
		Parent = panel,
	})
	scoopUi = { panel = panel, title = title, zone = zone, marker = marker, button = button }
end

function Minigames.startScoop(sessionId: string, params)
	if scoopConn then
		scoopConn:Disconnect()
	end
	local ui = scoopUi
	local def = Creatures.ById[params.creatureId]
	ui.title.Text = "Gently scoop the " .. (def and def.Name or "creature") .. "!"
	ui.zone.Size = UDim2.fromScale(params.zone, 1)
	ui.panel.Visible = true
	local start = os.clock()
	local done = false
	local marker = 0
	local clickConn, keyConn

	local function finish()
		if done then
			return
		end
		done = true
		if scoopConn then
			scoopConn:Disconnect()
			scoopConn = nil
		end
		if clickConn then
			clickConn:Disconnect()
		end
		if keyConn then
			keyConn:Disconnect()
		end
		local hit = math.abs(marker - 0.5) <= params.zone / 2
		ui.title.Text = hit and "Got it!" or "Boing!"
		Remotes.get("ScoopResult"):FireServer(sessionId, marker)
		task.delay(0.5, function()
			ui.panel.Visible = false
		end)
	end

	clickConn = ui.button.Activated:Connect(finish)
	keyConn = UserInputService.InputBegan:Connect(function(input)
		if UserInputService:GetFocusedTextBox() then
			return -- typing in chat or a text box
		end
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			finish()
		end
	end)
	scoopConn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) * params.speed
		marker = 1 - math.abs((t % 2) - 1) -- ping-pong 0..1
		ui.marker.Position = UDim2.fromScale(marker, 0.5)
		if os.clock() - start > 7 then
			finish()
		end
	end)
end

function Minigames.isBusy(): boolean
	return (snatchUi.overlay and snatchUi.overlay.Visible) or (scoopUi.panel and scoopUi.panel.Visible) or false
end

function Minigames.init(controllers)
	C = controllers
	buildSnatch()
	buildScoop()
	Remotes.get("SnatchStart").OnClientEvent:Connect(function(sessionId, params)
		C.Panels.close()
		Minigames.startSnatch(sessionId, params)
	end)
	Remotes.get("ScoopStart").OnClientEvent:Connect(function(sessionId, params)
		Minigames.startScoop(sessionId, params)
	end)
end

return Minigames
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications: friendly banners from the cast ("RARE ONE AHOY!").
	Gentle and rare; never purchase pop-ups.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)
local Root = require(script.Parent.Parent.UI.Root)

local Notifications = {}

local C
local holder
local MAX = 4

local NPC_COLORS = {
	["Professor Puddlewick"] = Color3.fromRGB(110, 170, 255),
	["Grandma Gloop"] = Color3.fromRGB(255, 120, 160),
	["Captain Conveyor"] = Color3.fromRGB(80, 120, 210),
	["Lou the Locksmith"] = Color3.fromRGB(110, 180, 90),
	["Bricklebee"] = Color3.fromRGB(230, 170, 30),
	["Sneaky Pete"] = Color3.fromRGB(120, 120, 200),
	["DJ Bonk"] = Color3.fromRGB(80, 180, 80),
	["Mayor Marshmallow"] = Color3.fromRGB(200, 120, 200),
}

local KIND_COLORS = {
	info = Color3.fromRGB(255, 249, 242),
	good = Color3.fromRGB(225, 255, 225),
	warn = Color3.fromRGB(255, 238, 210),
	rare = Color3.fromRGB(225, 235, 255),
	legendary = Color3.fromRGB(255, 240, 180),
}

function Notifications.show(payload)
	local kind = payload.kind or "info"
	local frame = Kit.panel({
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = KIND_COLORS[kind] or KIND_COLORS.info,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = holder,
	})
	Kit.padding(10).Parent = frame
	Kit.list(nil, 2).Parent = frame
	if payload.npc then
		Kit.label({
			Text = payload.npc,
			TextSize = 18,
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 20),
			TextColor3 = NPC_COLORS[payload.npc] or Kit.Colors.Text,
			Parent = frame,
		})
	end
	Kit.label({
		Text = payload.text or "",
		TextSize = kind == "legendary" and 22 or 19,
		LayoutOrder = 2,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = frame,
	})
	local scale = Kit.new("UIScale", { Scale = 0.6, Parent = frame })
	Kit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if kind == "legendary" or kind == "rare" then
		C.Sound.play("Rare", { pitch = kind == "legendary" and 1.3 or 1.1 })
	end

	local banners = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(banners, child)
		end
	end
	if #banners > MAX then
		table.sort(banners, function(a, b)
			return a.LayoutOrder < b.LayoutOrder -- newest first
		end)
		for i = MAX + 1, #banners do
			banners[i]:Destroy()
		end
	end
	task.delay(kind == "legendary" and 7 or 5, function()
		if frame.Parent then
			Kit.tween(scale, 0.2, { Scale = 0 })
			task.wait(0.2)
			frame:Destroy()
		end
	end)
end

function Notifications.init(controllers)
	C = controllers
	holder = Kit.new("Frame", {
		Name = "Banners",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(560, 400),
		Position = UDim2.new(0.5, 0, 0, 128),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = Root.toasts,
	})
	local layout = Kit.list(nil, 6, Enum.HorizontalAlignment.Center)
	layout.Parent = holder
	Remotes.get("Notify").OnClientEvent:Connect(Notifications.show)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--[[
	Panels: opens one menu window at a time (shops, Index, tower, box, ...).
	Menus only open when the player taps them - never pop-ups during play.
]]

local Root = require(script.Parent.Parent.UI.Root)

local Panels = {}

local C
local modules = {}
local frames = {}
local current = nil

local NAMES = { "Shop", "Index", "Tower", "Box", "Emotes", "Codes", "Settings", "Dev" }

function Panels.close()
	if current and frames[current] then
		frames[current].Visible = false
	end
	current = nil
end

function Panels.open(name: string, arg: any?)
	local module = modules[name]
	if not module then
		return
	end
	if current and current ~= name then
		Panels.close()
	end
	if not frames[name] then
		frames[name] = module.build(Root.panels, C, Panels.close)
	end
	current = name
	frames[name].Visible = true
	if module.onOpen then
		module.onOpen(arg)
	end
	if module.refresh and C.State.data then
		module.refresh(C.State.data)
	end
end

function Panels.toggle(name: string)
	if current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

function Panels.isOpen(name: string): boolean
	return current == name
end

function Panels.init(controllers)
	C = controllers
	local folder = script.Parent.Parent.Panels
	for _, name in NAMES do
		local moduleScript = folder:FindFirstChild(name)
		if moduleScript then
			modules[name] = require(moduleScript)
		end
	end
	local function refresh(data)
		local module = current and modules[current]
		if module and module.refresh then
			local ok, err = pcall(module.refresh, data)
			if not ok then
				warn("[Panels]", current, err)
			end
		end
	end
	C.State.changed:Connect(refresh)
	C.State.ticked:Connect(function(data)
		local module = current and modules[current]
		if module and module.tick then
			pcall(module.tick, data)
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Placement</string>
              <string name="Source"><![CDATA[--[[
	Placement: the ghost preview and the DROP button (design doc 4.2).

	While you hold a creature on your base pad, a see-through ghost sways in a
	figure-8 over your tower. The jelly-bean bar shows how wobbly the tower would
	be if you dropped it right now. Tap DROP when it's centered for a satisfying
	"boop"; drop it at the edge of the swing and the tower wobbles a lot more.

	The swing is a pure function of server time (Wobble.swingOffset), so the
	server recomputes exactly where you dropped it.
]]

local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CreatureModel = require(Shared.CreatureModel)
local Economy = require(Shared.Economy)
local Remotes = require(Shared.Remotes)
local TowerLayout = require(Shared.TowerLayout)
local Wobble = require(Shared.Wobble)

local Placement = {}

local C
local State
local ghost: Model? = nil
local ghostKey = nil
local target: BasePart? = nil
local active = false
local lastDrop = 0
local lastWarn = 0

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
		ghostKey = nil
	end
end

local function ensureTarget()
	if target and target.Parent then
		return target
	end
	local ring = Instance.new("Part")
	ring.Name = "AimRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.15, 2.2, 2.2)
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(120, 255, 150)
	ring.Transparency = 0.35
	ring.Parent = workspace.CurrentCamera
	target = ring
	return ring
end

local function canPlace(data): boolean
	return data ~= nil
		and data.held ~= nil
		and data.carrying == nil
		and not C.State.myTowerToppling()
		and not data.inSession
		and #data.tower < Economy.maxSlots(data)
		and State.onOwnPad()
end

function Placement.drop()
	local data = State.data
	if not canPlace(data) then
		return
	end
	local now = os.clock()
	if now - lastDrop < 0.5 then
		return
	end
	lastDrop = now
	Remotes.get("PlaceHeld"):FireServer(State.now())
	clearGhost()
end

local function setActive(on: boolean)
	if on == active then
		return
	end
	active = on
	if on then
		ContextActionService:BindAction("StackDrop", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				Placement.drop()
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonR1)
	else
		ContextActionService:UnbindAction("StackDrop")
		clearGhost()
		if target then
			target.Transparency = 1
		end
		C.Hud.setPreview(false)
	end
end

local function update()
	local data = State.data
	if not canPlace(data) then
		setActive(false)
		return
	end
	local origin = State.myOrigin()
	if not origin then
		setActive(false)
		return
	end
	setActive(true)

	local held = data.held
	local key = held.u .. ":" .. tostring(held.m)
	if ghostKey ~= key then
		clearGhost()
		ghost = CreatureModel.build(held.id, held.m, { ghost = true })
		if ghost then
			ghost.Parent = workspace.CurrentCamera
			ghostKey = key
		end
	end

	local n = #data.tower
	local t = State.now()
	local x, z = Wobble.swingOffset(t, n)
	local _, topCF = TowerLayout.layout(data.tower, origin)
	if ghost then
		local bob = 0.4 + 0.15 * math.sin(t * 6)
		ghost:PivotTo(topCF * CFrame.new(x, bob, z))
	end
	local ring = ensureTarget()
	ring.CFrame = topCF * CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Transparency = n == 0 and 1 or 0.35

	local candidate = { id = held.id, x = Wobble.roundOffset(x), z = Wobble.roundOffset(z) }
	local ratio = Wobble.total(Wobble.withTop(data.tower, candidate), Economy.glueReduce(data))
		/ Wobble.capacity(Wobble.withTop(data.tower, candidate))
	C.Hud.setPreview(n > 0, ratio)
end

function Placement.init(controllers)
	C = controllers
	State = C.State
end

function Placement.start()
	RunService.RenderStepped:Connect(function()
		local ok, err = pcall(update)
		if not ok then
			if os.clock() - lastWarn > 5 then
				lastWarn = os.clock()
				warn("[Placement]", err)
			end
			setActive(false)
		end
	end)
end

return Placement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--[[
	Prompts: ProximityPrompts for everything you can walk up to.

	  Conveyor creatures   Buy
	  Wild creatures       Scoop
	  Tower pegs           Snatch! (shows why not, e.g. "Shielded")
	  Ground creatures     Pick up (your own base only)
	  NPC stalls           Shop / Talk

	Prompts are created on the client so each player sees the right text;
	the server validates every request.
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Creatures = require(Shared.Creatures)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Remotes = require(Shared.Remotes)

local Prompts = {}

local C
local State
local pegPrompts = {} -- [pegs part] = prompt

local function prompt(parent: Instance, action: string, object: string, distance: number?, order: number?)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 10
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.UIOffset = Vector2.new(0, (order or 0) * 60)
	p.Parent = parent
	return p
end

local function creatureName(model: Instance): string
	local def = Creatures.ById[model:GetAttribute("CreatureId") or ""]
	local name = def and def.Name or "Creature"
	local m = model:GetAttribute("Mutation")
	if m and m ~= "" then
		name = (Mutations.name(m) or m) .. " " .. name
	end
	return name
end

-- Conveyor -------------------------------------------------------------------------------
local function onConveyorItem(model: Instance)
	local root = model:WaitForChild("Root", 5)
	if not root then
		return
	end
	local price = model:GetAttribute("Price") or 0
	local p = prompt(root, "Buy 💰" .. Format.number(price), creatureName(model), Config.Conveyor.BuyDistance - 2)
	p.Triggered:Connect(function()
		Remotes.get("BuyConveyor"):FireServer(model:GetAttribute("Uid"))
	end)
end

-- Muffin Meadows ----------------------------------------------------------------------------
local function onWild(model: Instance)
	local root = model:WaitForChild("Root", 5)
	if not root then
		return
	end
	local p = prompt(root, "Scoop", "Wild " .. creatureName(model), Config.Meadows.ScoopDistance - 2)
	p.Triggered:Connect(function()
		if C.Minigames.isBusy() then
			return
		end
		Remotes.get("RequestScoop"):FireServer(model:GetAttribute("Uid"))
	end)
end

-- Snatch pegs -----------------------------------------------------------------------------
local function onPegs(pegs: BasePart)
	local practice = pegs:GetAttribute("Practice") == true
	local index = pegs:GetAttribute("PlotIndex") or 0
	local p = prompt(pegs, practice and "Practice Snatch" or "Snatch!", practice and "Sneaky Pete's tower" or "", Config.Snatch.PromptDistance)
	p.HoldDuration = 0.25
	p.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	p.Triggered:Connect(function()
		if C.Minigames.isBusy() then
			return
		end
		Remotes.get("RequestSnatch"):FireServer(index)
	end)
	pegPrompts[pegs] = p
end

local function updatePegs()
	local data = State.data
	for pegs, p in pegPrompts do
		if not pegs.Parent then
			pegPrompts[pegs] = nil
			continue
		end
		if pegs:GetAttribute("Practice") then
			p.Enabled = true
			continue
		end
		local plot = pegs.Parent
		local index = pegs:GetAttribute("PlotIndex")
		local ownerName = plot:GetAttribute("OwnerName") or ""
		local height = plot:GetAttribute("Height") or 0
		local mine = data and data.plotIndex == index
		if ownerName == "" or mine or height == 0 then
			p.Enabled = false
			continue
		end
		p.Enabled = true
		p.ObjectText = ownerName .. "'s tower (" .. height .. " tall)"
		local status = plot:GetAttribute("Status") or ""
		local ticketHere = data and data.ticket and data.ticket.plot == index
		local myHeight = data and #data.tower or 0
		if (plot:GetAttribute("ShieldUntil") or 0) > State.now() then
			p.ActionText = ticketHere and "Revenge Snatch! 🎟️" or "🛡️ Shielded"
		elseif plot:GetAttribute("Toppling") then
			p.ActionText = "Bouncing back..."
		elseif status ~= "" then
			p.ActionText = status
		elseif not Economy.inFairRange(myHeight, height) and not (data and data.protection and data.protection.devNoProtection) then
			p.ActionText = "Out of range"
		else
			p.ActionText = ticketHere and "Revenge Snatch! 🎟️" or "Snatch!"
		end
	end
end

-- Ground creatures on my own pad ---------------------------------------------------------
local groundPrompts = {}
local function updateGround()
	local plot = State.plotModel()
	local folder = plot and plot:FindFirstChild("Ground")
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		if not groundPrompts[model] then
			local root = model:FindFirstChild("Root")
			if root then
				local p = prompt(root, "Pick up", creatureName(model), 10)
				p.Triggered:Connect(function()
					Remotes.get("PickUpGround"):FireServer(model:GetAttribute("Uid"))
				end)
				groundPrompts[model] = p
			end
		end
	end
	for model in groundPrompts do
		if not model.Parent then
			groundPrompts[model] = nil
		end
	end
end

-- NPC stalls ------------------------------------------------------------------------------
local TALK = {
	Pete = {
		"Gentle hands, quick feet! Only the very top creature can be snatched.",
		"If a tower topples, every creature hops home. Nobody loses anything!",
		"Shields, napping towers and new players can't be snatched. That's the rules!",
		"Got snatched? Boop the carrier with your Boop button before they get home!",
	},
	Mayor = {
		"By the power of fluff, I declare... ribbons at 10, 25, 50 and 100 tall!",
		"The tallest towers in the server are on my board. Is yours up there?",
	},
	Captain = {
		"RARE ONE AHOY! Legendary and Mythic creatures ride my belt on a timer - watch the clock up top!",
		"Walk up to a creature on the belt and press the button to buy it. Then carry it home!",
	},
}
local talkIndex = {}

local function onStall(part: BasePart)
	local action = part:GetAttribute("Action") or ""
	local p = prompt(part, part:GetAttribute("PromptText") or "Talk", part:GetAttribute("NpcName") or "", 8)
	p.Triggered:Connect(function()
		local kind, arg = string.match(action, "^(%a+):?(%a*)$")
		if kind == "Shop" then
			C.Panels.open("Shop", arg)
		elseif kind == "Index" then
			C.Panels.open("Index")
		elseif kind == "Emotes" then
			C.Panels.open("Emotes")
		elseif kind == "Talk" then
			local lines = TALK[arg]
			if lines then
				talkIndex[arg] = (talkIndex[arg] or 0) % #lines + 1
				C.Notifications.show({ text = lines[talkIndex[arg]], npc = part:GetAttribute("NpcName"), kind = "info" })
			end
		end
	end)
end

local function watchFolder(name: string, handler)
	task.spawn(function()
		local folder = workspace:WaitForChild(name, 60)
		if not folder then
			return
		end
		folder.ChildAdded:Connect(function(child)
			task.spawn(handler, child)
		end)
		for _, child in folder:GetChildren() do
			task.spawn(handler, child)
		end
	end)
end

local function watchTag(tag: string, handler)
	CollectionService:GetInstanceAddedSignal(tag):Connect(handler)
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(handler, inst)
	end
end

function Prompts.init(controllers)
	C = controllers
	State = C.State
	watchFolder("Conveyor", onConveyorItem)
	watchFolder("Wild", onWild)
	watchTag("SnatchPegs", onPegs)
	watchTag("NpcStall", onStall)
end

function Prompts.start()
	while true do
		task.wait(0.4)
		pcall(updatePegs)
		pcall(updateGround)
	end
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--[[
	Sound: plays the game's sound effects (ids live in Config.Sounds).
	Boops rise in pitch as towers get taller; nothing is ever loud or scary.
]]

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sound = {}

Sound.enabled = true

local VOLUMES = {
	Stack = 0.5,
	Coin = 0.25,
	Wobble = 0.4,
	Snatch = 0.6,
	Topple = 0.6,
	Restack = 0.4,
	Boop = 0.6,
	Click = 0.25,
	Rare = 0.5,
	Sneeze = 0.35,
	Splash = 0.4,
}

-- opts: { pitch, volume, position (Vector3) }
function Sound.play(name: string, opts: any?)
	if not Sound.enabled then
		return
	end
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	opts = opts or {}
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = (opts.volume or VOLUMES[name] or 0.5)
	sound.PlaybackSpeed = opts.pitch or 1
	if opts.position then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(0.2, 0.2, 0.2)
		holder.Position = opts.position
		holder.Parent = workspace
		sound.RollOffMaxDistance = 260
		sound.Parent = holder
		sound:Play()
		Debris:AddItem(holder, 6)
	else
		sound.Parent = SoundService
		sound:Play()
		Debris:AddItem(sound, 6)
	end
end

function Sound.init()
	local music = Config.Sounds.Music
	if music and music ~= "" then
		local track = Instance.new("Sound")
		track.Name = "Music"
		track.SoundId = music
		track.Looped = true
		track.Volume = 0.25
		track.Parent = SoundService
		track:Play()
		Sound.music = track
	end
end

function Sound.setEnabled(on: boolean)
	Sound.enabled = on
	if Sound.music then
		Sound.music.Volume = on and 0.25 or 0
	end
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--[[
	State: the latest snapshot of *my* game state from the server, plus helpers
	for finding my base pad. Other controllers listen to State.changed.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local State = {}

State.data = nil -- last full snapshot (see server Sync.buildState)
State.changed = Signal.new() -- (data)
State.ticked = Signal.new() -- (data)
State.player = Players.LocalPlayer

function State.now(): number
	return workspace:GetServerTimeNow()
end

function State.plotModel(index: number?)
	index = index or (State.data and State.data.plotIndex)
	if not index or index == 0 then
		return nil
	end
	local plots = workspace:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. index)
end

-- Bottom-center of a tower (top of the stacking plate), facing the plaza.
function State.originOf(model: Instance?): CFrame?
	if not model then
		return nil
	end
	local plate = model:FindFirstChild("Plate")
	if not plate then
		return nil
	end
	local yaw = model:GetAttribute("BaseYaw") or 0
	return CFrame.new(plate.Position.X, Config.Map.PlateTopY, plate.Position.Z) * CFrame.Angles(0, yaw, 0)
end

function State.myOrigin(): CFrame?
	return State.originOf(State.plotModel())
end

-- Read from the plot (always reset when the topple ends) rather than the snapshot.
function State.myTowerToppling(): boolean
	local model = State.plotModel()
	return model ~= nil and model:GetAttribute("Toppling") == true
end

function State.rootPart(): BasePart?
	local character = State.player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function State.onOwnPad(): boolean
	local model = State.plotModel()
	local hrp = State.rootPart()
	if not model or not hrp or not model.PrimaryPart then
		return false
	end
	local center = model.PrimaryPart.Position
	local dx, dz = hrp.Position.X - center.X, hrp.Position.Z - center.Z
	return math.sqrt(dx * dx + dz * dz) <= Config.Map.PadRadius + 2 and hrp.Position.Y < Config.Map.PadTopY + 14
end

function State.init()
	Remotes.get("State").OnClientEvent:Connect(function(data)
		State.data = data
		State.changed:Fire(data)
	end)
	Remotes.get("Tick").OnClientEvent:Connect(function(tick)
		local data = State.data
		if not data then
			return
		end
		data.coins = tick.coins
		data.rate = tick.rate
		data.protection = tick.protection
		State.ticked:Fire(data)
	end)
end

return State
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Stack & Snatch - client entry point.

	Starts every controller. Controllers receive the shared table `C` in init()
	and look each other up at call time, so load order doesn't matter much.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Root = require(script.Parent.UI.Root)
local Kit = require(script.Parent.UI.Kit)

local ORDER = {
	"State",
	"Sound",
	"Panels",
	"Hud",
	"Notifications",
	"Dialog",
	"Placement",
	"Minigames",
	"Prompts",
	"Animator",
	"Effects",
}

local C = {}
for _, name in ORDER do
	C[name] = require(script.Parent.Controllers[name])
end

Root.init()

for _, name in ORDER do
	local controller = C[name]
	if controller.init then
		local ok, err = pcall(controller.init, C)
		if not ok then
			warn("[Client] init failed:", name, err)
		end
	end
end

-- Settings live in a panel module but must apply as soon as data arrives.
local Settings = require(script.Parent.Panels.Settings)
Settings.init(C)

Kit.clickSound = function()
	C.Sound.play("Click", { pitch = 1.6, volume = 0.2 })
end

for _, name in ORDER do
	local controller = C[name]
	if controller.start then
		task.spawn(function()
			local ok, err = pcall(controller.start)
			if not ok then
				warn("[Client] start failed:", name, err)
			end
		end)
	end
end

Remotes.get("ClientReady"):FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Box</string>
              <string name="Source"><![CDATA[--[[
	Box: creatures you're storing. Take one into your hands to stack it, or put
	a favorite on the Comfy Cushion.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Creatures = require(Shared.Creatures)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Box = {}

local ui = {}

function Box.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Box", Title = "My Box", Size = UDim2.fromOffset(560, 480), Parent = parent, OnClose = close })
	ui.header = Kit.label({ Text = "", TextSize = 18, Size = UDim2.new(1, -230, 0, 40), Parent = content })
	ui.store = Kit.button({
		Text = "📦 Put held in Box",
		TextSize = 16,
		Size = UDim2.fromOffset(220, 40),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Color = Kit.Colors.Purple,
		Parent = content,
		OnClick = function()
			Remotes.get("StoreHeld"):FireServer()
		end,
	})
	ui.list = Kit.scroll({ Size = UDim2.new(1, 0, 1, -50), Position = UDim2.fromOffset(0, 48), Parent = content })
	Kit.list(nil, 6).Parent = ui.list
	return frame
end

function Box.refresh(data)
	ui.header.Text = string.format("%d / %d creatures stored", #data.box, Economy.boxCapacity(data))
	ui.store.Visible = data.held ~= nil
	for _, child in ui.list:GetChildren() do
		if child:IsA("Frame") or child.Name == "Empty" then
			child:Destroy()
		end
	end
	local ground = {}
	for _, uid in data.ground or {} do
		ground[uid] = true
	end
	for i, entry in data.box do
		local def = Creatures.ById[entry.id]
		local rarity = Rarities.get(def and def.Rarity or "Common")
		local name = def and def.Name or "???"
		if entry.m then
			name = (Mutations.name(entry.m) or entry.m) .. " " .. name
		end
		local row = Kit.panel({ Size = UDim2.new(1, -12, 0, 50), LayoutOrder = i, Parent = ui.list })
		Kit.label({
			Text = rarity.Badge .. " " .. name .. (ground[entry.u] and "  (on the ground by your tower)" or ""),
			TextSize = 17,
			Size = UDim2.new(1, -230, 0, 24),
			Position = UDim2.fromOffset(10, 3),
			TextColor3 = rarity.Color:Lerp(Kit.Colors.Text, 0.5),
			Parent = row,
		})
		Kit.label({
			Text = string.format("%s · %s · %s/s", rarity.Name, def and Creatures.Shapes[def.Shape].Name or "", Format.number((def and def.Rate or 0) * Mutations.multiplier(entry.m))),
			TextSize = 14,
			Size = UDim2.new(1, -230, 0, 18),
			Position = UDim2.fromOffset(10, 27),
			TextColor3 = Kit.Colors.Muted,
			Parent = row,
		})
		Kit.button({
			Text = "✋ Hold",
			TextSize = 16,
			Size = UDim2.fromOffset(96, 40),
			Position = UDim2.new(1, -112, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = Kit.Colors.Blue,
			Parent = row,
			OnClick = function()
				Remotes.get("TakeFromBox"):FireServer(entry.u)
			end,
		})
		Kit.button({
			Text = "🛋 Cushion",
			TextSize = 15,
			Size = UDim2.fromOffset(100, 40),
			Position = UDim2.new(1, -6, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = Kit.Colors.Pink,
			Parent = row,
			OnClick = function()
				Remotes.get("TowerAction"):FireServer("cushionFromBox", entry.u)
			end,
		})
	end
	if #data.box == 0 then
		Kit.label({ Text = "Your Box is empty.", TextSize = 17, Size = UDim2.new(1, -12, 0, 40), Parent = ui.list }).Name = "Empty"
	end
end

return Box
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Codes</string>
              <string name="Source"><![CDATA[--[[
	Codes: small coin rewards (never creatures), so YouTubers have something to share.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Codes = {}

function Codes.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Codes", Title = "Codes", Size = UDim2.fromOffset(460, 260), Parent = parent, OnClose = close })
	local box = Kit.new("TextBox", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Font = Kit.Font,
		PlaceholderText = "Type a code...",
		Text = "",
		TextSize = 24,
		TextColor3 = Kit.Colors.Text,
		ClearTextOnFocus = false,
		Parent = content,
	})
	Kit.corner(12).Parent = box
	Kit.stroke(Kit.Colors.Stroke, 2).Parent = box
	local result = Kit.label({
		Text = "",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 124),
		Parent = content,
	})
	Kit.button({
		Text = "Redeem",
		TextSize = 22,
		Size = UDim2.fromOffset(200, 50),
		Position = UDim2.new(0.5, 0, 0, 64),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Kit.Colors.Green,
		Parent = content,
		OnClick = function()
			result.Text = "..."
			local ok, message = pcall(function()
				return Remotes.get("RedeemCode"):InvokeServer(box.Text)
			end)
			result.Text = ok and tostring(message) or "Oops, try again!"
		end,
	})
	return frame
end

return Codes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Dev</string>
              <string name="Source"><![CDATA[--[[
	Dev: Studio-only test tools. The server ignores these outside Studio.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Dev = {}

local BUTTONS = {
	{ "+1K coins", "coins", 1000 },
	{ "+100K coins", "coins", 100000 },
	{ "+10M coins", "coins", 10000000 },
	{ "Random creature", "give", "random" },
	{ "Give Legendary", "give", "BubbleBunny" },
	{ "Give Mythic", "give", "KazooKoala" },
	{ "Give Lord Jellington", "give", "LordJellington" },
	{ "Golden Toast Cubert", "give", { "Cubert", "GoldenToast" } },
	{ "Fill my tower", "fill" },
	{ "Topple my tower", "toppleMe" },
	{ "Bot tower (6)", "bot", 6 },
	{ "Bot tower (15)", "bot", 15 },
	{ "Clear bots", "clearBots" },
	{ "My protections ON/OFF", "noProtect" },
	{ "Sprinkle Rain now", "weather" },
	{ "Legendary on belt", "conveyor", "Legendary" },
	{ "Mythic on belt", "conveyor", "Mythic" },
	{ "Wild Epic in meadow", "wild", "PillowPossum" },
	{ "Reset shield timer", "shieldReset" },
	{ "Bounce-Back Ticket", "ticket" },
	{ "Skip tutorial", "skipTutorial" },
	{ "Reset my data", "resetData" },
}

function Dev.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Dev", Title = "Dev Tools (Studio only)", Size = UDim2.fromOffset(700, 520), Parent = parent, OnClose = close })
	local scroll = Kit.scroll({ Parent = content })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(210, 46),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	for i, b in BUTTONS do
		Kit.button({
			Text = b[1],
			TextSize = 17,
			LayoutOrder = i,
			Color = (b[2] == "resetData") and Kit.Colors.Red or (i % 2 == 0 and Kit.Colors.Blue or Kit.Colors.Purple),
			Parent = scroll,
			OnClick = function()
				Remotes.get("Dev"):FireServer(b[2], b[3])
			end,
		})
	end
	return frame
end

return Dev
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Emotes</string>
              <string name="Source"><![CDATA[--[[
	Emotes: quick friendly reactions, so the game is fully playable without chat.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Emotes = {}

function Emotes.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Emotes", Title = "DJ Bonk's Emotes", Size = UDim2.fromOffset(460, 280), Parent = parent, OnClose = close })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 54),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})
	local colors = { Kit.Colors.Pink, Kit.Colors.Blue, Kit.Colors.Green, Kit.Colors.Purple, Kit.Colors.Orange, Kit.Colors.Yellow }
	for i, text in Config.Emotes do
		Kit.button({
			Text = text,
			TextSize = 22,
			LayoutOrder = i,
			Color = colors[(i - 1) % #colors + 1],
			Parent = content,
			OnClick = function()
				Remotes.get("Emote"):FireServer(i)
				close()
			end,
		})
	end
	return frame
end

return Emotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--[[
	Index: Professor Puddlewick's creature book. Every creature and mutation you
	have ever owned. Undiscovered creatures show as silhouettes.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureModel = require(Shared.CreatureModel)
local Creatures = require(Shared.Creatures)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)

local Kit = require(script.Parent.Parent.UI.Kit)

local Index = {}

local ui = { cards = {} }
local selectedId = nil
local lastData = nil

local function viewport(parent, def)
	local vp = Kit.new("ViewportFrame", {
		Size = UDim2.new(1, -8, 0, 96),
		Position = UDim2.fromOffset(4, 4),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 190, 210),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.5, -1, 0.6),
		Parent = parent,
	})
	local model = CreatureModel.build(def.Id, nil)
	if model then
		model:PivotTo(CFrame.new())
		model.Parent = vp
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	local size = math.max(def.Width, def.Height)
	camera.CFrame = CFrame.lookAt(Vector3.new(size * 0.7, def.Height * 0.6 + size * 0.5, -size * 2.3), Vector3.new(0, def.Height * 0.45, 0))
	camera.Parent = vp
	vp.CurrentCamera = camera
	return vp
end

local function showDetails(def)
	selectedId = def.Id
	local data = lastData
	local page = data and data.index[def.Id]
	if not page then
		ui.details.Text = "??? - not discovered yet. Find one on the conveyor or in Muffin Meadows!"
		return
	end
	local rarity = Rarities.get(def.Rarity)
	local muts = {}
	for _, m in Mutations.Order do
		table.insert(muts, (page[m] and "✅ " or "⬜ ") .. Mutations.ById[m].Name .. " x" .. Mutations.ById[m].Multiplier)
	end
	ui.details.Text = string.format(
		"%s  ·  %s %s  ·  %s  ·  %s/s\n%s\nStacking: %s\nMutations: %s",
		def.Name,
		rarity.Badge,
		rarity.Name,
		Creatures.Shapes[def.Shape].Name,
		Format.number(def.Rate),
		def.Trait,
		def.Effect,
		table.concat(muts, "   ")
	)
end

function Index.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Index", Title = "Index - Creature Book", Size = UDim2.fromOffset(820, 560), Parent = parent, OnClose = close })
	ui.header = Kit.label({ Text = "", TextSize = 19, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, Parent = content })
	local scroll = Kit.scroll({ Size = UDim2.new(1, 0, 1, -128), Position = UDim2.fromOffset(0, 28), Parent = content })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(124, 158),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	for i, def in Creatures.List do
		local card = Kit.new("TextButton", {
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = Kit.Colors.PanelDark,
			LayoutOrder = i,
			Parent = scroll,
		})
		Kit.corner(12).Parent = card
		local stroke = Kit.stroke(Rarities.get(def.Rarity).Color, 3)
		stroke.Parent = card
		local vp = viewport(card, def)
		local name = Kit.label({
			Text = def.Name,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, -6, 0, 32),
			Position = UDim2.fromOffset(3, 100),
			Parent = card,
		})
		local rarity = Rarities.get(def.Rarity)
		Kit.label({
			Text = rarity.Badge .. " " .. rarity.Name,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, -6, 0, 16),
			Position = UDim2.fromOffset(3, 132),
			TextColor3 = rarity.Color:Lerp(Kit.Colors.Text, 0.35),
			Parent = card,
		})
		local dots = Kit.label({
			Text = "",
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.new(1, -8, 0, 14),
			Position = UDim2.fromOffset(4, 4),
			Parent = card,
		})
		card.Activated:Connect(function()
			showDetails(def)
		end)
		ui.cards[def.Id] = { card = card, vp = vp, name = name, dots = dots }
	end
	ui.details = Kit.label({
		Text = "Tap a creature to read about it.",
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 92),
		Position = UDim2.new(0, 0, 1, -94),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = content,
	})
	return frame
end

function Index.refresh(data)
	lastData = data
	local found = Economy.indexCount(data.index)
	ui.header.Text = string.format(
		"%d / %d discovered  ·  +%d%% coins forever",
		found,
		#Creatures.List,
		math.floor(found * Config.Economy.IndexBonusPerCreature * 100 + 0.5)
	)
	for _, def in Creatures.List do
		local card = ui.cards[def.Id]
		local page = data.index[def.Id]
		if page then
			card.vp.ImageColor3 = Color3.new(1, 1, 1)
			card.name.Text = def.Name
			local marks = ""
			for _, m in Mutations.Order do
				if page[m] then
					marks ..= (m == "GoldenToast" and "⭐" or m == "Glittery" and "✨" or "🌈")
				end
			end
			card.dots.Text = marks
		else
			card.vp.ImageColor3 = Color3.new(0, 0, 0)
			card.name.Text = "???"
			card.dots.Text = ""
		end
	end
	if selectedId then
		showDetails(Creatures.ById[selectedId])
	end
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings: Calm mode (less shaking and jiggling), sound, and UI size.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)
local Root = require(script.Parent.Parent.UI.Root)

local Settings = {}

local C
local ui = {}
local current = { calm = false, sfx = true, uiScale = 1 }
local applied = false

function Settings.apply(settings)
	current.calm = settings.calm == true
	current.sfx = settings.sfx ~= false
	current.uiScale = settings.uiScale or 1
	C.Animator.calm = current.calm
	C.Effects.calm = current.calm
	C.Sound.setEnabled(current.sfx)
	Root.setUserScale(current.uiScale)
end

local function save()
	Settings.apply(current)
	Remotes.get("SaveSettings"):FireServer(current)
	Settings.refresh()
end

function Settings.build(parent, controllers, close)
	C = controllers
	local frame, content = Kit.window({ Name = "Settings", Title = "Settings", Size = UDim2.fromOffset(460, 330), Parent = parent, OnClose = close })
	Kit.list(nil, 10, Enum.HorizontalAlignment.Center).Parent = content
	ui.calm = Kit.button({
		Text = "",
		TextSize = 20,
		Size = UDim2.fromOffset(380, 52),
		LayoutOrder = 1,
		Color = Kit.Colors.Blue,
		Parent = content,
		OnClick = function()
			current.calm = not current.calm
			save()
		end,
	})
	ui.sfx = Kit.button({
		Text = "",
		TextSize = 20,
		Size = UDim2.fromOffset(380, 52),
		LayoutOrder = 2,
		Color = Kit.Colors.Purple,
		Parent = content,
		OnClick = function()
			current.sfx = not current.sfx
			save()
		end,
	})
	Kit.label({ Text = "Text & button size", TextSize = 18, LayoutOrder = 3, TextXAlignment = Enum.TextXAlignment.Center, Parent = content })
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(380, 50), LayoutOrder = 4, Parent = content })
	Kit.list(Enum.FillDirection.Horizontal, 8).Parent = row
	ui.sizes = {}
	for i, option in { { "Small", 0.85 }, { "Normal", 1 }, { "Large", 1.15 } } do
		ui.sizes[option[2]] = Kit.button({
			Text = option[1],
			TextSize = 18,
			Size = UDim2.fromOffset(120, 46),
			LayoutOrder = i,
			Color = Kit.Colors.Pink,
			Parent = row,
			OnClick = function()
				current.uiScale = option[2]
				save()
			end,
		})
	end
	Settings.refresh()
	return frame
end

function Settings.refresh()
	if not ui.calm then
		return
	end
	ui.calm.Text = "Calm mode: " .. (current.calm and "ON (less shaking)" or "OFF")
	ui.sfx.Text = "Sound effects: " .. (current.sfx and "ON" or "OFF")
	for scale, btn in ui.sizes do
		btn.BackgroundColor3 = math.abs(scale - current.uiScale) < 0.01 and Kit.Colors.Green or Kit.Colors.Pink
	end
end

-- Apply saved settings from the first state snapshot.
function Settings.init(controllers)
	C = controllers
	C.State.changed:Connect(function(data)
		if not applied and data.settings then
			applied = true
			Settings.apply(data.settings)
		end
	end)
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop: Grandma Gloop (Sticky Jam), Bricklebee (Base), Lou the Locksmith
	(Bubble Shield + Comfy Cushion). Giggle Coins only.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Parent.UI.Kit)

local Shop = {}

local ui = {}
local selected = "Glue"

local QUOTES = {
	Glue = "\"A little jam fixes everything, sweetie!\" Sticky Jam makes every layer wobble less, and makes the snatch ring smaller for raiders.",
	Base = "\"Bzzt! Let's build it bigger!\" A bigger base pad holds a taller tower and a bigger Box.",
	Shield = "\"Slow and steady... keeps the tower steady.\" Bubble Shields block snatching completely while they're up.",
}

local function describe(track: string, level)
	if not level then
		return "-"
	end
	if track == "Glue" then
		return string.format("Wobble -%d%% · snatch ring tighter (Lv %d)", math.floor(level.Reduce * 100 + 0.5), level.Ring)
	elseif track == "Base" then
		return string.format("%d tower slots · %d Box spaces", level.Slots, level.Box)
	elseif track == "Shield" then
		return string.format("Shield lasts %ds · recharges in %ds", level.Duration, level.Recharge)
	end
	return ""
end

local C

function Shop.build(parent, controllers, close)
	C = controllers
	local frame, content = Kit.window({ Name = "Shop", Title = "Shops", Size = UDim2.fromOffset(600, 430), Parent = parent, OnClose = close })
	local tabs = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), Parent = content })
	Kit.list(Enum.FillDirection.Horizontal, 8).Parent = tabs
	ui.tabs = {}
	for i, track in Config.UpgradeOrder do
		local info = Config.Upgrades[track]
		ui.tabs[track] = Kit.button({
			Text = info.Npc,
			TextSize = 17,
			Size = UDim2.fromOffset(182, 44),
			LayoutOrder = i,
			Color = Kit.Colors.Purple,
			Parent = tabs,
			OnClick = function()
				selected = track
				if C.State.data then
					Shop.refresh(C.State.data)
				end
			end,
		})
	end
	local body = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -56), Position = UDim2.fromOffset(0, 56), Parent = content })
	Kit.list(nil, 8).Parent = body
	ui.title = Kit.label({ Text = "", TextSize = 26, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Parent = body })
	ui.quote = Kit.label({ Text = "", TextSize = 17, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 60), TextColor3 = Kit.Colors.Muted, Parent = body })
	ui.level = Kit.label({ Text = "", TextSize = 20, LayoutOrder = 3, Parent = body })
	ui.now = Kit.label({ Text = "", TextSize = 18, LayoutOrder = 4, Parent = body })
	ui.next = Kit.label({ Text = "", TextSize = 18, LayoutOrder = 5, TextColor3 = Color3.fromRGB(70, 140, 70), Parent = body })
	ui.buy = Kit.button({
		Text = "Upgrade",
		TextSize = 22,
		Size = UDim2.fromOffset(260, 52),
		LayoutOrder = 6,
		Color = Kit.Colors.Green,
		Parent = body,
		OnClick = function()
			Remotes.get("BuyUpgrade"):FireServer(selected)
		end,
	})
	ui.extra = Kit.label({ Text = "", TextSize = 16, LayoutOrder = 7, Size = UDim2.new(1, 0, 0, 44), TextColor3 = Kit.Colors.Muted, Parent = body })
	return frame
end

function Shop.onOpen(track: any)
	if type(track) == "string" and Config.Upgrades[track] then
		selected = track
	end
end

function Shop.refresh(data)
	local info = Config.Upgrades[selected]
	for track, btn in ui.tabs do
		btn.BackgroundColor3 = track == selected and Kit.Colors.Pink or Kit.Colors.Purple
	end
	local current, level, maxLevel = Economy.upgradeLevel(data, selected)
	local nextLevel = Economy.nextUpgrade(data, selected)
	ui.title.Text = info.Npc .. " - " .. info.Title
	ui.quote.Text = QUOTES[selected] or ""
	ui.level.Text = string.format("Level %d / %d", level, maxLevel)
	ui.now.Text = "Now: " .. describe(selected, current)
	if nextLevel then
		ui.next.Text = "Next: " .. describe(selected, nextLevel)
		ui.buy.Text = "Upgrade · 💰" .. Format.number(nextLevel.Cost)
		Kit.setButtonEnabled(ui.buy, data.coins >= nextLevel.Cost, Kit.Colors.Green)
	else
		ui.next.Text = "Maxed out!"
		ui.buy.Text = "MAX"
		Kit.setButtonEnabled(ui.buy, false)
	end
	if selected == "Shield" then
		ui.extra.Text = "Comfy Cushion: your favorite creature sits beside your tower and can NEVER be snatched. Move one there from the Tower or Box menu."
	else
		ui.extra.Text = "Everything here is bought with Giggle Coins. Protection is earned, never bought."
	end
end

Shop.tick = Shop.refresh

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Tower</string>
              <string name="Source"><![CDATA[--[[
	Tower: manage your stack. Reorder creatures (the stacking puzzle!), move a
	favorite to the Comfy Cushion, or take one into your hands. Changes that
	would make the tower too wobbly are refused by the server.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Creatures = require(Shared.Creatures)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Wobble = require(Shared.Wobble)

local Kit = require(script.Parent.Parent.UI.Kit)

local Tower = {}

local ui = {}

local function entryName(entry): string
	local def = Creatures.ById[entry.id]
	local name = def and def.Name or "???"
	if entry.m then
		name = (Mutations.name(entry.m) or entry.m) .. " " .. name
	end
	return name
end

local function smallButton(parent, text, color, order, onClick)
	return Kit.button({
		Text = text,
		TextSize = 18,
		Size = UDim2.fromOffset(44, 40),
		Color = color,
		LayoutOrder = order,
		Parent = parent,
		OnClick = onClick,
	})
end

local function action(name: string, uid: any)
	Remotes.get("TowerAction"):FireServer(name, uid)
end

function Tower.build(parent, _, close)
	local frame, content = Kit.window({ Name = "Tower", Title = "My Tower", Size = UDim2.fromOffset(640, 520), Parent = parent, OnClose = close })
	ui.header = Kit.label({ Text = "", TextSize = 18, Size = UDim2.new(1, 0, 0, 24), Parent = content })
	ui.cushion = Kit.panel({
		Size = UDim2.new(1, 0, 0, 52),
		Position = UDim2.fromOffset(0, 28),
		BackgroundColor3 = Color3.fromRGB(255, 225, 240),
		Parent = content,
	})
	ui.cushionText = Kit.label({ Text = "", TextSize = 17, Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(10, 0), Parent = ui.cushion })
	ui.cushionTake = Kit.button({
		Text = "✋ Take",
		TextSize = 17,
		Size = UDim2.fromOffset(100, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Kit.Colors.Blue,
		Parent = ui.cushion,
		OnClick = function()
			action("uncushion", "1")
		end,
	})
	ui.list = Kit.scroll({ Size = UDim2.new(1, 0, 1, -116), Position = UDim2.fromOffset(0, 86), Parent = content })
	Kit.list(nil, 6).Parent = ui.list
	Kit.label({
		Text = "Top of the tower is listed first. ▲▼ reorder · 🛋 move to Comfy Cushion · ✋ take into your hands",
		TextSize = 14,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.new(0, 0, 1, -26),
		TextColor3 = Kit.Colors.Muted,
		Parent = content,
	})
	return frame
end

function Tower.refresh(data)
	local tower = data.tower
	local ratio = Wobble.ratio(tower, Economy.glueReduce(data))
	ui.header.Text = string.format(
		"%d / %d tall  ·  Wobble %s  ·  Sticky Jam Lv %d  ·  %s coins/s",
		#tower,
		Economy.maxSlots(data),
		Format.percent(ratio),
		data.upgrades.Glue,
		Format.number(data.rate or 0)
	)
	local cushion = data.cushions[1]
	if type(cushion) == "table" then
		ui.cushionText.Text = "🛋 Comfy Cushion: " .. entryName(cushion) .. " (never snatchable)"
		ui.cushionTake.Visible = true
	else
		ui.cushionText.Text = "🛋 Comfy Cushion: empty - a creature here can never be snatched"
		ui.cushionTake.Visible = false
	end

	for _, child in ui.list:GetChildren() do
		if child:IsA("Frame") or child.Name == "Empty" then
			child:Destroy()
		end
	end
	local multiplier = Economy.heightMultiplier(tower)
	for i = #tower, 1, -1 do
		local entry = tower[i]
		local def = Creatures.ById[entry.id]
		local rarity = Rarities.get(def and def.Rarity or "Common")
		local row = Kit.panel({
			Size = UDim2.new(1, -12, 0, 50),
			LayoutOrder = #tower - i,
			BackgroundColor3 = i == #tower and Color3.fromRGB(255, 240, 220) or Kit.Colors.Panel,
			Parent = ui.list,
		})
		Kit.label({
			Text = string.format("%d. %s %s", i, rarity.Badge, entryName(entry)) .. (i == #tower and "  (top - snatchable!)" or ""),
			TextSize = 17,
			Size = UDim2.new(1, -230, 0, 24),
			Position = UDim2.fromOffset(10, 3),
			TextColor3 = rarity.Color:Lerp(Kit.Colors.Text, 0.5),
			Parent = row,
		})
		Kit.label({
			Text = string.format("%s · %s/s", def and Creatures.Shapes[def.Shape].Name or "", Format.number(Economy.creatureRate(tower, i) * multiplier)),
			TextSize = 14,
			Size = UDim2.new(1, -230, 0, 18),
			Position = UDim2.fromOffset(10, 27),
			TextColor3 = Kit.Colors.Muted,
			Parent = row,
		})
		local buttons = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(212, 40),
			Position = UDim2.new(1, -6, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Parent = row,
		})
		Kit.list(Enum.FillDirection.Horizontal, 4).Parent = buttons
		smallButton(buttons, "▲", Kit.Colors.Purple, 1, function()
			action("up", entry.u)
		end).Visible = i < #tower
		smallButton(buttons, "▼", Kit.Colors.Purple, 2, function()
			action("down", entry.u)
		end).Visible = i > 1
		smallButton(buttons, "🛋", Kit.Colors.Pink, 3, function()
			action("cushion", entry.u)
		end)
		smallButton(buttons, "✋", Kit.Colors.Blue, 4, function()
			action("take", entry.u)
		end)
	end
	if #tower == 0 then
		Kit.label({ Text = "Your tower is empty! Buy a creature from Captain Conveyor and DROP it on your plate.", TextSize = 17, Size = UDim2.new(1, -12, 0, 50), Parent = ui.list }).Name = "Empty"
	end
end

return Tower
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Kit: tiny UI toolkit. Big, friendly, rounded, candy-colored, mobile-first.
]]

local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.Font = Enum.Font.FredokaOne

Kit.Colors = {
	Panel = Color3.fromRGB(255, 249, 242),
	PanelDark = Color3.fromRGB(250, 236, 245),
	Stroke = Color3.fromRGB(130, 80, 150),
	Text = Color3.fromRGB(85, 50, 95),
	TextLight = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(150, 125, 160),
	Pink = Color3.fromRGB(255, 130, 175),
	Blue = Color3.fromRGB(110, 185, 255),
	Green = Color3.fromRGB(110, 205, 120),
	Yellow = Color3.fromRGB(255, 205, 70),
	Orange = Color3.fromRGB(255, 165, 80),
	Red = Color3.fromRGB(240, 90, 100),
	Purple = Color3.fromRGB(175, 120, 255),
	Grey = Color3.fromRGB(190, 180, 195),
	Gold = Color3.fromRGB(255, 210, 70),
}

-- Kit.new("Frame", { Size = ..., Parent = ... }, { children })
function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(radius: number?)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function Kit.round()
	return Kit.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Kit.stroke(color: Color3?, thickness: number?)
	return Kit.new("UIStroke", {
		Color = color or Kit.Colors.Stroke,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.textStroke(color: Color3?, thickness: number?)
	return Kit.new("UIStroke", {
		Color = color or Color3.fromRGB(70, 35, 80),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Kit.padding(px: number)
	local u = UDim.new(0, px)
	return Kit.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Kit.list(direction: Enum.FillDirection?, padding: number?, align: Enum.HorizontalAlignment?)
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function Kit.label(props: { [string]: any })
	local defaults = {
		BackgroundTransparency = 1,
		Font = Kit.Font,
		TextColor3 = Kit.Colors.Text,
		TextSize = 20,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for k, v in props do
		defaults[k] = v
	end
	return Kit.new("TextLabel", defaults)
end

function Kit.panel(props: { [string]: any })
	local defaults = {
		BackgroundColor3 = Kit.Colors.Panel,
		BorderSizePixel = 0,
	}
	for k, v in props do
		defaults[k] = v
	end
	local frame = Kit.new("Frame", defaults)
	Kit.corner(16).Parent = frame
	Kit.stroke().Parent = frame
	return frame
end

function Kit.tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

Kit.clickSound = nil -- set by the Sound controller

-- A chunky button. props.OnClick is called on activation.
function Kit.button(props: { [string]: any })
	local onClick = props.OnClick
	local color = props.Color or Kit.Colors.Pink
	local btn = Kit.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Font = Kit.Font,
		Text = props.Text or "",
		TextColor3 = props.TextColor or Kit.Colors.TextLight,
		TextSize = props.TextSize or 22,
		TextWrapped = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	Kit.corner(props.Radius or 14).Parent = btn
	Kit.stroke(color:Lerp(Color3.new(0, 0, 0), 0.35), 3).Parent = btn
	Kit.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.5), 1.5).Parent = btn
	local scale = Kit.new("UIScale", { Parent = btn })
	btn.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.08, { Scale = 0.92 })
	end)
	btn.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	btn.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	if onClick then
		btn.Activated:Connect(function()
			if Kit.clickSound then
				Kit.clickSound()
			end
			onClick(btn)
		end)
	end
	return btn
end

function Kit.setButtonEnabled(btn: TextButton, enabled: boolean, color: Color3?)
	btn.AutoButtonColor = enabled
	btn.BackgroundColor3 = enabled and (color or btn.BackgroundColor3) or Kit.Colors.Grey
	btn.Active = enabled
end

-- A centered window with a title and a close button. Returns frame, content.
function Kit.window(props: { [string]: any })
	local frame = Kit.panel({
		Name = props.Name or "Window",
		Size = props.Size or UDim2.fromOffset(620, 460),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		Parent = props.Parent,
	})
	local title = Kit.label({
		Name = "Title",
		Text = props.Title or "",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -120, 0, 44),
		Position = UDim2.fromOffset(60, 6),
		TextColor3 = props.TitleColor or Kit.Colors.Text,
		Parent = frame,
	})
	Kit.button({
		Name = "Close",
		Text = "X",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, -52, 0, 8),
		Color = Kit.Colors.Red,
		Parent = frame,
		OnClick = function()
			if props.OnClose then
				props.OnClose()
			else
				frame.Visible = false
			end
		end,
	})
	local content = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -24, 1, -64),
		Position = UDim2.fromOffset(12, 56),
		Parent = frame,
	})
	return frame, content, title
end

function Kit.scroll(props: { [string]: any })
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.Colors.Stroke,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Size = UDim2.fromScale(1, 1),
	}
	for k, v in props do
		defaults[k] = v
	end
	return Kit.new("ScrollingFrame", defaults)
end

-- A horizontal fill bar. Returns the frame and a setter (fraction, color?).
function Kit.bar(props: { [string]: any })
	local frame = Kit.new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size or UDim2.new(1, 0, 0, 16),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.fromRGB(235, 225, 235),
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Kit.round().Parent = frame
	Kit.stroke(Kit.Colors.Stroke, 2).Parent = frame
	local fill = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color or Kit.Colors.Green,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Kit.round().Parent = fill
	local function set(fraction: number, color: Color3?)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return frame, set
end

-- Green -> yellow -> red for a 0..1 wobble ratio.
function Kit.wobbleColor(ratio: number): Color3
	if ratio < 0.5 then
		return Kit.Colors.Green:Lerp(Kit.Colors.Yellow, ratio / 0.5)
	end
	return Kit.Colors.Yellow:Lerp(Kit.Colors.Red, math.clamp((ratio - 0.5) / 0.5, 0, 1))
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--[[
	Root: the one ScreenGui everything lives in, with layers and a UIScale so
	the same layout works on phones, tablets, PCs and consoles.
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Kit = require(script.Parent.Kit)

local Root = {}

Root.userScale = 1

local function layer(name: string, z: number)
	return Kit.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z,
		Parent = Root.container,
	})
end

function Root.updateScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local base = math.min(size.X / 1280, (size.Y - 58) / 680)
	local s = math.clamp(base, 0.5, 1.25) * Root.userScale
	-- The container is 1/s of the screen and then scaled by s, so it always
	-- fills the screen exactly while everything inside is drawn s times bigger.
	Root.container.Size = UDim2.fromScale(1 / s, 1 / s)
	Root.scale.Scale = s
end

function Root.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	Root.gui = Kit.new("ScreenGui", {
		Name = "StackAndSnatch",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	Root.container = Kit.new("Frame", {
		Name = "Scaled",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Parent = Root.gui,
	})
	Root.scale = Kit.new("UIScale", { Parent = Root.container })
	Root.hud = layer("Hud", 1)
	Root.panels = layer("Panels", 5)
	Root.overlay = layer("Overlay", 10)
	Root.toasts = layer("Toasts", 20)

	Root.updateScale()
	local function watchCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(Root.updateScale)
			Root.updateScale()
		end
	end
	watchCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)

	-- Our "Server Towers" list replaces the default player list.
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)
end

function Root.setUserScale(scale: number)
	Root.userScale = scale
	Root.updateScale()
end

return Root
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="67">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-200</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>