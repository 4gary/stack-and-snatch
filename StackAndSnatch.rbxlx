		Look = "LordJellington",
	},
}

Creatures.ById = {}
Creatures.ByRarity = {}
for index, def in Creatures.List do
	def.Number = index
	def.Wobble = def.Wobble or {}
	def.Bonus = def.Bonus or {}
	Creatures.ById[def.Id] = def
	Creatures.ByRarity[def.Rarity] = Creatures.ByRarity[def.Rarity] or {}
	table.insert(Creatures.ByRarity[def.Rarity], def)
end

function Creatures.get(id: string)
	return Creatures.ById[id]
end

-- Pick a random creature of the given rarity.
function Creatures.randomOfRarity(rarity: string, rng: Random)
	local pool = Creatures.ByRarity[rarity] or Creatures.ByRarity.Common
	return pool[rng:NextInteger(1, #pool)]
end

return Creatures
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy: coin rates, upgrade lookups and the Fair Snatch Range.
	Pure functions, shared by server and client so the HUD always matches.

	coins per second = (sum of creature rates x mutation x trait bonuses)
	                   x height multiplier x (1 + Index bonus) x nap factor
	                   + cushion creatures at their base rate
]]

local Config = require(script.Parent.Config)
local Creatures = require(script.Parent.Creatures)
local Mutations = require(script.Parent.Mutations)

local Economy = {}

local E = Config.Economy

-- Height that counts for the height bonus (Gummy Giraffe counts as 3).
function Economy.effectiveHeight(entries: { any }): number
	local h = 0
	for _, entry in entries do
		local def = Creatures.ById[entry.id]
		h += (def and def.Bonus.HeightLayers) or 1
	end
	return h
end

function Economy.heightMultiplier(entries: { any }): number
	return 1 + E.HeightBonusPerLayer * math.max(0, Economy.effectiveHeight(entries) - 1)
end

-- Coins per second for one creature at position i in the tower.
function Economy.creatureRate(entries: { any }, i: number): number
	local entry = entries[i]
	local def = Creatures.ById[entry.id]
	if not def then
		return 0
	end
	local n = #entries
	local rate = def.Rate * Mutations.multiplier(entry.m)
	if def.Bonus.TopMultiplier and i == n then
		rate *= def.Bonus.TopMultiplier
	end
	if def.Bonus.PerAbove then
		rate *= 1 + def.Bonus.PerAbove * (n - i)
	end
	local adjacent = 0
	local below = entries[i - 1] and Creatures.ById[entries[i - 1].id]
	local above = entries[i + 1] and Creatures.ById[entries[i + 1].id]
	if below and below.Bonus.Adjacent then
		adjacent += below.Bonus.Adjacent
	end
	if above and above.Bonus.Adjacent then
		adjacent += above.Bonus.Adjacent
	end
	return rate * (1 + adjacent)
end

function Economy.towerRate(entries: { any }): number
	local sum = 0
	for i in entries do
		sum += Economy.creatureRate(entries, i)
	end
	return sum * Economy.heightMultiplier(entries)
end

function Economy.cushionRate(cushions: { any }): number
	local sum = 0
	for _, entry in cushions do
		if type(entry) == "table" then
			local def = Creatures.ById[entry.id]
			if def then
				sum += def.Rate * Mutations.multiplier(entry.m) * E.CushionIncomeMultiplier
			end
		end
	end
	return sum
end

function Economy.indexCount(index: { [string]: any }): number
	local count = 0
	for id in index do
		if Creatures.ById[id] then
			count += 1
		end
	end
	return count
end

function Economy.indexBonus(index: { [string]: any }): number
	return E.IndexBonusPerCreature * Economy.indexCount(index)
end

-- Total coins per second for a player's saved data.
function Economy.totalRate(data: any, napping: boolean?): number
	local rate = Economy.towerRate(data.tower) + Economy.cushionRate(data.cushions)
	rate *= 1 + Economy.indexBonus(data.index)
	if napping then
		rate *= E.NapIncomeMultiplier
	end
	return rate
end

-- Upgrades --------------------------------------------------------------------
function Economy.upgradeLevel(data: any, track: string)
	local levels = Config.Upgrades[track].Levels
	local level = math.clamp(data.upgrades[track] or 1, 1, #levels)
	return levels[level], level, #levels
end

function Economy.nextUpgrade(data: any, track: string)
	local levels = Config.Upgrades[track].Levels
	local level = data.upgrades[track] or 1
	return levels[level + 1], level + 1
end

function Economy.glueReduce(data: any): number
	return (Economy.upgradeLevel(data, "Glue")).Reduce
end

function Economy.maxSlots(data: any): number
	return (Economy.upgradeLevel(data, "Base")).Slots
end

function Economy.boxCapacity(data: any): number
	return (Economy.upgradeLevel(data, "Base")).Box
end

-- Fair Snatch Range: which tower heights you are allowed to snatch from.
function Economy.fairRange(myHeight: number): (number, number)
	local fr = Config.Protection.FairRange
	local minH = math.floor(myHeight * fr.MinFraction)
	local maxH = math.max(math.ceil(myHeight * fr.MaxMultiplier), fr.MinCap, myHeight + fr.MaxExtra)
	return minH, maxH
end

function Economy.inFairRange(myHeight: number, targetHeight: number): boolean
	local minH, maxH = Economy.fairRange(myHeight)
	return targetHeight >= minH and targetHeight <= maxH
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format: friendly number and time strings ("1.2K", "3.4M", "2:05").
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc" }

function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local text
	if n < 1000 then
		if n < 10 and math.floor(n) ~= n then
			text = string.format("%.1f", n)
		else
			text = tostring(math.floor(n))
		end
	else
		local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
		local scaled = n / 10 ^ (tier * 3)
		if scaled >= 100 then
			text = string.format("%d%s", math.floor(scaled), SUFFIXES[tier + 1])
		else
			text = string.format("%.1f%s", math.floor(scaled * 10) / 10, SUFFIXES[tier + 1])
		end
	end
	return negative and ("-" .. text) or text
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds + 0.5))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[--[[
	Mutations: rare visual variants that earn more. Always earned through play,
	never sold. Launch set from the MVP column of the design doc.
]]

local Mutations = {}

Mutations.Order = { "Sprinkled", "Glittery", "GoldenToast" }

Mutations.ById = {
	Sprinkled = {
		Name = "Sprinkled",
		Multiplier = 1.5,
		Color = Color3.fromRGB(255, 120, 190),
		Look = "Covered in rainbow sprinkles",
	},
	Glittery = {
		Name = "Glittery",
		Multiplier = 2,
		Color = Color3.fromRGB(190, 230, 255),
		Look = "Sparkles constantly",
	},
	GoldenToast = {
		Name = "Golden Toast",
		Multiplier = 8,
		Color = Color3.fromRGB(255, 196, 60),
		Look = "Shiny golden crust",
	},
}

function Mutations.multiplier(mutation: string?): number
	if mutation and Mutations.ById[mutation] then
		return Mutations.ById[mutation].Multiplier
	end
	return 1
end

function Mutations.name(mutation: string?): string?
	if mutation and Mutations.ById[mutation] then
		return Mutations.ById[mutation].Name
	end
	return nil
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[--[[
	Rarities: the seven tiers from the design doc.
	Each tier also has a shape badge so rarity never relies on color alone.
]]

local Rarities = {}

Rarities.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Rarities.ById = {
	Common = {
		Tier = 1,
		Name = "Common",
		Color = Color3.fromRGB(235, 235, 235),
		Badge = "●",
	},
	Uncommon = {
		Tier = 2,
		Name = "Uncommon",
		Color = Color3.fromRGB(110, 220, 120),
		Badge = "▲",
	},
	Rare = {
		Tier = 3,
		Name = "Rare",
		Color = Color3.fromRGB(80, 160, 255),
		Badge = "■",
		Announce = true,
	},
	Epic = {
		Tier = 4,
		Name = "Epic",
		Color = Color3.fromRGB(180, 100, 255),
		Badge = "◆",
		Announce = true,
	},
	Legendary = {
		Tier = 5,
		Name = "Legendary",
		Color = Color3.fromRGB(255, 200, 40),
		Badge = "★",
		Announce = true,
		BigAnnounce = true,
	},
	Mythic = {
		Tier = 6,
		Name = "Mythic",
		Color = Color3.fromRGB(255, 110, 200),
		Badge = "✦",
		Announce = true,
		BigAnnounce = true,
	},
	Secret = {
		Tier = 7,
		Name = "Wobbly Wonder",
		Color = Color3.fromRGB(150, 255, 245),
		Badge = "❖",
		Announce = true,
		BigAnnounce = true,
	},
}

function Rarities.get(id: string)
	return Rarities.ById[id] or Rarities.ById.Common
end

function Rarities.tier(id: string): number
	return Rarities.get(id).Tier
end

-- Pick a rarity id from a weights table such as Config.Conveyor.Weights.
function Rarities.roll(weights: { [string]: number }, rng: Random): string
	local total = 0
	for _, id in Rarities.Order do
		total += weights[id] or 0
	end
	local pick = rng:NextNumber() * total
	for _, id in Rarities.Order do
		local w = weights[id] or 0
		if w > 0 then
			if pick < w then
				return id
			end
			pick -= w
		end
	end
	return "Common"
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes: every RemoteEvent / RemoteFunction the game uses, by name.
	The server creates them; clients wait for them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

-- Client -> server requests (the server validates every one of them).
Remotes.Events = {
	"ClientReady",
	"PlaceHeld", -- (dropServerTime)
	"StoreHeld", -- ()
	"TakeFromBox", -- (uid)
	"TowerAction", -- (action, uid)
	"PickUpGround", -- (uid)
	"BuyConveyor", -- (uid)
	"RequestScoop", -- (uid)
	"ScoopResult", -- (sessionId, markerPosition)
	"RequestSnatch", -- (plotIndex | "practice")
	"SnatchResult", -- (sessionId, success, stats)
	"ActivateShield", -- ()
	"Boop", -- ()
	"BuyUpgrade", -- (track)
	"Emote", -- (index)
	"Tutorial", -- (action)
	"SaveSettings", -- (settings)
	"Dev", -- (action, arg) - only works in Studio
	-- Server -> client
	"State", -- full personal snapshot
	"Tick", -- light per-second update (coins, rate)
	"Notify", -- banner message
	"Dialog", -- tutorial / NPC dialog
	"SnatchStart", -- start the steady-hand minigame
	"ScoopStart", -- start the scoop timing minigame
	"Effect", -- sounds + visual effects for everyone
}

Remotes.Functions = {
	"RedeemCode", -- (code) -> message
}

local FOLDER_NAME = "Remotes"

function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init is server-only")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in Remotes.Events do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
	for _, name in Remotes.Functions do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
	end
end

local cache = {}

function Remotes.get(name: string): any
	local cached = cache[name]
	if cached then
		return cached
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	local remote = folder:WaitForChild(name, 30)
	assert(remote, "Missing remote " .. name)
	cache[name] = remote
	return remote
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal: a tiny in-script event (connect / fire), used by client controllers.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self.handlers
	handlers[fn] = true
	return {
		Disconnect = function()
			handlers[fn] = nil
		end,
	}
end

function Signal:Fire(...)
	for fn in table.clone(self.handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">TowerLayout</string>
          <string name="Source"><![CDATA[--[[
	TowerLayout: turns a tower list into world positions.

	Creatures stack straight up; each one is shifted sideways by the offset it
	was dropped at, and offsets accumulate, so a sloppy tower visibly leans.
	Shared so the server's models and the client's ghost preview line up.
]]

local Creatures = require(script.Parent.Creatures)

local TowerLayout = {}

-- Returns an array of bottom-center CFrames (one per entry) and the CFrame of
-- the top surface (where the next creature would sit, before its own offset).
function TowerLayout.layout(entries: { any }, origin: CFrame): ({ CFrame }, CFrame)
	local cframes = table.create(#entries)
	local x, y, z = 0, 0, 0
	for i, entry in entries do
		if i > 1 then
			x += entry.x or 0
			z += entry.z or 0
		end
		cframes[i] = origin * CFrame.new(x, y, z)
		local def = Creatures.ById[entry.id]
		y += def and def.Height or 2
	end
	return cframes, origin * CFrame.new(x, y, z)
end

function TowerLayout.height(entries: { any }): number
	local y = 0
	for _, entry in entries do
		local def = Creatures.ById[entry.id]
		y += def and def.Height or 2
	end
	return y
end

return TowerLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Wobble</string>
          <string name="Source"><![CDATA[--[[
	Wobble: the stacking rules. Pure functions, shared by server and client.

	"Rules decide, animation shows" (design doc 4.2 / 5.2): the tower is an
	ordered list of creatures, bottom first. Stability is a score built from
	simple, predictable rules, so the same placement always gives the same result:

	  layer wobble = (what's underneath + what's on top + the creature's own wobble
	                  + how far off-center you dropped it + how far the stack leans)
	                 x special pairings (sock drape, doughnut ring, floating bunny)
	                 x squishy absorption from the creatures below
	                 x a little extra for every layer of height

	  tower wobble = sum of layer wobbles x (1 - Sticky Jam reduction)

	The tower topples when its wobble goes above its capacity.

	Tower entries look like { u = uid, id = creatureId, m = mutation?, x = offX, z = offZ }.
]]

local Config = require(script.Parent.Config)
local Creatures = require(script.Parent.Creatures)

local Wobble = {}

local W = Config.Wobble
local P = Config.Pendulum

local function offsetPenalty(ox: number, oz: number): number
	local mag = math.sqrt(ox * ox + oz * oz)
	local t = math.min(1, mag / P.Amplitude)
	return W.OffsetPenaltyMax * t * t
end

-- Wobble contributed by each layer. Returns (layers, total before glue).
function Wobble.layers(entries: { any })
	local result = table.create(#entries, 0)
	local absorb = 1
	local leanX, leanZ = 0, 0
	local total = 0
	for i, entry in entries do
		local def = Creatures.ById[entry.id]
		-- The bottom creature always sits centered on the plate.
		local ox, oz = 0, 0
		if i > 1 then
			ox, oz = entry.x or 0, entry.z or 0
		end
		leanX += ox
		leanZ += oz
		local w = 0
		if def and i > 1 then
			local below = Creatures.ById[entries[i - 1].id]
			local belowBase = 1
			local belowFactor = 1
			if below then
				belowBase = below.Wobble.Below or W.BelowByShape[below.Shape] or 1
				belowFactor = below.Wobble.NextLayerFactor or 1
			end
			local lean = math.sqrt(leanX * leanX + leanZ * leanZ)
			w = belowBase
				+ (W.AboveByShape[def.Shape] or 0)
				+ (def.Wobble.Self or 0)
				+ offsetPenalty(ox, oz)
				+ W.LeanPenaltyPerStud * lean
			w *= belowFactor * (def.Wobble.OwnLayerFactor or 1)
			w *= math.max(W.MinAbsorbFactor, absorb)
			w *= 1 + W.HeightGrowth * i
			w = math.max(0, w)
		end
		if def then
			absorb *= 1 - (def.Wobble.Absorb or 0)
		end
		result[i] = w
		total += w
	end
	return result, total
end

-- How much wobble the tower can take before toppling.
function Wobble.capacity(entries: { any }): number
	local cap = W.Capacity
	local bottom = entries[1] and Creatures.ById[entries[1].id]
	if bottom and bottom.Wobble.BottomCapacity then
		cap += bottom.Wobble.BottomCapacity
	end
	return cap
end

-- Total wobble score after Sticky Jam.
function Wobble.total(entries: { any }, glueReduce: number): number
	local _, total = Wobble.layers(entries)
	return total * (1 - (glueReduce or 0))
end

-- 0 = rock steady, 1 = about to topple.
function Wobble.ratio(entries: { any }, glueReduce: number): number
	if #entries <= 1 then
		return 0
	end
	return Wobble.total(entries, glueReduce) / Wobble.capacity(entries)
end

function Wobble.isStable(entries: { any }, glueReduce: number): boolean
	return Wobble.total(entries, glueReduce) <= Wobble.capacity(entries)
end

-- The placement swing --------------------------------------------------------
-- The ghost creature sways in a figure-8 above the tower. Both sides compute it
-- from server time, so the server knows exactly where a drop at time t lands.
function Wobble.swingPeriod(layerCount: number): number
	return math.max(P.MinPeriod, P.BasePeriod - P.PeriodShrinkPerLayer * layerCount)
end

function Wobble.swingOffset(serverTime: number, layerCount: number): (number, number)
	if layerCount <= 0 then
		return 0, 0 -- the first creature always sits neatly on the plate
	end
	local theta = 2 * math.pi * (serverTime / Wobble.swingPeriod(layerCount))
	local x = P.Amplitude * math.sin(theta)
	local z = P.Amplitude * 0.45 * math.sin(2 * theta)
	return x, z
end

-- Round offsets so they save compactly and both sides agree exactly.
function Wobble.roundOffset(v: number): number
	return math.floor(v * 100 + 0.5) / 100
end

-- Copy of `entries` with `candidate` added on top.
function Wobble.withTop(entries: { any }, candidate: any): { any }
	local copy = table.clone(entries)
	table.insert(copy, candidate)
	return copy
end

return Wobble
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Stack & Snatch - server entry point.

	Builds the world, creates the remotes, then starts every service.
	Services never require each other directly; they receive the shared
	`Services` table in init() and look each other up at call time.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

Remotes.init()

local gameState = ReplicatedStorage:FindFirstChild("GameState") or Instance.new("Folder")
gameState.Name = "GameState"
gameState.Parent = ReplicatedStorage

local ORDER = {
	"Map",
	"Data",
	"Sync",
	"Towers",
	"Practice",
	"Plots",
	"Stacking",
	"Protection",
	"Progress",
	"Earnings",
	"Conveyor",
	"Meadows",
	"Snatch",
	"Shops",
	"Weather",
	"Social",
	"Onboarding",
	"Dev",
}

local Services = {}
for _, name in ORDER do
	Services[name] = require(script.Parent.Services[name])
end

for _, name in ORDER do
	local service = Services[name]
	if service.init then
		service.init(Services)
	end
end

for _, name in ORDER do
	local service = Services[name]
	if service.start then
		task.spawn(service.start)
	end
end

print("[Stack & Snatch] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Conveyor</string>
            <string name="Source"><![CDATA[--[[
	Conveyor: the Fluff-O-Matic sneezes creatures onto Captain Conveyor's belt,
	which loops around the plaza. Walk up and buy one with Giggle Coins.

	The server decides what spawns (weighted by rarity, plus guaranteed
	Legendary and Mythic timers so players can plan). Clients animate the ride
	from each item's SpawnAt time (ConveyorPath), so it stays smooth.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ConveyorPath = require(Shared.ConveyorPath)
local CreatureModel = require(Shared.CreatureModel)
local Creatures = require(Shared.Creatures)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Util = require(script.Parent.Parent.Util)

local Conveyor = {}

local S
local C = Config.Conveyor
local rng = Random.new()
local items = {} -- [uid] = item
local count = 0

Conveyor.items = items

local function gameState()
	return ReplicatedStorage:FindFirstChild("GameState")
end

local function makeLabel(model: Model, def, mutation: string?, price: number)
	local rarity = Rarities.get(def.Rarity)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(9, 2.6)
	gui.StudsOffset = Vector3.new(0, def.Height + 2.2, 0)
	gui.MaxDistance = rarity.Tier >= 3 and 160 or 70
	gui.LightInfluence = 0
	gui.Adornee = model.PrimaryPart
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = gui
	local function line(text, color, size, order)
		local label = Instance.new("TextLabel")
		label.LayoutOrder = order
		label.Size = UDim2.fromScale(1, size)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.1
		label.TextStrokeColor3 = Color3.fromRGB(50, 30, 60)
		label.Parent = gui
	end
	local name = def.Name
	if mutation then
		name = (Mutations.name(mutation) or mutation) .. " " .. name
	end
	line(name, Color3.fromRGB(255, 255, 255), 0.38, 1)
	line(rarity.Badge .. " " .. rarity.Name .. " · " .. Format.number(def.Rate * Mutations.multiplier(mutation)) .. "/s", rarity.Color, 0.3, 2)
	line("💰 " .. Format.number(price), Color3.fromRGB(255, 225, 90), 0.32, 3)
	gui.Parent = model
end

local function rollMutation(): string?
	for _, m in C.MutationChances do
		if rng:NextNumber() < m.Chance then
			return m.Mutation
		end
	end
	return nil
end

-- Put a creature on the belt. `forced` = specific rarity or creature id (dev / timers).
function Conveyor.spawn(forcedRarity: string?, forcedId: string?, forcedMutation: string?)
	local def
	if forcedId then
		def = Creatures.ById[forcedId]
	end
	if not def then
		local rarity = forcedRarity or Rarities.roll(C.Weights, rng)
		def = Creatures.randomOfRarity(rarity, rng)
	end
	local mutation = forcedMutation or rollMutation()
	local price = math.floor(def.Price * (mutation and math.min(Mutations.multiplier(mutation), 4) or 1))
	local uid = Util.uid()
	local spawnAt = Util.now()

	local model = CreatureModel.build(def.Id, mutation)
	if not model then
		return
	end
	model.Name = uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("SpawnAt", spawnAt)
	model:SetAttribute("Price", price)
	model:SetAttribute("Rarity", def.Rarity)
	model:PivotTo(ConveyorPath.cframeAt(0))
	makeLabel(model, def, mutation, price)
	model.Parent = S.Map.Conveyor

	items[uid] = { uid = uid, id = def.Id, m = mutation, price = price, spawnAt = spawnAt, model = model }
	count += 1

	local rarity = Rarities.get(def.Rarity)
	S.Sync.effectAll({ kind = "Sneeze", rarity = def.Rarity })
	if rarity.Announce then
		local name = def.Name
		if mutation then
			name = (Mutations.name(mutation) or mutation) .. " " .. name
		end
		local text = rarity.BigAnnounce and ("RARE ONE AHOY! A " .. rarity.Name .. " " .. name .. " is on the belt! Hold onto yer hats!")
			or ("Ahoy! A " .. rarity.Name .. " " .. name .. " on the belt!")
		S.Sync.notifyAll(text, rarity.BigAnnounce and "legendary" or "rare", "Captain Conveyor")
	end
	return uid
end

local function remove(uid: string)
	local item = items[uid]
	if item then
		items[uid] = nil
		count -= 1
		if item.model then
			item.model:Destroy()
		end
	end
end

function Conveyor.buy(owner, uid: any)
	if type(uid) ~= "string" then
		return
	end
	local item = items[uid]
	if not item then
		S.Sync.notify(owner, "Too slow! Someone else got that one.", "info", "Captain Conveyor")
		return
	end
	if not S.Stacking.handsFree(owner) then
		S.Sync.notify(owner, "Your hands are full! Stack or Box what you're holding first.", "info")
		return
	end
	local _, hrp = Util.character(owner.player)
	if not hrp then
		return
	end
	local elapsed = Util.now() - item.spawnAt
	local pos = ConveyorPath.positionAt(elapsed)
	if Util.flatDistance(hrp.Position, pos) > C.BuyDistance + C.Speed * 0.6 + 4 then
		S.Sync.notify(owner, "Get a little closer to the belt!", "info")
		return
	end
	if owner.data.coins < item.price then
		S.Sync.notify(owner, "You need " .. Format.number(item.price) .. " Giggle Coins for that one.", "info", "Captain Conveyor")
		return
	end
	owner.data.coins -= item.price
	owner.data.stats.bought += 1
	remove(uid)
	local entry = S.Stacking.newEntry(item.id, item.m)
	S.Stacking.give(owner, entry, "conveyor")
	S.Protection.markActive(owner)
	S.Sync.effectAll({ kind = "Buy", userId = owner.userId })
	S.Sync.notify(owner, "Got it! Carry it home and stack it.", "good", "Captain Conveyor")
	S.Onboarding.onBought(owner)
end

function Conveyor.init(services)
	S = services
	local state = gameState()
	if not state then
		state = Instance.new("Folder")
		state.Name = "GameState"
		state.Parent = ReplicatedStorage
	end
	Remotes.get("BuyConveyor").OnServerEvent:Connect(function(player, uid)
		local owner = S.Plots.get(player)
		if owner then
			Conveyor.buy(owner, uid)
		end
	end)
end

function Conveyor.start()
	local state = gameState()
	local nextLegendary = Util.now() + C.LegendaryEvery
	local nextMythic = Util.now() + C.MythicEvery
	state:SetAttribute("NextLegendaryAt", nextLegendary)
	state:SetAttribute("NextMythicAt", nextMythic)
	local duration = ConveyorPath.duration()
	local nextSpawn = 0
	while true do
		task.wait(0.25)
		local now = Util.now()
		for uid, item in items do
			if now - item.spawnAt > duration then
				remove(uid)
			end
		end
		if now >= nextMythic then
			nextMythic = now + C.MythicEvery
			state:SetAttribute("NextMythicAt", nextMythic)
			pcall(Conveyor.spawn, "Mythic")
			nextSpawn = now + C.SpawnInterval
		elseif now >= nextLegendary then
			nextLegendary = now + C.LegendaryEvery
			state:SetAttribute("NextLegendaryAt", nextLegendary)
			pcall(Conveyor.spawn, "Legendary")
			nextSpawn = now + C.SpawnInterval
		elseif now >= nextSpawn and count < C.MaxItems then
			nextSpawn = now + C.SpawnInterval
			local ok, err = pcall(Conveyor.spawn)
			if not ok then
				warn("[Conveyor]", err)
			end
		end
	end
end

return Conveyor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--[[
	Data: saving player progress (design doc 5.2 #8).

	Uses DataStore UpdateAsync with a session lock, so a player's data can only be
	open on one server at a time (prevents data loss and duplication). Every
	creature has a unique id and lives in exactly one place.

	In Studio, saving only works if the place is published and "Enable Studio
	Access to API Services" is on (Game Settings > Security). Without it the game
	still runs; progress just isn't saved, and the HUD says so.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Data = {}

local D = Config.Data
local store = nil
local storeDisabledReason = nil

Data.VERSION = 1

function Data.default()
	local cushions = {}
	for i = 1, Config.Protection.CushionSlots do
		cushions[i] = false
	end
	return {
		v = Data.VERSION,
		coins = 0,
		tower = {}, -- bottom to top: { u, id, m, x, z }
		box = {}, -- stored creatures: { u, id, m }
		cushions = cushions, -- unsnatchable favorites (false = empty slot)
		held = nil, -- creature in your hands
		transit = {}, -- snatched from you and still being carried away
		upgrades = { Glue = 1, Base = 1, Shield = 1 },
		index = {}, -- [creatureId] = { base = true, Sprinkled = true, ... }
		ribbons = {}, -- ["10"] = true
		quests = {}, -- [questId] = true
		playtime = 0,
		tutorial = 0, -- 0 = new, 1..4 = step, 99 = done
		lastOnline = 0,
		stats = { snatches = 0, snatched = 0, topples = 0, bought = 0, scooped = 0 },
		codes = {},
		settings = { calm = false, uiScale = 1, sfx = true },
	}
end

-- Fill in anything missing (older saves, new features).
function Data.reconcile(data: any)
	local fresh = Data.default()
	if type(data) ~= "table" then
		return fresh
	end
	for k, v in fresh do
		if data[k] == nil and k ~= "held" then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and (k == "upgrades" or k == "stats" or k == "settings") then
			for k2, v2 in v do
				if data[k][k2] == nil then
					data[k][k2] = v2
				end
			end
		end
	end
	for i = 1, Config.Protection.CushionSlots do
		if data.cushions[i] == nil then
			data.cushions[i] = false
		end
	end
	data.v = Data.VERSION
	return data
end

local function isStudioAccessError(message: string): boolean
	message = string.lower(message)
	return string.find(message, "studio", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "api services", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

function Data.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(D.StoreName)
	end)
	if ok then
		store = result
	else
		storeDisabledReason = tostring(result)
		warn("[Data] DataStores unavailable, progress will not save:", result)
	end
end

function Data.isPersistent(): boolean
	return store ~= nil
end

function Data.disabledReason(): string?
	return storeDisabledReason
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

-- Load (and lock) a player's data. Yields. Returns data, canSave.
function Data.load(player: Player)
	if not store then
		return Data.reconcile(nil), false
	end
	for attempt = 1, D.LoadRetries do
		local lockedElsewhere = false
		local loaded = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(record)
				record = record or {}
				local lock = record.lock
				if
					lock
					and lock.job ~= game.JobId
					and os.time() - (lock.time or 0) < D.SessionLockStale
					and attempt < D.LoadRetries
				then
					lockedElsewhere = true
					return nil -- cancel the write; try again shortly
				end
				loaded = record.data
				record.lock = { job = game.JobId, time = os.time() }
				return record
			end)
		end)
		if ok and not lockedElsewhere then
			return Data.reconcile(loaded), true
		end
		if not ok then
			local message = tostring(err)
			if RunService:IsStudio() and isStudioAccessError(message) then
				warn("[Data] Studio can't reach DataStores (publish the place and enable API access to save):", message)
				storeDisabledReason = message
				store = nil
				return Data.reconcile(nil), false
			end
			warn(string.format("[Data] load attempt %d for %s failed: %s", attempt, player.Name, message))
		end
		task.wait(D.LoadRetryDelay)
	end
	-- Could not load safely: play with fresh data but never save over the real save.
	warn("[Data] giving up loading", player.Name, "- this session will not save")
	return Data.reconcile(nil), false
end

-- Save; `release` drops the session lock (on leave / shutdown). Yields.
function Data.save(player: Player, data: any, release: boolean?): boolean
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(record)
			record = record or {}
			local lock = record.lock
			if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < D.SessionLockStale then
				return nil -- another server owns this data now; don't clobber it
			end
			record.data = data
			record.lock = (not release) and { job = game.JobId, time = os.time() } or nil
			return record
		end)
	end)
	if not ok then
		warn("[Data] save failed for", player.Name, err)
	end
	return ok
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Dev</string>
            <string name="Source"><![CDATA[--[[
	Dev: Studio-only test tools (the client shows a Dev panel in Studio).
	Every action is ignored outside Studio.
]]

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Creatures = require(Shared.Creatures)
local Remotes = require(Shared.Remotes)
local Wobble = require(Shared.Wobble)
local Economy = require(Shared.Economy)

local Dev = {}

local S
local rng = Random.new()

local function stableTower(count: number, pool: { string })
	local entries = {}
	for _ = 1, count do
		local entry = { u = S.Stacking.newEntry("Cubert").u, id = pool[rng:NextInteger(1, #pool)], x = 0, z = 0 }
		table.insert(entries, entry)
		if not Wobble.isStable(entries, 0.16) then
			table.remove(entries)
			entry.id = "Cubert"
			table.insert(entries, entry)
		end
	end
	return entries
end

local ACTIONS = {}

function ACTIONS.coins(owner, amount)
	owner.data.coins += math.clamp(tonumber(amount) or 1000, 0, 1e12)
	S.Sync.markDirty(owner)
end

function ACTIONS.give(owner, creatureId)
	local mutation = nil
	if type(creatureId) == "table" then
		creatureId, mutation = creatureId[1], creatureId[2]
	end
	if not Creatures.ById[creatureId] then
		creatureId = Creatures.List[rng:NextInteger(1, #Creatures.List)].Id
	end
	if not S.Stacking.give(owner, S.Stacking.newEntry(creatureId, mutation), "dev") then
		S.Sync.notify(owner, "Hands full - Box or stack what you're holding first.", "info")
	end
end

function ACTIONS.fill(owner)
	local data = owner.data
	local slots = Economy.maxSlots(data)
	local pool = { "Cubert", "PancakePup", "Hamwich", "MuffinMole", "Toastie" }
	data.tower = stableTower(math.max(0, slots - #data.tower) + #data.tower, pool)
	while #data.tower > slots do
		table.remove(data.tower)
	end
	if owner.host then
		S.Towers.refresh(owner.host)
	end
	S.Progress.onTowerChanged(owner)
	S.Plots.refreshPlot(owner)
	S.Plots.updateLeaderstats(owner)
	S.Sync.markDirty(owner)
end

function ACTIONS.bot(owner, size)
	local count = math.clamp(tonumber(size) or 6, 1, 30)
	local pool = { "Cubert", "PancakePup", "Hamwich", "Blobby", "BouncyBean", "SirWobbles", "JellybellyJelly" }
	local bot = S.Plots.addBot(stableTower(count, pool))
	if bot then
		S.Sync.notify(owner, bot.name .. " built a " .. count .. "-tall tower on pad " .. bot.plot.index .. ". Go snatch from it!", "good")
	else
		S.Sync.notify(owner, "No free base pads for a bot.", "warn")
	end
end

function ACTIONS.clearBots(owner)
	for _, other in S.Plots.all() do
		if other.isBot then
			S.Plots.removeOwner(other)
		end
	end
	S.Sync.notify(owner, "Bots cleared.", "info")
end

function ACTIONS.noProtect(owner)
	owner.devNoProtection = not owner.devNoProtection
	owner.moved = true
	S.Sync.notify(owner, owner.devNoProtection and "Your protections are OFF (others can snatch from you, no Fair Range)." or "Your protections are back ON.", "info")
	S.Sync.markDirty(owner)
end

function ACTIONS.weather()
	S.Weather.begin()
end

function ACTIONS.conveyor(_, rarity)
	S.Conveyor.spawn(type(rarity) == "string" and rarity or "Legendary")
end

function ACTIONS.wild(_, creatureId)
	S.Meadows.spawn(type(creatureId) == "string" and creatureId or nil)
end

function ACTIONS.shieldReset(owner)
	owner.shieldUntil = 0
	owner.shieldReadyAt = 0
	S.Sync.markDirty(owner)
end

function ACTIONS.ticket(owner)
	for _, other in S.Plots.all() do
		if other ~= owner and other.plot then
			owner.ticket = { targetKey = other.key, targetName = other.name, expires = S.Sync.now() + 300 }
			S.Sync.notify(owner, "Dev: Bounce-Back Ticket for " .. other.name .. "'s tower.", "info")
			S.Sync.markDirty(owner)
			return
		end
	end
end

function ACTIONS.skipTutorial(owner)
	S.Onboarding.skip(owner)
end

function ACTIONS.resetData(owner)
	local fresh = S.Data.default()
	for k in owner.data do
		owner.data[k] = nil
	end
	for k, v in fresh do
		owner.data[k] = v
	end
	S.Stacking.detachHeld(owner)
	if owner.host then
		S.Towers.refresh(owner.host)
	end
	S.Towers.renderCushions(owner)
	S.Towers.renderGround(owner)
	S.Plots.refreshPlot(owner)
	S.Plots.updateLeaderstats(owner)
	S.Sync.markDirty(owner)
	S.Onboarding.onOwnerAdded(owner)
end

function ACTIONS.toppleMe(owner)
	if owner.host and S.Towers.topple(owner.host) then
		S.Sync.effectAll({ kind = "Topple", key = owner.key, plot = owner.plot.index })
	end
end

function Dev.init(services)
	S = services
	Remotes.get("Dev").OnServerEvent:Connect(function(player, action, arg)
		if not RunService:IsStudio() then
			return
		end
		local owner = S.Plots.get(player)
		local fn = type(action) == "string" and ACTIONS[action]
		if owner and fn then
			local ok, err = pcall(fn, owner, arg)
			if not ok then
				warn("[Dev]", action, err)
			end
		end
	end)
end

return Dev
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Earnings</string>
            <string name="Source"><![CDATA[--[[
	Earnings: Giggle Coins every second (design doc 4.1 "Earn").

	Taller towers earn more; nappers earn half; a toppling tower pauses for a
	few seconds. Coins are added automatically - no collecting needed.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Earnings = {}

local S

local function tick()
	for _, owner in S.Plots.all() do
		if owner.player and owner.plot then
			local data = owner.data
			local rate = Economy.totalRate(data, owner.napping)
			if owner.host and owner.host.toppling then
				rate = 0
			end
			data.coins += rate * Config.Economy.TickSeconds
			data.playtime += Config.Economy.TickSeconds
			S.Plots.updateLeaderstats(owner)
			S.Sync.tick(owner, rate)
		end
	end
end

function Earnings.init(services)
	S = services
end

function Earnings.start()
	while true do
		task.wait(Config.Economy.TickSeconds)
		local ok, err = pcall(tick)
		if not ok then
			warn("[Earnings]", err)
		end
	end
end

return Earnings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Map</string>
            <string name="Source"><![CDATA[--[[
	Map: builds Bumbleberry Bay at runtime (design doc 3.1).

	  Sneeze Plaza (center)   the Fluff-O-Matic, shops, Sneaky Pete's practice tower
	  Conveyor belt           Captain Conveyor's belt loops around the plaza
	  Muffin Meadows          sponge-cake hills where wild Stackables bounce
	  8 Base Pads             one per player, around the edge
	  Fizzy Shore             soda-water beach around the island

	Everything is built from simple parts so it can be swapped for real art later.
	Plot / stall / pegs parts are tagged with CollectionService so the client can
	add ProximityPrompts to them.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Map = {}

local M = Config.Map
local UP = CFrame.Angles(0, 0, math.pi / 2)

local PLOT_COLORS = {
	Color3.fromRGB(255, 140, 170),
	Color3.fromRGB(255, 190, 110),
	Color3.fromRGB(255, 230, 110),
	Color3.fromRGB(140, 220, 140),
	Color3.fromRGB(110, 210, 230),
	Color3.fromRGB(130, 160, 255),
	Color3.fromRGB(190, 140, 255),
	Color3.fromRGB(255, 150, 230),
}

-- Part helpers -------------------------------------------------------------------

local function part(parent: Instance, shape: string, size: Vector3, cf: CFrame, color: Color3, props: any?)
	local p = Instance.new("Part")
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function block(parent, size, cf, color, props)
	return part(parent, "Block", size, cf, color, props)
end

local function ball(parent, d, pos, color, props)
	return part(parent, "Ball", Vector3.new(d, d, d), CFrame.new(pos), color, props)
end

local function ellipsoid(parent, size, cf, color, props)
	return part(parent, "Ellipsoid", size, cf, color, props)
end

-- Vertical cylinder centered on cf.
local function vcyl(parent, diameter, height, cf, color, props)
	return part(parent, "Cylinder", Vector3.new(height, diameter, diameter), cf * UP, color, props)
end

local function billboard(adornee: BasePart, title: string, color: Color3, sizeX: number, offsetY: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromScale(sizeX, 1.6)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = title
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(60, 40, 70)
	label.Parent = gui
	gui.Parent = adornee
	return gui
end

local function polar(radius: number, angle: number, y: number): Vector3
	return Vector3.new(radius * math.cos(angle), y, radius * math.sin(angle))
end

-- Faces outward from the plaza center at the given angle.
local function outwardCF(radius: number, angle: number, y: number): CFrame
	local pos = polar(radius, angle, y)
	return CFrame.lookAt(pos, Vector3.new(pos.X * 2, y, pos.Z * 2))
end

-- NPCs -------------------------------------------------------------------------------

local SKIN = Color3.fromRGB(255, 214, 180)
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(30, 25, 35)

local function eyes(parent, head: CFrame, headD: number, color: Color3?)
	for _, side in { -1, 1 } do
		local base = head * CFrame.new(side * headD * 0.18, headD * 0.08, -headD * 0.42)
		ball(parent, headD * 0.24, base.Position, color or WHITE)
		ball(parent, headD * 0.13, (base * CFrame.new(0, 0, -headD * 0.07)).Position, BLACK)
	end
end

local NpcBuilders = {}

function NpcBuilders.Professor(parent, cf)
	ellipsoid(parent, Vector3.new(3.2, 4.2, 2.6), cf * CFrame.new(0, 2.1, 0), WHITE)
	local head = cf * CFrame.new(0, 5, 0)
	ball(parent, 2.6, head.Position, SKIN)
	eyes(parent, head, 2.6)
	for k = -2, 2 do
		ball(parent, 0.9, (head * CFrame.new(k * 0.45, 1.1, 0.2)).Position, Color3.fromRGB(200, 200, 210))
	end
	for _, side in { -1, 1 } do -- goggles on backwards
		vcyl(parent, 0.8, 0.3, head * CFrame.new(side * 0.5, 0.25, 1.25) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(80, 200, 255))
	end
	block(parent, Vector3.new(2.7, 0.25, 0.25), head * CFrame.new(0, 0.25, 1.2), Color3.fromRGB(60, 60, 70))
end

function NpcBuilders.Gloop(parent, cf)
	ellipsoid(parent, Vector3.new(3.4, 4, 2.8), cf * CFrame.new(0, 2, 0), Color3.fromRGB(255, 160, 190))
	block(parent, Vector3.new(2.4, 2.6, 0.2), cf * CFrame.new(0, 2, -1.35), WHITE)
	for k = 1, 4 do
		ball(parent, 0.35, (cf * CFrame.new((k - 2.5) * 0.5, 1.3 + (k % 2) * 0.6, -1.5)).Position, Color3.fromRGB(200, 30, 70))
	end
	local head = cf * CFrame.new(0, 4.8, 0)
	ball(parent, 2.5, head.Position, SKIN)
	eyes(parent, head, 2.5)
	ball(parent, 1.4, (head * CFrame.new(0, 1.3, 0.3)).Position, Color3.fromRGB(220, 220, 230))
end

function NpcBuilders.Captain(parent, cf)
	local brown = Color3.fromRGB(160, 120, 95)
	ellipsoid(parent, Vector3.new(4.4, 4.2, 3.6), cf * CFrame.new(0, 2.1, 0), brown)
	local head = cf * CFrame.new(0, 4.9, -0.2)
	ellipsoid(parent, Vector3.new(3.2, 2.6, 2.8), head, brown)
	eyes(parent, head * CFrame.new(0, 0.3, 0), 2.6)
	ellipsoid(parent, Vector3.new(1.8, 0.9, 0.8), head * CFrame.new(0, -0.5, -1.2), Color3.fromRGB(230, 200, 180))
	for _, side in { -1, 1 } do
		vcyl(parent, 0.3, 1.4, head * CFrame.new(side * 0.4, -1.3, -1.2), WHITE)
	end
	vcyl(parent, 2.4, 0.6, head * CFrame.new(0, 1.4, 0), Color3.fromRGB(30, 50, 110))
	vcyl(parent, 1.8, 0.3, head * CFrame.new(0, 1.85, 0), WHITE)
end

function NpcBuilders.Lou(parent, cf)
	ellipsoid(parent, Vector3.new(2.2, 1.6, 5), cf * CFrame.new(0, 0.8, 0), Color3.fromRGB(170, 220, 140))
	ball(parent, 3.4, (cf * CFrame.new(0, 2.6, 0.9)).Position, Color3.fromRGB(220, 150, 90))
	vcyl(parent, 1.6, 0.25, cf * CFrame.new(1.8, 2.6, 0.9) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(255, 210, 60))
	local head = cf * CFrame.new(0, 2.2, -2)
	ball(parent, 1.8, head.Position, Color3.fromRGB(170, 220, 140))
	for _, side in { -1, 1 } do
		vcyl(parent, 0.2, 1.2, head * CFrame.new(side * 0.4, 1.2, 0), Color3.fromRGB(170, 220, 140))
		ball(parent, 0.5, (head * CFrame.new(side * 0.4, 1.9, -0.1)).Position, WHITE)
		ball(parent, 0.25, (head * CFrame.new(side * 0.4, 1.9, -0.35)).Position, BLACK)
	end
end

function NpcBuilders.Bee(parent, cf)
	local yellow = Color3.fromRGB(255, 215, 60)
	local body = cf * CFrame.new(0, 2.4, 0)
	ellipsoid(parent, Vector3.new(3, 3.6, 3), body, yellow)
	for k = -1, 1 do
		block(parent, Vector3.new(3.05, 0.4, 3.05), body * CFrame.new(0, k * 0.9 - 0.3, 0), BLACK, { Transparency = 0 })
	end
	for _, side in { -1, 1 } do
		ellipsoid(parent, Vector3.new(0.3, 2.2, 1.4), body * CFrame.new(side * 1.6, 0.8, 0.9) * CFrame.Angles(0, 0, side * 0.6), WHITE, { Transparency = 0.4 })
	end
	local head = cf * CFrame.new(0, 5, 0)
	ball(parent, 2.4, head.Position, yellow)
	eyes(parent, head, 2.4)
	ellipsoid(parent, Vector3.new(2.6, 1.3, 2.6), head * CFrame.new(0, 0.8, 0), Color3.fromRGB(255, 150, 40))
end

function NpcBuilders.Pete(parent, cf)
	local grey = Color3.fromRGB(150, 150, 160)
	ellipsoid(parent, Vector3.new(3, 3.8, 2.6), cf * CFrame.new(0, 1.9, 0), Color3.fromRGB(70, 90, 170))
	for k = -1, 1 do
		block(parent, Vector3.new(3.05, 0.35, 2.65), cf * CFrame.new(0, 1.9 + k * 0.8, 0), WHITE)
	end
	local head = cf * CFrame.new(0, 4.7, 0)
	ball(parent, 2.6, head.Position, grey)
	block(parent, Vector3.new(2.4, 0.6, 0.4), head * CFrame.new(0, 0.2, -1.05), BLACK)
	eyes(parent, head, 2.6)
	for _, side in { -1, 1 } do
		part(parent, "Wedge", Vector3.new(0.3, 0.9, 0.8), head * CFrame.new(side * 0.85, 1.2, 0) * CFrame.Angles(0, math.pi / 2, 0), grey)
	end
	-- striped tail
	for k = 0, 3 do
		ball(parent, 0.9, (cf * CFrame.new(0, 1 + k * 0.5, 1.6 + k * 0.4)).Position, k % 2 == 0 and grey or BLACK)
	end
end

function NpcBuilders.Frog(parent, cf)
	local green = Color3.fromRGB(120, 210, 100)
	ellipsoid(parent, Vector3.new(3.4, 3.4, 3), cf * CFrame.new(0, 1.7, 0), green)
	local head = cf * CFrame.new(0, 4, 0)
	ellipsoid(parent, Vector3.new(3, 2, 2.6), head, green)
	for _, side in { -1, 1 } do
		ball(parent, 1.1, (head * CFrame.new(side * 0.8, 1, -0.6)).Position, WHITE)
		ball(parent, 0.55, (head * CFrame.new(side * 0.8, 1, -1.05)).Position, BLACK)
		vcyl(parent, 1.2, 0.5, head * CFrame.new(side * 1.55, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), BLACK)
	end
	block(parent, Vector3.new(3.4, 0.3, 0.4), head * CFrame.new(0, 1.3, 0), BLACK)
end

function NpcBuilders.Mayor(parent, cf)
	vcyl(parent, 3.2, 4.2, cf * CFrame.new(0, 2.1, 0), WHITE)
	local head = cf * CFrame.new(0, 2.6, -1.4)
	eyes(parent, head, 2.4)
	vcyl(parent, 2.2, 0.25, cf * CFrame.new(0, 4.3, 0), BLACK)
	vcyl(parent, 1.6, 1.8, cf * CFrame.new(0, 5.3, 0), BLACK)
	block(parent, Vector3.new(1.65, 0.35, 1.65), cf * CFrame.new(0, 4.6, 0), Color3.fromRGB(220, 50, 80))
	ball(parent, 0.8, (cf * CFrame.new(0, 2.2, -1.65)).Position, Color3.fromRGB(255, 200, 40))
end

local NPCS = {
	{ Id = "Professor", Name = "Professor Puddlewick", Angle = 60, Color = Color3.fromRGB(150, 200, 255), Action = "Index", Prompt = "Open Index", Builder = "Professor" },
	{ Id = "Gloop", Name = "Grandma Gloop", Angle = 110, Color = Color3.fromRGB(255, 140, 170), Action = "Shop:Glue", Prompt = "Sticky Jam", Builder = "Gloop" },
	{ Id = "Bricklebee", Name = "Bricklebee", Angle = 160, Color = Color3.fromRGB(255, 200, 60), Action = "Shop:Base", Prompt = "Base upgrades", Builder = "Bee" },
	{ Id = "Lou", Name = "Lou the Locksmith", Angle = 210, Color = Color3.fromRGB(170, 220, 140), Action = "Shop:Shield", Prompt = "Bubble Shields", Builder = "Lou" },
	{ Id = "Pete", Name = "Sneaky Pete", Angle = 255, Color = Color3.fromRGB(150, 160, 230), Action = "Talk:Pete", Prompt = "Snatch tips", Builder = "Pete" },
	{ Id = "Mayor", Name = "Mayor Marshmallow", Angle = 310, Color = Color3.fromRGB(255, 240, 230), Action = "Talk:Mayor", Prompt = "Ribbons", Builder = "Mayor" },
	{ Id = "DJ", Name = "DJ Bonk", Angle = 25, Color = Color3.fromRGB(120, 210, 100), Action = "Emotes", Prompt = "Emotes", Builder = "Frog" },
}

local function buildStall(parent: Instance, spec)
	local model = Instance.new("Model")
	model.Name = spec.Id
	local angle = math.rad(spec.Angle)
	local front = outwardCF(28, angle, 0)
	-- counter
	local counter = block(model, Vector3.new(8, 3, 2.5), front * CFrame.new(0, 1.5, 0), spec.Color)
	counter.Name = "Counter"
	block(model, Vector3.new(8.4, 0.4, 3), front * CFrame.new(0, 3.2, 0), WHITE)
	-- awning on posts
	for _, side in { -1, 1 } do
		vcyl(model, 0.5, 8, front * CFrame.new(side * 3.8, 4, 2.5), WHITE)
	end
	for k = 0, 5 do
		block(
			model,
			Vector3.new(1.4, 0.4, 5.5),
			front * CFrame.new(-3.5 + k * 1.4, 8.2, 1.5) * CFrame.Angles(math.rad(-12), 0, 0),
			k % 2 == 0 and spec.Color or WHITE
		)
	end
	-- NPC stands behind the counter, facing out
	local npcCF = front * CFrame.new(0, 0, 3)
	NpcBuilders[spec.Builder](model, npcCF)
	billboard(counter, spec.Name, spec.Color, 12, 8.5)

	CollectionService:AddTag(counter, "NpcStall")
	counter:SetAttribute("Npc", spec.Id)
	counter:SetAttribute("NpcName", spec.Name)
	counter:SetAttribute("Action", spec.Action)
	counter:SetAttribute("PromptText", spec.Prompt)
	model.Parent = parent
	return model, front
end

-- Plots ------------------------------------------------------------------------------

local function buildPlot(parent: Instance, index: number)
	local angle = (index - 0.5) * 2 * math.pi / M.PlotCount
	local center = polar(M.PlotRingRadius, angle, 0)
	local color = PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1]
	local platePos = Vector3.new(center.X, M.PlateTopY, center.Z)
	local origin = CFrame.lookAt(platePos, Vector3.new(0, M.PlateTopY, 0)) -- -Z faces the plaza

	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	-- pad, trim and plate
	local pad = vcyl(model, M.PadRadius * 2, 1, CFrame.new(center.X, M.PadTopY - 0.5, center.Z), Color3.fromRGB(170, 230, 140), {
		Material = Enum.Material.Grass,
		Name = "Pad",
	})
	vcyl(model, M.PadRadius * 2 + 2, 0.8, CFrame.new(center.X, M.PadTopY - 0.6, center.Z), color, { Name = "Trim" })
	vcyl(model, M.PlateRadius * 2, 0.6, CFrame.new(center.X, M.PlateTopY - 0.3, center.Z), Color3.fromRGB(255, 250, 240), { Name = "Plate" })
	vcyl(model, M.PlateRadius * 2 + 0.8, 0.4, CFrame.new(center.X, M.PlateTopY - 0.45, center.Z), color, { Name = "PlateRim" })

	-- climbing pegs on the plaza side of the tower (snatchers hop up from here)
	local pegs = block(model, Vector3.new(0.8, 5, 0.8), origin * CFrame.new(0, 1.9, -(M.PlateRadius + 0.8)), color, { Name = "Pegs" })
	for k = 0, 2 do
		vcyl(model, 0.35, 1.4, origin * CFrame.new(0, 0.6 + k * 1.5, -(M.PlateRadius + 0.8)) * CFrame.Angles(math.pi / 2, 0, 0) * UP, WHITE)
	end
	CollectionService:AddTag(pegs, "SnatchPegs")
	pegs:SetAttribute("PlotIndex", index)

	-- the Bubble Shield dome (shown while a shield or protection is up)
	local dome = ellipsoid(model, Vector3.new(M.PlateRadius * 2 + 12, 20, M.PlateRadius * 2 + 12), origin * CFrame.new(0, 6, 0), Color3.fromRGB(170, 230, 255), {
		Name = "Dome",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.Glass,
	})

	-- sign post with name, height and status
	local signCF = origin * CFrame.new(M.PlateRadius + 5, 0, -(M.PadRadius - 4))
	vcyl(model, 0.6, 7, signCF * CFrame.new(0, 3.5, 0), WHITE, { Name = "SignPost" })
	local board = block(model, Vector3.new(5, 2.4, 0.4), signCF * CFrame.new(0, 7, 0), color, { Name = "SignBoard" })
	local sign = Instance.new("BillboardGui")
	sign.Name = "Sign"
	sign.Size = UDim2.fromScale(16, 5)
	sign.StudsOffset = Vector3.new(0, 4.5, 0)
	sign.MaxDistance = 260
	sign.LightInfluence = 0
	sign.Adornee = board
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = sign
	for i, info in { { "Title", 0.42 }, { "Info", 0.3 }, { "Status", 0.28 } } do
		local label = Instance.new("TextLabel")
		label.Name = info[1]
		label.LayoutOrder = i
		label.Size = UDim2.fromScale(1, info[2])
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = i == 1 and WHITE or Color3.fromRGB(255, 245, 200)
		label.TextStrokeTransparency = 0.15
		label.TextStrokeColor3 = Color3.fromRGB(70, 40, 80)
		label.Text = i == 1 and "Empty Base Pad" or ""
		label.Parent = sign
	end
	sign.Parent = board

	-- welcome mat (shows the owner's name)
	local spawnPos = center + (Vector3.new(0, 0, 0) - center).Unit * (M.PlateRadius + 6)
	local mat = block(model, Vector3.new(6, 0.15, 4), CFrame.lookAt(Vector3.new(spawnPos.X, M.PadTopY + 0.08, spawnPos.Z), Vector3.new(center.X, M.PadTopY + 0.08, center.Z)), color, { Name = "WelcomeMat" })
	local matGui = Instance.new("SurfaceGui")
	matGui.Face = Enum.NormalId.Top
	matGui.LightInfluence = 0
	local matLabel = Instance.new("TextLabel")
	matLabel.Name = "Label"
	matLabel.Size = UDim2.fromScale(1, 1)
	matLabel.BackgroundTransparency = 1
	matLabel.Font = Enum.Font.FredokaOne
	matLabel.TextScaled = true
	matLabel.TextColor3 = WHITE
	matLabel.Text = "WELCOME"
	matLabel.Rotation = 180
	matLabel.Parent = matGui
	matGui.Parent = mat

	-- comfy cushion (unsnatchable favorite)
	local cushionLocal = CFrame.new(M.CushionOffset)
	local cushion = ellipsoid(model, Vector3.new(4.5, 1.2, 4.5), origin * cushionLocal * CFrame.new(0, -0.3, 0), Color3.fromRGB(255, 170, 210), { Name = "Cushion" })
	billboard(cushion, "Comfy Cushion", Color3.fromRGB(255, 200, 230), 7, 2.5).MaxDistance = 60

	-- coin jar (decoration)
	local jarCF = origin * CFrame.new(9, 0, 4)
	vcyl(model, 3, 4, jarCF * CFrame.new(0, 1.4, 0), Color3.fromRGB(220, 240, 255), { Transparency = 0.55, Material = Enum.Material.Glass, Name = "Jar" })
	vcyl(model, 2.6, 2, jarCF * CFrame.new(0, 0.4, 0), Color3.fromRGB(255, 205, 60), { Name = "Coins", Material = Enum.Material.Foil })

	local towerFolder = Instance.new("Folder")
	towerFolder.Name = "Tower"
	towerFolder.Parent = model
	local groundFolder = Instance.new("Folder")
	groundFolder.Name = "Ground"
	groundFolder.Parent = model
	local cushionFolder = Instance.new("Folder")
	cushionFolder.Name = "CushionSlot"
	cushionFolder.Parent = model

	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("Height", 0)
	model:SetAttribute("Rate", 0)
	model:SetAttribute("Wobble", 0)
	model:SetAttribute("ShieldUntil", 0)
	model:SetAttribute("Protected", false)
	model:SetAttribute("Status", "")
	model:SetAttribute("Toppling", false)
	model:SetAttribute("BaseYaw", select(2, origin:ToOrientation()))
	model.PrimaryPart = pad
	model.Parent = parent

	return {
		index = index,
		angle = angle,
		color = color,
		center = center,
		origin = origin,
		spawnCF = CFrame.lookAt(spawnPos + Vector3.new(0, M.PadTopY + 3, 0), Vector3.new(center.X, M.PadTopY + 3, center.Z)),
		cushionCF = origin * cushionLocal * CFrame.new(0, 0.3, 0),
		groundCF = origin * CFrame.new(6, M.PadTopY - M.PlateTopY, 6),
		model = model,
		pegs = pegs,
		dome = dome,
		sign = sign,
		matLabel = matLabel,
		towerFolder = towerFolder,
		groundFolder = groundFolder,
		cushionFolder = cushionFolder,
		owner = nil,
	}
end

-- World ------------------------------------------------------------------------------

local function buildLighting()
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 2.6
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(140, 128, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(180, 170, 190)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.3
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.22
		atmosphere.Haze = 0.6
		atmosphere.Color = Color3.fromRGB(255, 220, 240)
		atmosphere.Decay = Color3.fromRGB(190, 220, 255)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChild("SillyColor") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "SillyColor"
		cc.Saturation = 0.15
		cc.Brightness = 0.02
		cc.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		Instance.new("Sky").Parent = Lighting
	end
end

local function buildIsland(map: Instance)
	-- island, beach and fizzy soda sea
	vcyl(map, M.IslandRadius * 2, 6, CFrame.new(0, -3, 0), Color3.fromRGB(160, 225, 130), { Material = Enum.Material.Grass, Name = "Island" })
	vcyl(map, M.IslandRadius * 2 + 40, 6, CFrame.new(0, -3.4, 0), Color3.fromRGB(255, 230, 180), { Material = Enum.Material.Sand, Name = "FizzyShore" })
	block(map, Vector3.new(1400, 1, 1400), CFrame.new(0, -6.5, 0), Color3.fromRGB(240, 220, 170), { Material = Enum.Material.Sand, Name = "SeaFloor" })
	block(map, Vector3.new(1400, 3, 1400), CFrame.new(0, -3, 0), Color3.fromRGB(120, 220, 230), {
		Name = "SodaSea",
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Material = Enum.Material.Glass,
	})
	-- invisible fence far out in the soda so nobody wanders off forever
	local fenceRadius = M.IslandRadius + 70
	for k = 0, 31 do
		local a = k / 32 * 2 * math.pi
		block(map, Vector3.new(fenceRadius * 2 * math.pi / 32 + 4, 80, 4), CFrame.lookAt(polar(fenceRadius, a, 30), Vector3.new(0, 30, 0)), WHITE, {
			Transparency = 1,
			Name = "Fence",
		})
	end
	-- bubbles fizzing up from the soda
	local fizz = block(map, Vector3.new(500, 1, 500), CFrame.new(0, -2, 0), WHITE, { Transparency = 1, CanCollide = false, CanQuery = false, Name = "Fizz" })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 40
	emitter.Lifetime = NumberRange.new(2, 4)
	emitter.Speed = NumberRange.new(3, 6)
	emitter.Size = NumberSequence.new(0.6)
	emitter.Transparency = NumberSequence.new(0.3)
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 255, 255))
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = fizz
end

local function buildPlaza(map: Instance)
	vcyl(map, M.PlazaRadius * 2, 0.4, CFrame.new(0, 0, 0), Color3.fromRGB(255, 225, 235), { Name = "Plaza" })
	for k = 0, 11 do
		local a = k / 12 * 2 * math.pi
		vcyl(map, 5, 0.42, CFrame.new(polar(M.PlazaRadius - 6, a, 0)), Color3.fromRGB(255, 200, 220), { Name = "PlazaTile" })
	end

	-- Fluff-O-Matic 3000
	local machine = Instance.new("Model")
	machine.Name = "FluffOMatic"
	vcyl(machine, 16, 6, CFrame.new(0, 3.2, 0), Color3.fromRGB(255, 170, 200))
	ellipsoid(machine, Vector3.new(15, 11, 15), CFrame.new(0, 9, 0), Color3.fromRGB(200, 170, 255))
	local chimney = vcyl(machine, 3.4, 8, CFrame.new(-2, 17, 2), Color3.fromRGB(150, 150, 190))
	chimney.Name = "Chimney"
	ellipsoid(machine, Vector3.new(6, 2, 4), CFrame.new(-2, 21.5, 2), WHITE)
	for k = 0, 5 do
		local a = k / 6 * 2 * math.pi
		ball(machine, 1.6, polar(7.6, a, 6.2), Color3.fromRGB(255, 230, 120))
	end
	vcyl(machine, 0.5, 4, CFrame.new(-7.5, 8, -3) * CFrame.Angles(0, 0, 0.4), Color3.fromRGB(80, 80, 90))
	ball(machine, 1.4, Vector3.new(-8.4, 10, -3), Color3.fromRGB(240, 60, 80))
	-- chute down to the belt start (+X)
	local chuteLen = Config.Conveyor.Radius - 8
	local chute = block(machine, Vector3.new(chuteLen, 0.6, 5), CFrame.new(8 + chuteLen / 2, 3.6, 0) * CFrame.Angles(0, 0, math.atan2(-5, chuteLen)), Color3.fromRGB(255, 240, 180), { CanCollide = false })
	chute.Name = "Chute"
	local smoke = Instance.new("ParticleEmitter")
	smoke.Rate = 2.5
	smoke.Lifetime = NumberRange.new(3, 5)
	smoke.Speed = NumberRange.new(3, 5)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 220, 240), Color3.fromRGB(220, 230, 255))
	smoke.EmissionDirection = Enum.NormalId.Right -- cylinder X axis points up
	smoke.Parent = chimney
	local sneeze = smoke:Clone()
	sneeze.Name = "SneezePuff"
	sneeze.Rate = 0
	sneeze.Speed = NumberRange.new(8, 14)
	sneeze.SpreadAngle = Vector2.new(40, 40)
	sneeze.Parent = chimney
	billboard(chimney, "FLUFF-O-MATIC 3000", Color3.fromRGB(255, 200, 240), 20, 9)
	machine.Parent = map
	Map.chimney = chimney

	-- Captain Conveyor's podium at the belt start
	local podiumCF = outwardCF(38, math.rad(-22), 0)
	local captain = Instance.new("Model")
	captain.Name = "Captain"
	local podium = vcyl(captain, 5, 1.5, podiumCF * CFrame.new(0, 0.75, 0), Color3.fromRGB(80, 120, 200))
	NpcBuilders.Captain(captain, podiumCF * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, math.rad(-60), 0))
	billboard(podium, "Captain Conveyor", Color3.fromRGB(140, 190, 255), 12, 9)
	CollectionService:AddTag(podium, "NpcStall")
	podium:SetAttribute("Npc", "Captain")
	podium:SetAttribute("NpcName", "Captain Conveyor")
	podium:SetAttribute("Action", "Talk:Captain")
	podium:SetAttribute("PromptText", "Ahoy!")
	captain.Parent = map

	local stalls = Instance.new("Folder")
	stalls.Name = "Stalls"
	stalls.Parent = map
	Map.stalls = {}
	for _, spec in NPCS do
		local _, front = buildStall(stalls, spec)
		Map.stalls[spec.Id] = front
	end

	-- Mayor Marshmallow's leaderboard board
	local mayorFront = Map.stalls.Mayor
	local board = block(map, Vector3.new(9, 6, 0.5), mayorFront * CFrame.new(7.5, 5, 1) * CFrame.Angles(0, math.rad(-20), 0), Color3.fromRGB(255, 245, 235), { Name = "TallestBoard" })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.CanvasSize = Vector2.new(360, 240)
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Size = UDim2.fromScale(1, 1)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.FredokaOne
	list.TextScaled = true
	list.TextColor3 = Color3.fromRGB(110, 60, 120)
	list.Text = "Tallest Towers"
	list.Parent = gui
	gui.Parent = board
	Map.tallestLabel = list

	-- spawn fallback (players are moved to their base pad right away)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.CFrame = CFrame.new(0, 0.3, -16)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = map
end

local function buildConveyor(map: Instance)
	local C = Config.Conveyor
	local belt = Instance.new("Model")
	belt.Name = "Belt"
	local segments = 72
	local segLen = 2 * math.pi * C.Radius / segments + 0.35
	for k = 0, segments - 1 do
		local a = (k + 0.5) / segments * 2 * math.pi
		local cf = CFrame.lookAt(polar(C.Radius, a, C.BeltTopY - 0.25), polar(C.Radius, a, C.BeltTopY - 0.25) + Vector3.new(-math.sin(a), 0, math.cos(a)))
		block(belt, Vector3.new(6, 0.5, segLen), cf, k % 2 == 0 and Color3.fromRGB(90, 90, 120) or Color3.fromRGB(105, 105, 140), { Name = "Belt" })
		for _, side in { -1, 1 } do
			block(belt, Vector3.new(0.4, 0.25, segLen), cf * CFrame.new(side * 3.1, 0.35, 0), Color3.fromRGB(255, 215, 80), { Name = "Rail" })
		end
	end
	belt.Parent = map
end

local function buildMeadows(map: Instance)
	local meadow = Instance.new("Model")
	meadow.Name = "MuffinMeadows"
	local rng = Random.new(2026)
	local plotAngles = {}
	for i = 1, M.PlotCount do
		plotAngles[i] = (i - 0.5) * 2 * math.pi / M.PlotCount
	end
	local function nearPath(a: number): boolean
		for _, pa in plotAngles do
			local d = math.abs((a - pa + math.pi) % (2 * math.pi) - math.pi)
			if d < math.rad(10) then
				return true
			end
		end
		return false
	end
	local cake = { Color3.fromRGB(255, 225, 150), Color3.fromRGB(255, 210, 170), Color3.fromRGB(250, 235, 190) }
	local placed = 0
	local tries = 0
	while placed < 18 and tries < 400 do
		tries += 1
		local a = rng:NextNumber(0, 2 * math.pi)
		local r = rng:NextNumber(M.MeadowInner + 8, M.MeadowOuter - 6)
		if not nearPath(a) then
			local d = rng:NextNumber(14, 24)
			local hill = ball(meadow, d, polar(r, a, -d / 2 + rng:NextNumber(2.2, 3.6)), cake[rng:NextInteger(1, #cake)], { Name = "Hill" })
			hill.Material = Enum.Material.Sand
			placed += 1
		end
	end
	-- lollipop trees
	local candy = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 200, 80), Color3.fromRGB(170, 120, 255) }
	for k = 1, 12 do
		local a = rng:NextNumber(0, 2 * math.pi)
		if not nearPath(a) then
			local r = rng:NextNumber(M.MeadowInner + 2, M.IslandRadius - 12)
			if r < M.MeadowOuter or r > M.PlotRingRadius + M.PadRadius + 8 then
				local base = polar(r, a, 0)
				vcyl(meadow, 0.6, 9, CFrame.new(base + Vector3.new(0, 4.5, 0)), WHITE, { Name = "Stick" })
				vcyl(meadow, 5, 1, CFrame.new(base + Vector3.new(0, 10, 0)) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), candy[k % #candy + 1], { Name = "Lollipop" })
			end
		end
	end
	-- marshmallow clouds
	for _ = 1, 14 do
		local center = polar(rng:NextNumber(40, 260), rng:NextNumber(0, 2 * math.pi), rng:NextNumber(90, 150))
		for _ = 1, 4 do
			ball(meadow, rng:NextNumber(12, 22), center + Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-3, 3), rng:NextNumber(-12, 12)), WHITE, {
				CanCollide = false,
				CanQuery = false,
				CastShadow = false,
				Name = "Cloud",
			})
		end
	end
	-- sign
	local signPole = vcyl(meadow, 0.6, 6, CFrame.new(polar(M.MeadowInner + 2, math.rad(0), 3)), WHITE)
	billboard(signPole, "Muffin Meadows", Color3.fromRGB(255, 220, 140), 14, 4)
	meadow.Parent = map
end

local function buildPaths(map: Instance)
	for i = 1, M.PlotCount do
		local a = (i - 0.5) * 2 * math.pi / M.PlotCount
		local inner, outer = M.PlazaRadius - 1, M.PlotRingRadius - M.PadRadius + 1
		local mid = (inner + outer) / 2
		local pos = polar(mid, a, 0.1)
		block(map, Vector3.new(9, 0.2, outer - inner), CFrame.lookAt(pos, Vector3.new(0, 0.1, 0)), Color3.fromRGB(255, 244, 220), { Name = "Path" })
	end
end

local function buildPractice(map: Instance)
	-- Sneaky Pete's practice tower, right in front of his stall
	local angle = math.rad(255 + 13)
	local pos = polar(35, angle, 0)
	local origin = CFrame.lookAt(Vector3.new(pos.X, M.PlateTopY, pos.Z), Vector3.new(0, M.PlateTopY, 0))
	local model = Instance.new("Model")
	model.Name = "PracticeTower"
	vcyl(model, 9, 0.6, CFrame.new(pos.X, M.PlateTopY - 0.3, pos.Z), Color3.fromRGB(200, 210, 255), { Name = "Plate" })
	vcyl(model, 9.8, 1.2, CFrame.new(pos.X, M.PlateTopY - 1, pos.Z), Color3.fromRGB(70, 90, 170), { Name = "Base" })
	local pegs = block(model, Vector3.new(0.8, 4, 0.8), origin * CFrame.new(0, 1.4, -5.3), Color3.fromRGB(150, 160, 230), { Name = "Pegs" })
	CollectionService:AddTag(pegs, "SnatchPegs")
	pegs:SetAttribute("PlotIndex", 0)
	pegs:SetAttribute("Practice", true)
	billboard(pegs, "Practice Tower", Color3.fromRGB(190, 200, 255), 10, 14)
	local folder = Instance.new("Folder")
	folder.Name = "Tower"
	folder.Parent = model
	model:SetAttribute("Practice", true)
	model:SetAttribute("Wobble", 0.25)
	model:SetAttribute("Toppling", false)
	model:SetAttribute("BaseYaw", select(2, origin:ToOrientation()))
	model.Parent = map
	Map.practice = {
		origin = origin,
		folder = folder,
		model = model,
		pegs = pegs,
	}
end

-- Public -------------------------------------------------------------------------------

function Map.init()
	buildLighting()

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	Map.folder = map

	buildIsland(map)
	buildPlaza(map)
	buildConveyor(map)
	buildMeadows(map)
	buildPaths(map)
	buildPractice(map)

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace
	Map.plots = {}
	for i = 1, M.PlotCount do
		Map.plots[i] = buildPlot(plotsFolder, i)
	end

	for _, name in { "Conveyor", "Wild", "Effects" } do
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = workspace
		Map[name] = folder
	end
end

-- Where to stand when hopping to the top of a tower (beside the top creature).
function Map.snatchStandCF(origin: CFrame, topHeight: number): CFrame
	local pos = (origin * CFrame.new(0, topHeight + 3, -4.2)).Position
	local look = (origin * CFrame.new(0, topHeight + 3, 0)).Position
	return CFrame.lookAt(pos, look)
end

-- Where a snatcher lands after hopping back down.
function Map.snatchLandCF(origin: CFrame): CFrame
	local pos = (origin * CFrame.new(0, 2.5, -(M.PlateRadius + 4))).Position
	return CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
end

-- Raycast down onto the island (ignores players and creatures).
function Map.groundAt(x: number, z: number): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Map.folder }
	local result = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -120, 0), params)
	if result and result.Instance.Name ~= "SodaSea" then
		return result.Position.Y
	end
	return 0
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Meadows</string>
            <string name="Source"><![CDATA[--[[
	Meadows: wild Stackables bounce around Muffin Meadows. They're free, but you
	have to scoop them gently: a quick timing tap (stop the marker in the green).
	Rarer creatures have a smaller green zone and a faster marker.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureModel = require(Shared.CreatureModel)
local Creatures = require(Shared.Creatures)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Util = require(script.Parent.Parent.Util)

local Meadows = {}

local S
local MW = Config.Meadows
local M = Config.Map
local rng = Random.new()
local wild = {} -- [uid] = { uid, id, m, pos, model, lockedBy, lockUntil }
local count = 0
local scoopStart

local function randomSpot(): Vector3
	local a = rng:NextNumber(0, 2 * math.pi)
	local r = rng:NextNumber(M.MeadowInner + 3, M.MeadowOuter - 3)
	local x, z = r * math.cos(a), r * math.sin(a)
	return Vector3.new(x, S.Map.groundAt(x, z), z)
end

local function label(model: Model, def)
	local rarity = Rarities.get(def.Rarity)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(8, 1.8)
	gui.StudsOffset = Vector3.new(0, def.Height + 1.8, 0)
	gui.MaxDistance = rarity.Tier >= 3 and 140 or 60
	gui.LightInfluence = 0
	gui.Adornee = model.PrimaryPart
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.Text = "Wild " .. def.Name .. "\n" .. rarity.Badge .. " " .. rarity.Name
	text.TextColor3 = rarity.Color
	text.TextStrokeTransparency = 0.1
	text.TextStrokeColor3 = Color3.fromRGB(50, 30, 60)
	text.Parent = gui
	gui.Parent = model
end

local function place(w)
	w.pos = randomSpot()
	w.model:PivotTo(CFrame.new(w.pos) * CFrame.Angles(0, rng:NextNumber(0, 2 * math.pi), 0))
	w.model:SetAttribute("BasePos", w.pos)
end

function Meadows.spawn(forcedId: string?)
	local def = forcedId and Creatures.ById[forcedId]
	if not def then
		def = Creatures.randomOfRarity(Rarities.roll(MW.Weights, rng), rng)
	end
	local model = CreatureModel.build(def.Id, nil)
	if not model then
		return
	end
	local uid = Util.uid()
	model.Name = uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("Rarity", def.Rarity)
	label(model, def)
	local w = { uid = uid, id = def.Id, model = model }
	place(w)
	model.Parent = S.Map.Wild
	wild[uid] = w
	count += 1
	if Rarities.tier(def.Rarity) >= Rarities.tier("Epic") then
		S.Sync.notifyAll("A wild " .. def.Name .. " is bouncing around Muffin Meadows!", "rare", "Professor Puddlewick")
	end
end

local function removeWild(uid: string)
	local w = wild[uid]
	if w then
		wild[uid] = nil
		count -= 1
		w.model:Destroy()
	end
end

function Meadows.requestScoop(owner, uid: any)
	if type(uid) ~= "string" then
		return
	end
	local w = wild[uid]
	if not w then
		return
	end
	local now = Util.now()
	if owner.session then
		return
	end
	if not S.Stacking.handsFree(owner) then
		S.Sync.notify(owner, "Your hands are full! Stack or Box what you're holding first.", "info")
		return
	end
	if (owner.scoopCooldownUntil or 0) > now then
		S.Sync.notify(owner, "Catch your breath for a second!", "info")
		return
	end
	if w.lockedBy and w.lockedBy ~= owner.key and (w.lockUntil or 0) > now then
		S.Sync.notify(owner, "Someone else is already scooping that one!", "info")
		return
	end
	local _, hrp = Util.character(owner.player)
	if not hrp or Util.flatDistance(hrp.Position, w.pos) > MW.ScoopDistance + 6 then
		return
	end
	local def = Creatures.ById[w.id]
	local session = {
		kind = "scoop",
		id = Util.uid(),
		uid = uid,
		start = now,
		zone = MW.ZoneByRarity[def.Rarity] or 0.2,
	}
	owner.session = session
	w.lockedBy = owner.key
	w.lockUntil = now + 10
	S.Protection.markActive(owner)
	scoopStart:FireClient(owner.player, session.id, {
		zone = session.zone,
		speed = MW.MarkerSpeedByRarity[def.Rarity] or 1,
		creatureId = w.id,
	})
end

function Meadows.scoopResult(owner, sessionId: any, marker: any)
	local session = owner.session
	if not session or session.kind ~= "scoop" or session.id ~= sessionId then
		return
	end
	owner.session = nil
	local w = wild[session.uid]
	if not w then
		return
	end
	w.lockedBy = nil
	local elapsed = Util.now() - session.start
	local success = type(marker) == "number" and marker == marker and elapsed >= 0.25 and math.abs(marker - 0.5) <= session.zone / 2
	local def = Creatures.ById[w.id]
	if success then
		local entry = S.Stacking.newEntry(w.id, nil)
		if S.Stacking.give(owner, entry, "meadow") then
			owner.data.stats.scooped += 1
			removeWild(session.uid)
			S.Sync.notify(owner, "Gently does it! You scooped a " .. def.Name .. "!", "good", "Professor Puddlewick")
			S.Sync.effectAll({ kind = "Scoop", userId = owner.userId, ok = true })
		end
	else
		owner.scoopCooldownUntil = Util.now() + MW.FailCooldown
		place(w)
		S.Sync.notify(owner, "Boing! The " .. def.Name .. " bounced away!", "warn")
		S.Sync.effectAll({ kind = "Scoop", userId = owner.userId, ok = false })
	end
end

function Meadows.onOwnerRemoving(owner)
	for _, w in wild do
		if w.lockedBy == owner.key then
			w.lockedBy = nil
		end
	end
	owner.session = nil
end

function Meadows.init(services)
	S = services
	scoopStart = Remotes.get("ScoopStart")
	Remotes.get("RequestScoop").OnServerEvent:Connect(function(player, uid)
		local owner = S.Plots.get(player)
		if owner then
			Meadows.requestScoop(owner, uid)
		end
	end)
	Remotes.get("ScoopResult").OnServerEvent:Connect(function(player, sessionId, marker)
		local owner = S.Plots.get(player)
		if owner then
			Meadows.scoopResult(owner, sessionId, marker)
		end
	end)
end

function Meadows.start()
	for _ = 1, MW.MaxWild do
		pcall(Meadows.spawn)
	end
	while true do
		task.wait(MW.RespawnInterval)
		if count < MW.MaxWild then
			local ok, err = pcall(Meadows.spawn)
			if not ok then
				warn("[Meadows]", err)
			end
		end
		-- clear scoop sessions nobody finished
		local now = Util.now()
		for _, owner in S.Plots.all() do
			local session = owner.session
			if session and session.kind == "scoop" and now - session.start > 15 then
				owner.session = nil
			end
		end
	end
end

return Meadows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Onboarding</string>
            <string name="Source"><![CDATA[--[[
	Onboarding: the first 3 minutes (design doc 4.8). Fast, funny, hands-on.

	  1  Professor: free Pancake Pup -> pop it on your plate
	  2  Professor: coins for two more -> buy from Captain Conveyor, reach 3 tall
	  3  Sneaky Pete: try the practice tower -> then he topples it on purpose
	  4  Lou: first Bubble Shield upgrade is free -> tap the shield
	  99 done: starter quests open up

	New Stacker Protection is on the whole time, so nobody can snatch from you.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Onboarding = {}

local S
local DONE = 99

local STEPS = {
	[1] = {
		npc = "Professor Puddlewick",
		text = "Oh dear, oh my, oh science! The Fluff-O-Matic sneezed! Here, catch this Pancake Pup! Now stand on your base pad and tap DROP when it's centered over your plate.",
		arrow = "plate",
	},
	[2] = {
		npc = "Professor Puddlewick",
		text = "See? Happy Stackables make Giggle Coins! Here are some coins - grab two more from Captain Conveyor's belt and stack them. Taller tower = more coins!",
		arrow = "conveyor",
	},
	[3] = {
		npc = "Sneaky Pete",
		text = "Psst! Want to learn the Snatch? Try my practice tower in the plaza. Hold, pull gently, and keep the dot in the ring!",
		arrow = "practice",
	},
	[4] = {
		npc = "Lou the Locksmith",
		text = "Tap the Bubble Shield... to keep your tower... safe. ...First upgrade's on me.",
		arrow = "shield",
	},
}

local function send(owner)
	local step = owner.data.tutorial
	local info = STEPS[step]
	if not info then
		return
	end
	local progress = nil
	if step == 2 then
		progress = string.format("Tower: %d / 3 tall", #owner.data.tower)
	end
	S.Sync.dialog(owner, {
		step = step,
		npc = info.npc,
		text = info.text,
		arrow = info.arrow,
		progress = progress,
		canSkip = true,
	})
end

local function setStep(owner, step: number)
	owner.data.tutorial = step
	S.Sync.markDirty(owner)
	if step == DONE then
		local lines = {}
		for _, q in Config.Quests do
			table.insert(lines, "• " .. q.Text)
		end
		S.Sync.dialog(owner, {
			step = DONE,
			npc = "Mayor Marshmallow",
			text = "By the power of fluff, I declare you a Stacker! Try these starter quests:\n" .. table.concat(lines, "\n"),
			final = true,
		})
	else
		send(owner)
	end
end

local function givePup(owner)
	local data = owner.data
	if #data.tower == 0 and not data.held and #data.box == 0 then
		S.Stacking.give(owner, S.Stacking.newEntry("PancakePup", nil), "gift")
	end
end

function Onboarding.onOwnerAdded(owner)
	if owner.isBot then
		return
	end
	local data = owner.data
	if data.tutorial >= DONE then
		return
	end
	if data.tutorial < 1 then
		data.tutorial = 1
	end
	task.delay(1.5, function()
		if S.Plots.byKey[owner.key] ~= owner then
			return
		end
		if data.tutorial == 1 then
			givePup(owner)
		end
		send(owner)
	end)
end

function Onboarding.resend(owner)
	if owner.data.tutorial > 0 and owner.data.tutorial < DONE then
		send(owner)
	end
end

function Onboarding.onPlaced(owner)
	local data = owner.data
	if data.tutorial == 1 and #data.tower >= 1 then
		data.coins += Config.Economy.TutorialCoinGift
		setStep(owner, 2)
	elseif data.tutorial == 2 then
		if #data.tower >= 3 then
			setStep(owner, 3)
		else
			send(owner)
		end
	end
end

function Onboarding.onBought(owner)
	if owner.data.tutorial == 2 then
		S.Sync.notify(owner, "Now carry it home and DROP it on your tower!", "info", "Professor Puddlewick")
	end
end

function Onboarding.onPracticeSnatch(owner, success: boolean)
	if owner.data.tutorial ~= 3 then
		return
	end
	if success then
		task.delay(1.5, function()
			S.Practice.demoTopple()
			S.Sync.notify(owner, "Whoops! See? They all hop home. No harm done! Getting snatched is part of the game.", "info", "Sneaky Pete")
		end)
	end
	task.delay(3.5, function()
		if owner.data.tutorial ~= 3 then
			return
		end
		if owner.data.upgrades.Shield < 2 then
			owner.data.upgrades.Shield = 2
		end
		setStep(owner, 4)
	end)
end

function Onboarding.onShield(owner)
	if owner.data.tutorial == 4 then
		setStep(owner, DONE)
	end
end

function Onboarding.skip(owner)
	local data = owner.data
	if data.tutorial >= DONE then
		return
	end
	if data.tutorial <= 1 then
		givePup(owner)
		data.coins += Config.Economy.TutorialCoinGift
	end
	setStep(owner, DONE)
end

function Onboarding.init(services)
	S = services
	Remotes.get("Tutorial").OnServerEvent:Connect(function(player, action)
		local owner = S.Plots.get(player)
		if not owner then
			return
		end
		if action == "skip" then
			Onboarding.skip(owner)
		end
	end)
end

return Onboarding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[--[[
	Plots: who owns which base pad, and the join / leave flow.

	An "owner" is the runtime record for whoever is using a base pad: a real
	player, or (in Studio) a test bot. It holds the saved `data` plus session-only
	state like shield timers. Other services receive owners, never raw players.

	When you leave, your tower goes home with you (offline is fully safe).
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Wobble = require(Shared.Wobble)
local Util = require(script.Parent.Parent.Util)

local Plots = {}

local S -- services table
Plots.byPlayer = {} -- [Player] = owner
Plots.byKey = {} -- [key] = owner
local loading = {} -- players whose data is still loading
local saving = {} -- [player] = true while the leave-save is running

local function newOwner(params)
	return {
		key = params.key,
		player = params.player,
		isBot = params.isBot or false,
		userId = params.userId,
		name = params.name,
		data = params.data,
		canSave = params.canSave or false,
		plot = nil,
		host = nil,
		-- session-only state
		joinTime = Util.now(),
		moved = false,
		joinPos = nil,
		lastPos = nil,
		lastActive = Util.now(),
		napping = false,
		shieldUntil = 0,
		shieldReadyAt = 0,
		ruffledUntil = 0,
		ticket = nil, -- Bounce-Back Ticket { targetKey, targetName, expires }
		carry = nil, -- creature this player is carrying away from someone's tower
		session = nil, -- active snatch / scoop minigame
		stunnedUntil = 0,
		friends = {},
		devNoProtection = false,
		heldModel = nil,
		lastHeight = 0,
	}
end

function Plots.get(player: Player)
	return Plots.byPlayer[player]
end

function Plots.all()
	return Plots.byKey
end

function Plots.ownerOfPlot(index: number)
	local plot = S.Map.plots[index]
	return plot and plot.owner
end

local function freePlot()
	for _, plot in S.Map.plots do
		if not plot.owner then
			return plot
		end
	end
	return nil
end

-- Is this owner's character standing on their own base pad?
function Plots.onOwnPad(owner, slack: number?): boolean
	if not owner.plot then
		return false
	end
	local _, hrp = Util.character(owner.player)
	if not hrp then
		return false
	end
	local dist = Util.flatDistance(hrp.Position, owner.plot.center)
	return dist <= Config.Map.PadRadius + (slack or 2) and hrp.Position.Y < Config.Map.PadTopY + 14
end

-- Refresh the attributes + sign that everyone sees for this plot.
function Plots.refreshPlot(owner)
	local plot = owner.plot
	if not plot then
		return
	end
	local data = owner.data
	local height = #data.tower
	local model = plot.model
	model:SetAttribute("Height", height)
	model:SetAttribute("Rate", Economy.totalRate(data, owner.napping))
	model:SetAttribute("Wobble", Wobble.ratio(data.tower, Economy.glueReduce(data)))
	model:SetAttribute("Glue", data.upgrades.Glue)
	local status, protected = S.Protection.statusText(owner)
	model:SetAttribute("Status", status)
	model:SetAttribute("Protected", protected)
	model:SetAttribute("ShieldUntil", owner.shieldUntil)

	local sign = plot.sign
	sign.Title.Text = owner.name .. "'s Tower"
	local ribbons = ""
	for _, h in Config.RibbonHeights do
		if data.ribbons[tostring(h)] then
			ribbons ..= "🎀"
		end
	end
	sign.Info.Text = string.format("%d tall · %s/s %s", height, Format.number(model:GetAttribute("Rate")), ribbons)
	sign.Status.Text = status
end

local function clearPlot(plot)
	plot.owner = nil
	local model = plot.model
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("Height", 0)
	model:SetAttribute("Rate", 0)
	model:SetAttribute("Wobble", 0)
	model:SetAttribute("ShieldUntil", 0)
	model:SetAttribute("Protected", false)
	model:SetAttribute("Status", "")
	model:SetAttribute("Toppling", false)
	plot.sign.Title.Text = "Empty Base Pad"
	plot.sign.Info.Text = ""
	plot.sign.Status.Text = ""
	plot.matLabel.Text = "WELCOME"
	plot.dome.Transparency = 1
	plot.towerFolder:ClearAllChildren()
	plot.groundFolder:ClearAllChildren()
	plot.cushionFolder:ClearAllChildren()
end

local function assignPlot(owner, plot)
	owner.plot = plot
	plot.owner = owner
	plot.model:SetAttribute("OwnerUserId", owner.userId)
	plot.model:SetAttribute("OwnerName", owner.name)
	plot.matLabel.Text = "WELCOME, " .. string.upper(owner.name) .. "!"
	owner.host = S.Towers.newHost({
		key = owner.key,
		origin = plot.origin,
		folder = plot.towerFolder,
		attributeTarget = plot.model,
		getEntries = function()
			return owner.data.tower
		end,
		getGlue = function()
			return Economy.glueReduce(owner.data)
		end,
	})
	S.Towers.refresh(owner.host)
	S.Towers.renderCushions(owner)
	S.Towers.renderGround(owner)
	Plots.refreshPlot(owner)
end

local function setupLeaderstats(owner)
	local player = owner.player
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local height = Instance.new("IntValue")
	height.Name = "Height"
	height.Value = #owner.data.tower
	height.Parent = stats
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Value = Format.number(owner.data.coins)
	coins.Parent = stats
	stats.Parent = player
end

function Plots.updateLeaderstats(owner)
	if not owner.player then
		return
	end
	local stats = owner.player:FindFirstChild("leaderstats")
	if stats then
		stats.Height.Value = #owner.data.tower
		stats.Coins.Value = Format.number(owner.data.coins)
	end
end

-- Move a character to its base pad.
function Plots.sendHome(owner)
	if not owner.plot then
		return
	end
	local character, hrp = Util.character(owner.player)
	if character and hrp then
		character:PivotTo(owner.plot.spawnCF)
	end
end

local function onCharacterAdded(owner, character: Model)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not hrp or not humanoid or Plots.byKey[owner.key] ~= owner then
		return
	end
	task.defer(function()
		if owner.plot and character.Parent then
			character:PivotTo(owner.plot.spawnCF)
		end
		owner.joinPos = owner.joinPos or owner.plot and owner.plot.spawnCF.Position
		S.Stacking.attachHeld(owner)
	end)
	humanoid.Died:Connect(function()
		S.Snatch.onCarrierLost(owner, "fell over")
	end)
end

local function returnTransit(owner)
	-- Creatures that were being carried away when we last left come home to the box.
	local data = owner.data
	if #data.transit > 0 then
		for _, entry in data.transit do
			table.insert(data.box, { u = entry.u, id = entry.id, m = entry.m })
		end
		data.transit = {}
		return true
	end
	return false
end

local function offlineEarnings(owner)
	local data = owner.data
	if data.lastOnline and data.lastOnline > 0 then
		local away = math.min(os.time() - data.lastOnline, Config.Economy.OfflineMaxSeconds)
		if away > 60 then
			local earned = math.floor(Economy.totalRate(data) * Config.Economy.OfflineIncomeMultiplier * away)
			if earned > 0 then
				data.coins += earned
				return earned
			end
		end
	end
	return 0
end

local function onPlayerAdded(player: Player)
	if loading[player] or Plots.byPlayer[player] then
		return
	end
	loading[player] = true
	local data, canSave = S.Data.load(player)
	loading[player] = nil
	if not player.Parent then
		if canSave then
			S.Data.save(player, data, true)
		end
		return
	end

	local owner = newOwner({
		key = "u" .. player.UserId,
		player = player,
		userId = player.UserId,
		name = player.DisplayName,
		data = data,
		canSave = canSave,
	})
	local cameHome = returnTransit(owner)
	local earned = offlineEarnings(owner)

	Plots.byPlayer[player] = owner
	Plots.byKey[owner.key] = owner
	setupLeaderstats(owner)

	local plot = freePlot()
	if plot then
		assignPlot(owner, plot)
	end

	S.Protection.onOwnerAdded(owner)
	S.Social.onOwnerAdded(owner)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(owner, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, owner, player.Character)
	end

	S.Sync.markDirty(owner)
	S.Onboarding.onOwnerAdded(owner)

	task.delay(2, function()
		if not plot then
			S.Sync.notify(owner, "All 8 base pads are taken! Try another server.", "warn")
		end
		if earned > 0 then
			S.Sync.notify(owner, "You earned " .. Format.number(earned) .. " Giggle Coins while dreaming!", "good", "Professor Puddlewick")
		end
		if cameHome then
			S.Sync.notify(owner, "Your snatched creatures hopped home to your Box!", "good", "Sneaky Pete")
		end
		if not owner.canSave then
			S.Sync.notify(owner, "Progress isn't saving this session (Studio test without API access).", "warn")
		end
	end)
end

-- Remove an owner (player leaving, or a bot being cleared).
function Plots.removeOwner(owner)
	if Plots.byKey[owner.key] ~= owner then
		return
	end
	S.Snatch.onOwnerRemoving(owner)
	S.Meadows.onOwnerRemoving(owner)
	Plots.byKey[owner.key] = nil
	if owner.player then
		Plots.byPlayer[owner.player] = nil
	end
	local freed = owner.plot
	if owner.plot then
		clearPlot(owner.plot)
		owner.plot = nil
	end
	if owner.host then
		S.Towers.destroyHost(owner.host)
		owner.host = nil
	end
	-- Hand the free pad to someone who joined while every pad was taken.
	if freed then
		for _, waiting in Plots.byKey do
			if waiting.player and not waiting.plot then
				assignPlot(waiting, freed)
				Plots.sendHome(waiting)
				S.Sync.markDirty(waiting)
				S.Sync.notify(waiting, "A base pad opened up - it's yours now!", "good", "Bricklebee")
				break
			end
		end
	end
end

local function onPlayerRemoving(player: Player)
	local owner = Plots.byPlayer[player]
	if not owner then
		return
	end
	Plots.removeOwner(owner)
	owner.data.lastOnline = os.time()
	if owner.canSave then
		saving[player] = true
		S.Data.save(player, owner.data, true)
		saving[player] = nil
	end
end

-- Bots (Studio testing only): an owner with no player, so you can practice
-- snatching from a "real" tower when testing alone.
local botCount = 0
function Plots.addBot(entries)
	local plot = freePlot()
	if not plot then
		return nil
	end
	botCount += 1
	local data = S.Data.default()
	data.tower = entries
	data.tutorial = 99
	data.playtime = 99999
	local owner = newOwner({
		key = "bot" .. botCount,
		player = nil,
		isBot = true,
		userId = -1000 - botCount,
		name = "TestBot" .. botCount,
		data = data,
	})
	owner.moved = true
	Plots.byKey[owner.key] = owner
	assignPlot(owner, plot)
	return owner
end

function Plots.init(services)
	S = services
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	game:BindToClose(function()
		local pending = 0
		for player, owner in Plots.byPlayer do
			if owner.canSave then
				pending += 1
				owner.data.lastOnline = os.time()
				task.spawn(function()
					S.Data.save(player, owner.data, true)
					pending -= 1
				end)
			end
		end
		local start = os.clock()
		while (pending > 0 or next(saving) ~= nil) and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

function Plots.start()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	-- autosave
	while true do
		task.wait(Config.Data.AutosaveInterval)
		for player, owner in Plots.byPlayer do
			if owner.canSave then
				owner.data.lastOnline = os.time()
				task.spawn(S.Data.save, player, owner.data, false)
			end
		end
	end
end

-- Save one owner right away (after important trades like a completed snatch).
function Plots.saveSoon(owner)
	if owner.player and owner.canSave then
		task.spawn(S.Data.save, owner.player, owner.data, false)
	end
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Practice</string>
            <string name="Source"><![CDATA[--[[
	Practice: Sneaky Pete's practice tower in the plaza. Snatch from it as much
	as you like; the creatures always hop right back. Used by the tutorial.
]]

local Practice = {}

local S

local ENTRIES = {
	{ u = "practice1", id = "PancakePup", x = 0, z = 0 },
	{ u = "practice2", id = "Cubert", x = 0.3, z = 0 },
	{ u = "practice3", id = "Blobby", x = -0.2, z = 0.1 },
	{ u = "practice4", id = "Toastie", x = 0.2, z = 0 },
	{ u = "practice5", id = "BouncyBean", x = -0.1, z = 0 },
}

function Practice.init(services)
	S = services
	Practice.host = S.Towers.newHost({
		key = "practice",
		origin = S.Map.practice.origin,
		folder = S.Map.practice.folder,
		attributeTarget = S.Map.practice.model,
		getEntries = function()
			return ENTRIES
		end,
		getGlue = function()
			return 0
		end,
	})
	S.Towers.refresh(Practice.host)
end

-- Pete knocks it over on purpose to show that nothing is ever lost.
function Practice.demoTopple()
	if S.Towers.topple(Practice.host) then
		S.Sync.effectAll({ kind = "Topple", key = "practice", practice = true })
	end
end

return Practice
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--[[
	Progress: the Index (creature book), height ribbons and starter quests.

	The Index remembers every creature + mutation you have ever owned, even if it
	gets snatched later, so losing a creature never undoes Index progress.
	Each creature in your Index adds a small permanent coin bonus.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Creatures = require(Shared.Creatures)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)

local Progress = {}

local S

function Progress.recordIndex(owner, entry)
	local def = Creatures.ById[entry.id]
	if not def then
		return
	end
	local index = owner.data.index
	local isNewCreature = index[entry.id] == nil
	index[entry.id] = index[entry.id] or {}
	local page = index[entry.id]
	local variant = entry.m or "base"
	local isNewVariant = not page[variant]
	page[variant] = true
	if isNewCreature then
		S.Sync.notify(
			owner,
			"New Index entry: " .. def.Name .. "! (+" .. math.floor(Config.Economy.IndexBonusPerCreature * 100) .. "% coins forever)",
			"good",
			"Professor Puddlewick"
		)
	elseif isNewVariant and entry.m then
		S.Sync.notify(owner, "New Index variant: " .. (Mutations.name(entry.m) or entry.m) .. " " .. def.Name .. "!", "good", "Professor Puddlewick")
	end
	S.Sync.markDirty(owner)
end

function Progress.completeQuest(owner, questId: string)
	local data = owner.data
	if data.quests[questId] then
		return
	end
	for _, quest in Config.Quests do
		if quest.Id == questId then
			data.quests[questId] = true
			data.coins += quest.Reward
			S.Sync.notify(owner, "Quest complete: " .. quest.Text .. "! +" .. Format.number(quest.Reward) .. " coins", "good", "Mayor Marshmallow")
			S.Sync.effect(owner, { kind = "Quest" })
			S.Sync.markDirty(owner)
			return
		end
	end
end

-- Called whenever a creature comes into your hands (bought, scooped, snatched).
function Progress.onCreatureGained(owner, entry, source: string?)
	Progress.recordIndex(owner, entry)
	local def = Creatures.ById[entry.id]
	if def and Rarities.tier(def.Rarity) >= Rarities.tier("Rare") and source ~= "box" then
		Progress.completeQuest(owner, "catchRare")
	end
end

function Progress.onTowerChanged(owner)
	local data = owner.data
	local height = #data.tower
	if height >= 5 then
		Progress.completeQuest(owner, "reach5")
	end
	for _, h in Config.RibbonHeights do
		local key = tostring(h)
		if height >= h and not data.ribbons[key] then
			data.ribbons[key] = true
			S.Sync.notify(owner, "By the power of fluff, I declare your tower " .. h .. " creatures tall! Have a ribbon!", "rare", "Mayor Marshmallow")
			S.Sync.effectAll({ kind = "Ribbon", key = owner.key, plot = owner.plot and owner.plot.index, height = h })
		end
	end
end

-- Mayor Marshmallow's "Tallest Towers" board in the plaza.
local function updateBoard()
	local rows = {}
	for _, owner in S.Plots.all() do
		if owner.plot then
			table.insert(rows, { name = owner.name, height = #owner.data.tower })
		end
	end
	table.sort(rows, function(a, b)
		return a.height > b.height
	end)
	local lines = { "🏆 Tallest Towers 🏆" }
	for i = 1, math.min(5, #rows) do
		table.insert(lines, string.format("%d. %s - %d tall", i, rows[i].name, rows[i].height))
	end
	if #rows == 0 then
		table.insert(lines, "Be the first to stack!")
	end
	S.Map.tallestLabel.Text = table.concat(lines, "\n")
end

function Progress.init(services)
	S = services
end

function Progress.start()
	while true do
		pcall(updateBoard)
		task.wait(5)
	end
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Protection</string>
            <string name="Source"><![CDATA[--[[
	Protection: the fairness rules from design doc 4.4. Snatching should feel
	like a prank between friends, never a robbery.

	  Arrival Bubble       free shield on every join (3+ minutes, and until you move)
	  New Stacker          first 20 minutes of playtime: can't be snatched from
	  Nap Mode             idle ~2 minutes: tower sleeps, can't be snatched, earns 50%
	  Bubble Shield        button; blocks snatching completely while up
	  Ruffled Feathers     90 seconds of protection after being snatched from
	  Fair Snatch Range    only towers about half to double your height
	  Bounce-Back Ticket   one shield-ignoring revenge attempt after being snatched
	  Offline              your tower goes home with you
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Util = require(script.Parent.Parent.Util)

local Protection = {}

local S
local P = Config.Protection
local intruderNotices = {}

function Protection.onOwnerAdded(owner)
	local now = Util.now()
	owner.joinTime = now
	owner.lastActive = now
	owner.moved = false
end

function Protection.markActive(owner)
	owner.lastActive = Util.now()
	if owner.napping then
		owner.napping = false
		S.Plots.refreshPlot(owner)
		S.Sync.markDirty(owner)
	end
end

-- Everything protecting this owner's tower right now.
function Protection.state(owner)
	local now = Util.now()
	local exempt = owner.isBot or owner.devNoProtection
	local st = {}
	st.arrivalLeft = math.max(0, owner.joinTime + P.ArrivalBubbleSeconds - now)
	st.arrival = not exempt and (st.arrivalLeft > 0 or not owner.moved)
	st.newStackerLeft = math.max(0, P.NewStackerSeconds - owner.data.playtime)
	st.newStacker = not exempt and st.newStackerLeft > 0
	st.napping = not exempt and owner.napping
	st.ruffledLeft = math.max(0, owner.ruffledUntil - now)
	st.shieldLeft = math.max(0, owner.shieldUntil - now)
	st.shieldReadyIn = math.max(0, owner.shieldReadyAt - now)
	return st
end

-- Short status for the sign over the base pad. Returns text, protected, domeKind.
function Protection.statusText(owner)
	local st = Protection.state(owner)
	if st.shieldLeft > 0 then
		return "🛡️ Bubble Shield " .. Format.time(st.shieldLeft), true, "Shield"
	elseif st.arrival then
		return "💠 Arrival Bubble", true, "Arrival"
	elseif st.newStacker then
		return "🌱 New Stacker", true, "NewStacker"
	elseif st.napping then
		return "💤 Napping", true, "Nap"
	elseif st.ruffledLeft > 0 then
		return "🐤 Ruffled Feathers " .. Format.time(st.ruffledLeft), true, "Ruffled"
	end
	return "", false, nil
end

-- Can `snatcher` start a snatch on `target`'s tower? Returns ok, reason, usesTicket.
function Protection.canSnatch(target, snatcher)
	if target == snatcher then
		return false, "That's your own tower, silly!"
	end
	if #target.data.tower == 0 then
		return false, "There's nothing on that tower to snatch!"
	end
	if target.host and target.host.toppling then
		return false, "That tower is still bouncing back!"
	end
	local st = Protection.state(target)
	if st.arrival then
		return false, "They just arrived - their Arrival Bubble is up!"
	end
	if st.newStacker then
		return false, "They're a New Stacker - protected for now!"
	end
	if st.napping then
		return false, "Shh! That tower is napping."
	end
	if st.ruffledLeft > 0 then
		return false, "That tower's feathers are still ruffled (" .. Format.time(st.ruffledLeft) .. ")."
	end
	local usesTicket = false
	local ticket = snatcher.ticket
	if ticket and ticket.targetKey == target.key and ticket.expires > Util.now() then
		usesTicket = true
	end
	if st.shieldLeft > 0 and not usesTicket then
		return false, "Their Bubble Shield is up!"
	end
	local myHeight = #snatcher.data.tower
	if not snatcher.devNoProtection and not Economy.inFairRange(myHeight, #target.data.tower) then
		local lo, hi = Economy.fairRange(myHeight)
		return false, string.format("Out of your Fair Snatch Range (towers %d-%d tall).", lo, hi)
	end
	return true, nil, usesTicket
end

function Protection.activateShield(owner)
	local now = Util.now()
	if owner.shieldUntil > now then
		S.Sync.notify(owner, "Your Bubble Shield is already up!", "info")
		return
	end
	if now < owner.shieldReadyAt then
		S.Sync.notify(owner, "Bubble Shield is recharging (" .. Format.time(owner.shieldReadyAt - now) .. ").", "info", "Lou the Locksmith")
		return
	end
	local level = Economy.upgradeLevel(owner.data, "Shield")
	owner.shieldUntil = now + level.Duration
	owner.shieldReadyAt = owner.shieldUntil + level.Recharge
	Protection.markActive(owner)
	S.Sync.notify(owner, string.format("Bubble Shield up for %d seconds!", level.Duration), "good", "Lou the Locksmith")
	S.Sync.effectAll({ kind = "Shield", key = owner.key, plot = owner.plot and owner.plot.index })
	S.Onboarding.onShield(owner)
	Protection.refreshVisuals(owner, true)
	S.Sync.markDirty(owner)
end

function Protection.refreshVisuals(owner, force: boolean?)
	local text, _, kind = Protection.statusText(owner)
	local height = #owner.data.tower
	if force or text ~= owner.lastStatus or kind ~= owner.lastDomeKind or height ~= owner.lastDomeHeight then
		owner.lastStatus = text
		owner.lastDomeKind = kind
		owner.lastDomeHeight = height
		S.Towers.setDome(owner, kind)
		S.Plots.refreshPlot(owner)
	end
end

local function tick()
	local now = Util.now()
	for _, owner in S.Plots.all() do
		if owner.player then
			local _, hrp = Util.character(owner.player)
			if hrp then
				local pos = hrp.Position
				if owner.joinPos and not owner.moved and Util.flatDistance(pos, owner.joinPos) > 6 then
					owner.moved = true
					S.Sync.markDirty(owner)
				end
				if owner.lastPos and (pos - owner.lastPos).Magnitude > 0.5 then
					owner.lastActive = now
				end
				owner.lastPos = pos
			end
			local napping = now - owner.lastActive > P.NapAfterSeconds
			if napping ~= owner.napping then
				owner.napping = napping
				if not napping then
					S.Sync.notify(owner, "Your tower woke up!", "info")
				end
				S.Sync.markDirty(owner)
			end
		end
		Protection.refreshVisuals(owner)
	end

	-- Sneaky Pete's friendly heads-up when someone wanders up to your tower.
	for _, owner in S.Plots.all() do
		if owner.player and owner.plot and #owner.data.tower > 0 then
			for _, other in Players:GetPlayers() do
				if other ~= owner.player and not owner.friends[other.UserId] then
					local _, hrp = Util.character(other)
					if hrp and Util.flatDistance(hrp.Position, owner.plot.center) < P.IntruderNoticeRange then
						local key = owner.key .. ":" .. other.UserId
						if Util.throttle(intruderNotices, key, P.IntruderNoticeCooldown) then
							S.Sync.notify(owner, other.DisplayName .. " is eyeing your tower!", "warn", "Sneaky Pete")
						end
					end
				end
			end
		end
	end
end

function Protection.init(services)
	S = services
	Remotes.get("ActivateShield").OnServerEvent:Connect(function(player)
		local owner = S.Plots.get(player)
		if owner then
			Protection.activateShield(owner)
		end
	end)
end

function Protection.start()
	while true do
		task.wait(0.5)
		local ok, err = pcall(tick)
		if not ok then
			warn("[Protection]", err)
		end
	end
end

return Protection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Shops</string>
            <string name="Source"><![CDATA[--[[
	Shops: Grandma Gloop (Sticky Jam), Bricklebee (Base), Lou the Locksmith
	(Bubble Shield). Everything is bought with Giggle Coins earned in play -
	protection, glue and snatching power are never sold for Robux.
	Also handles codes (small coin rewards only, never creatures).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Shops = {}

local S

function Shops.buy(owner, track: any)
	if type(track) ~= "string" or not Config.Upgrades[track] then
		return
	end
	local data = owner.data
	local nextLevel, levelNumber = Economy.nextUpgrade(data, track)
	local info = Config.Upgrades[track]
	if not nextLevel then
		S.Sync.notify(owner, info.Title .. " is already maxed out!", "info", info.Npc)
		return
	end
	if data.coins < nextLevel.Cost then
		S.Sync.notify(owner, "You need " .. Format.number(nextLevel.Cost) .. " Giggle Coins for that.", "info", info.Npc)
		return
	end
	data.coins -= nextLevel.Cost
	data.upgrades[track] = levelNumber
	local lines = {
		Glue = "A little jam fixes everything, sweetie! Sticky Jam level " .. levelNumber .. "!",
		Base = "Bzzt! Let's build it bigger! Base level " .. levelNumber .. "!",
		Shield = "Slow and steady... keeps the tower steady. Shield level " .. levelNumber .. ".",
	}
	S.Sync.notify(owner, lines[track] or (info.Title .. " upgraded!"), "good", info.Npc)
	S.Sync.effect(owner, { kind = "Upgrade", track = track })
	if owner.host then
		S.Towers.refresh(owner.host)
	end
	S.Plots.refreshPlot(owner)
	S.Sync.markDirty(owner)
end

function Shops.redeem(owner, code: any): string
	if type(code) ~= "string" then
		return "Hmm, that's not a code."
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return "That code didn't work. Check the spelling!"
	end
	if owner.data.codes[code] then
		return "You already used that code!"
	end
	owner.data.codes[code] = true
	owner.data.coins += reward.Coins or 0
	S.Sync.markDirty(owner)
	return "Yay! +" .. Format.number(reward.Coins or 0) .. " Giggle Coins!"
end

function Shops.init(services)
	S = services
	Remotes.get("BuyUpgrade").OnServerEvent:Connect(function(player, track)
		local owner = S.Plots.get(player)
		if owner then
			Shops.buy(owner, track)
		end
	end)
	Remotes.get("RedeemCode").OnServerInvoke = function(player, code)
		local owner = S.Plots.get(player)
		if not owner then
			return "Still loading, try again in a moment!"
		end
		return Shops.redeem(owner, code)
	end
end

return Shops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Snatch</string>
            <string name="Source"><![CDATA[--[[
	Snatch: pulling a creature off the top of someone's tower (design doc 4.3).

	  1. You can only snatch from the very top of a tower.
	  2. Wiggle too much and the tower topples - you get nothing.
	  3. If the tower topples, every creature hops back home. The owner loses nothing.
	  4. Bubble Shields block snatching completely while they're up.
	  5. If the owner (or their friend) boops you while you carry their creature,
	     it hops right back home.
	  6. Nobody can snatch from you when you're offline, and you're safe for a bit
	     when you first join.

	Flow: request -> server checks every rule -> hop up the pegs -> steady-hand
	minigame on the client -> server sanity-checks the result -> success (carry
	it home) or topple (dizzy stars, nothing lost). The server decides everything.
]]

local StarterPlayer = game:GetService("StarterPlayer")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Creatures = require(Shared.Creatures)
local Format = require(Shared.Format)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Wobble = require(Shared.Wobble)
local Economy = require(Shared.Economy)
local Util = require(script.Parent.Parent.Util)

local Snatch = {}

local S
local SN = Config.Snatch
local snatchStart
local boopTimes = {}

local function creatureName(entry): string
	local def = entry and Creatures.ById[entry.id]
	return def and def.Name or "creature"
end

local function defaultSpeed(): number
	return StarterPlayer.CharacterWalkSpeed
end

function Snatch.isTowerBusy(owner): boolean
	local lock = owner.snatchLock
	return lock ~= nil and lock.session ~= nil and lock.snatcher.session == lock.session
end

-- Minigame difficulty from the target tower (glue + steadiness + top rarity).
local function minigameParams(target, practice: boolean)
	if practice then
		return {
			ring = SN.BaseRing + 0.04,
			drift = SN.BaseDrift * 0.8,
			required = 1.6,
			limit = 1.6 + SN.ExtraTime + 1,
			maxOutside = SN.MaxOutside + 0.25,
		}
	end
	local data = target.data
	local glueLevel = Config.Upgrades.Glue.Levels[data.upgrades.Glue] or Config.Upgrades.Glue.Levels[1]
	local ringLevel = glueLevel.Ring
	local stability = 1 - math.clamp(Wobble.ratio(data.tower, Economy.glueReduce(data)), 0, 1)
	local top = data.tower[#data.tower]
	local def = top and Creatures.ById[top.id]
	local tier = def and Rarities.tier(def.Rarity) or 1
	local required = SN.BaseRequired + SN.RequiredStability * stability + SN.RequiredPerRarity * (tier - 1)
	return {
		ring = SN.BaseRing - SN.RingShrinkPerGlue * ringLevel,
		drift = SN.BaseDrift + SN.DriftPerGlue * ringLevel,
		required = required,
		limit = required + SN.ExtraTime,
		maxOutside = SN.MaxOutside,
	}
end

-- Carry effects -----------------------------------------------------------------------

local function clearCarryFx(owner)
	local fx = owner.carryFx
	if fx then
		for _, inst in fx do
			inst:Destroy()
		end
		owner.carryFx = nil
	end
	local _, _, humanoid = Util.character(owner.player)
	if humanoid and owner.stunnedUntil <= Util.now() then
		humanoid.WalkSpeed = defaultSpeed()
	end
end

local function addCarryFx(owner, entry, fromName: string)
	local character, hrp, humanoid = Util.character(owner.player)
	if not character or not hrp or not humanoid then
		return
	end
	local def = Creatures.ById[entry.id]
	local rarity = Rarities.get(def.Rarity)
	humanoid.WalkSpeed = SN.CarrySpeedByRarity[def.Rarity] or 14

	local a0 = Instance.new("Attachment")
	a0.Name = "CarryTrail0"
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "CarryTrail1"
	a1.Position = Vector3.new(0, -1.5, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 1.6
	trail.LightEmission = 0.6
	trail.Color = ColorSequence.new(rarity.Color, Color3.fromRGB(255, 255, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = hrp

	local gui = Instance.new("BillboardGui")
	gui.Name = "CarryTag"
	gui.Size = UDim2.fromScale(10, 1.4)
	gui.StudsOffset = Vector3.new(0, 9, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 220
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rarity.Color
	label.TextStrokeTransparency = 0
	label.Text = "🏃 Carrying " .. fromName .. "'s " .. def.Name .. "!"
	label.Parent = gui
	gui.Adornee = hrp
	gui.Parent = hrp

	owner.carryFx = { a0, a1, trail, gui }
end

-- Putting a creature back on its owner's tower (or in their box if it won't fit).
local function returnToOwner(from, entry)
	local data = from.data
	local i = Util.findByUid(data.transit, entry.u)
	if i then
		table.remove(data.transit, i)
	end
	local plainEntry = { u = entry.u, id = entry.id, m = entry.m, x = 0, z = 0 }
	local candidate = Wobble.withTop(data.tower, plainEntry)
	if #data.tower < Economy.maxSlots(data) and Wobble.isStable(candidate, Economy.glueReduce(data)) then
		table.insert(data.tower, plainEntry)
		return "tower"
	end
	table.insert(data.box, { u = entry.u, id = entry.id, m = entry.m })
	return "box"
end

local function ownerStillHere(owner): boolean
	return S.Plots.byKey[owner.key] == owner
end

-- The carry ends with the creature hopping home (booped, timeout, fell, left...).
function Snatch.cancelCarry(carrier, reason: string?)
	local c = carrier.carry
	if not c then
		return
	end
	carrier.carry = nil
	clearCarryFx(carrier)
	S.Stacking.attachHeld(carrier) -- removes the carried model (hands are empty again)
	local _, hrp = Util.character(carrier.player)
	local from = c.from
	if ownerStillHere(from) then
		local where = returnToOwner(from, c.entry)
		if from.host then
			S.Towers.refresh(from.host)
		end
		S.Plots.refreshPlot(from)
		S.Plots.updateLeaderstats(from)
		S.Sync.markDirty(from)
		S.Sync.notify(
			from,
			"Your " .. creatureName(c.entry) .. " hopped back home" .. (where == "box" and " (into your Box)!" or "!"),
			"good",
			"Sneaky Pete"
		)
		S.Sync.effectAll({
			kind = "HopHome",
			from = hrp and hrp.Position or nil,
			plot = from.plot and from.plot.index,
			id = c.entry.id,
		})
	end
	if reason then
		S.Sync.notify(carrier, reason, "warn")
	end
	S.Sync.markDirty(carrier)
end

-- Made it home with the creature: it's yours now.
local function arrive(carrier)
	local c = carrier.carry
	local from = c.from
	carrier.carry = nil
	clearCarryFx(carrier)
	if not ownerStillHere(from) then
		S.Stacking.attachHeld(carrier)
		return
	end
	local i = Util.findByUid(from.data.transit, c.entry.u)
	if i then
		table.remove(from.data.transit, i)
	end
	local entry = { u = c.entry.u, id = c.entry.id, m = c.entry.m }
	if carrier.data.held then
		-- never overwrite a creature: whatever was in hand goes to the Box
		table.insert(carrier.data.box, carrier.data.held)
	end
	carrier.data.held = entry
	S.Stacking.attachHeld(carrier)
	S.Progress.onCreatureGained(carrier, entry, "snatch")
	carrier.data.stats.snatches += 1
	from.data.stats.snatched += 1
	local now = Util.now()
	from.ticket = { targetKey = carrier.key, targetName = carrier.name, expires = now + Config.Protection.BounceBackSeconds }

	S.Sync.notify(carrier, "Snatch complete! Stack your new " .. creatureName(entry) .. "!", "good", "Sneaky Pete")
	S.Sync.notify(
		from,
		carrier.name .. " snatched your " .. creatureName(entry) .. "! You got a Bounce-Back Ticket: one revenge snatch on their tower that ignores their shield ("
			.. Format.time(Config.Protection.BounceBackSeconds) .. ").",
		"warn",
		"Sneaky Pete"
	)
	S.Sync.effectAll({ kind = "SnatchHome", userId = carrier.userId })
	S.Progress.completeQuest(carrier, "realSnatch")
	S.Sync.markDirty(carrier)
	S.Sync.markDirty(from)
	S.Plots.saveSoon(from)
	S.Plots.saveSoon(carrier)
end

function Snatch.onCarrierLost(owner, why: string)
	if owner.carry then
		Snatch.cancelCarry(owner, "Oops, you " .. why .. "! The creature hopped back home.")
	end
	-- Died mid-snatch: just end the attempt (the tower is unlocked, nothing moves).
	local session = owner.session
	if session and session.kind == "snatch" then
		owner.session = nil
		if session.tween then
			session.tween:Cancel()
		end
		if session.target and session.target.snatchLock and session.target.snatchLock.snatcher == owner then
			session.target.snatchLock = nil
		end
		S.Sync.markDirty(owner)
	end
end

-- Snatch sessions ---------------------------------------------------------------------

local function releaseCharacter(owner, landCF: CFrame?)
	local character, hrp = Util.character(owner.player)
	if character and hrp then
		hrp.Anchored = false
		if landCF then
			character:PivotTo(landCF)
		end
	end
end

local function endSession(owner)
	local session = owner.session
	if not session or session.kind ~= "snatch" then
		return nil
	end
	owner.session = nil
	if session.tween then
		session.tween:Cancel()
		session.tween = nil
	end
	if session.target and session.target.snatchLock and session.target.snatchLock.snatcher == owner then
		session.target.snatchLock = nil
	end
	return session
end

local function stun(owner)
	local _, _, humanoid = Util.character(owner.player)
	owner.stunnedUntil = Util.now() + SN.StunSeconds
	if humanoid then
		humanoid.WalkSpeed = 0
		task.delay(SN.StunSeconds, function()
			if owner.stunnedUntil <= Util.now() + 0.05 and humanoid.Parent and not owner.carry then
				humanoid.WalkSpeed = defaultSpeed()
			end
		end)
	end
	S.Sync.effectAll({ kind = "Dizzy", userId = owner.userId })
end

local function resolve(owner, session, success: boolean)
	local practice = session.practice
	local host = practice and S.Practice.host or (session.target and session.target.host)
	local landCF = host and S.Map.snatchLandCF(host.origin)

	if practice then
		releaseCharacter(owner, landCF)
		if success then
			S.Sync.notify(owner, "FWIP! Nice snatch! (Practice creatures hop right back.)", "good", "Sneaky Pete")
			S.Sync.effectAll({ kind = "Snatch", userId = owner.userId, practice = true })
		else
			S.Towers.topple(host)
			S.Sync.effectAll({ kind = "Topple", key = host.key, practice = true })
			stun(owner)
			S.Sync.notify(owner, "Wheee! Too wiggly! See? They all hop home. No harm done!", "info", "Sneaky Pete")
		end
		S.Onboarding.onPracticeSnatch(owner, success)
		return
	end

	local target = session.target
	if not ownerStillHere(target) or not target.host then
		releaseCharacter(owner, landCF)
		return
	end
	local data = target.data
	if success and #data.tower > 0 then
		local entry = table.remove(data.tower)
		table.insert(data.transit, { u = entry.u, id = entry.id, m = entry.m })
		target.ruffledUntil = Util.now() + Config.Protection.RuffledFeathersSeconds
		S.Towers.refresh(target.host)
		S.Plots.refreshPlot(target)
		S.Plots.updateLeaderstats(target)
		releaseCharacter(owner, landCF)
		owner.carry = { entry = entry, from = target, start = Util.now() }
		S.Stacking.attachHeld(owner)
		addCarryFx(owner, entry, target.name)
		S.Sync.effectAll({ kind = "Snatch", userId = owner.userId, plot = target.plot and target.plot.index })
		S.Sync.notify(owner, "FWIP! Got the " .. creatureName(entry) .. "! Run home before " .. target.name .. " boops you!", "good", "Sneaky Pete")
		S.Sync.notify(target, owner.name .. " snatched your " .. creatureName(entry) .. "! Go boop them to bring it home!", "warn", "Sneaky Pete")
		S.Sync.markDirty(target)
	else
		releaseCharacter(owner, landCF)
		S.Towers.topple(target.host)
		S.Sync.effectAll({ kind = "Topple", key = target.key, plot = target.plot and target.plot.index })
		stun(owner)
		S.Sync.notify(owner, "Wheee! The tower toppled! Everyone hops home - better luck next time.", "info", "Sneaky Pete")
		S.Sync.notify(target, owner.name .. " tried to snatch from you and toppled your tower! Nothing lost.", "info", "Sneaky Pete")
	end
	S.Sync.markDirty(owner)
end

function Snatch.request(owner, plotIndex: any)
	if type(plotIndex) ~= "number" then
		return
	end
	local now = Util.now()
	if owner.session or owner.carry or owner.stunnedUntil > now then
		return
	end
	if owner.data.held then
		S.Sync.notify(owner, "You need empty hands to snatch!", "info", "Sneaky Pete")
		return
	end
	local character, hrp = Util.character(owner.player)
	if not character or not hrp then
		return
	end

	local practice = plotIndex == 0
	local target, host, pegs
	if practice then
		host = S.Practice.host
		pegs = S.Map.practice.pegs
	else
		target = S.Plots.ownerOfPlot(plotIndex)
		if not target or not target.host then
			return
		end
		host = target.host
		pegs = target.plot.pegs
		if not owner.plot then
			S.Sync.notify(owner, "You need a base pad to carry creatures home to!", "info")
			return
		end
	end

	if Util.flatDistance(hrp.Position, pegs.Position) > SN.PromptDistance + SN.ServerDistanceSlack then
		return
	end

	local usesTicket = false
	if practice then
		if host.toppling then
			S.Sync.notify(owner, "Hang on, the practice tower is still bouncing back!", "info", "Sneaky Pete")
			return
		end
	else
		local ok, reason, ticket = S.Protection.canSnatch(target, owner)
		if not ok then
			S.Sync.notify(owner, reason, "info", "Sneaky Pete")
			return
		end
		if Snatch.isTowerBusy(target) then
			S.Sync.notify(owner, "Someone's already on that tower! Wait your turn.", "info", "Sneaky Pete")
			return
		end
		usesTicket = ticket
	end

	local params = minigameParams(target, practice)
	local session = {
		kind = "snatch",
		id = Util.uid(),
		practice = practice,
		target = target,
		params = params,
		requested = now,
	}
	owner.session = session
	if target then
		target.snatchLock = { snatcher = owner, session = session }
		if usesTicket then
			owner.ticket = nil
			S.Sync.notify(owner, "Bounce-Back Ticket used - their shield can't stop you this time!", "good", "Sneaky Pete")
		elseif owner.ticket and owner.ticket.targetKey == target.key then
			owner.ticket = nil -- one revenge attempt only
		end
		S.Sync.notify(target, owner.name .. " is climbing your tower! Get ready to boop!", "warn", "Sneaky Pete")
		for _, entry in target.data.tower do
			local def = Creatures.ById[entry.id]
			if def and def.Alarm then
				S.Sync.effectAll({ kind = "Alarm", plot = target.plot.index })
				S.Sync.notify(target, "Teapot Turtle whistles! Someone's on your tower!", "warn")
				break
			end
		end
		S.Sync.markDirty(target)
	end
	S.Protection.markActive(owner)

	-- Hop up the pegs.
	local stand = S.Map.snatchStandCF(host.origin, S.Towers.topHeight(host))
	hrp.Anchored = true
	session.tween = TweenService:Create(hrp, TweenInfo.new(SN.HopUpTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = stand })
	session.tween:Play()
	S.Sync.effectAll({ kind = "Hop", userId = owner.userId })

	task.delay(SN.HopUpTime, function()
		if owner.session ~= session then
			return
		end
		session.tween = nil
		character:PivotTo(stand)
		session.start = Util.now()
		snatchStart:FireClient(owner.player, session.id, {
			ring = params.ring,
			drift = params.drift,
			required = params.required,
			limit = params.limit,
			maxOutside = params.maxOutside,
			practice = practice,
			creatureId = (function()
				local entries = host.getEntries()
				local top = entries[#entries]
				return top and top.id
			end)(),
		})
	end)
	-- Safety net: if the client never answers, the tower wins.
	task.delay(SN.HopUpTime + params.limit + 4, function()
		if owner.session == session then
			endSession(owner)
			resolve(owner, session, false)
		end
	end)
end

function Snatch.result(owner, sessionId: any, success: any, stats: any)
	local session = owner.session
	if not session or session.kind ~= "snatch" or session.id ~= sessionId or not session.start then
		return
	end
	endSession(owner)
	local params = session.params
	local elapsed = Util.now() - session.start
	local ok = success == true
	if ok then
		-- Sanity checks: you can't finish faster than the steady time needed.
		if elapsed < params.required - 0.4 or elapsed > params.limit + 2 then
			ok = false
		end
		if type(stats) == "table" and type(stats.steady) == "number" and stats.steady < params.required * 0.85 then
			ok = false
		end
	end
	-- Flag suspiciously perfect streaks for review (never punish automatically).
	if ok and type(stats) == "table" and stats.outside == 0 then
		owner.perfectStreak = (owner.perfectStreak or 0) + 1
		if owner.perfectStreak >= SN.PerfectFlagStreak then
			warn(string.format("[Snatch] %s has %d perfect snatches in a row", owner.name, owner.perfectStreak))
		end
	else
		owner.perfectStreak = 0
	end
	resolve(owner, session, ok)
end

-- Boop! -------------------------------------------------------------------------------

function Snatch.boop(owner)
	if not Util.throttle(boopTimes, owner.key, SN.BoopCooldown) then
		return
	end
	local _, hrp = Util.character(owner.player)
	if not hrp then
		return
	end
	S.Protection.markActive(owner)
	S.Sync.effectAll({ kind = "Boop", userId = owner.userId })
	for _, carrier in S.Plots.all() do
		local c = carrier.carry
		if c and carrier ~= owner and (c.from == owner or S.Social.areFriends(c.from, owner)) then
			local _, chrp = Util.character(carrier.player)
			if chrp and (chrp.Position - hrp.Position).Magnitude <= SN.BoopRange then
				Snatch.cancelCarry(carrier, "BOOP! " .. owner.name .. " booped you - the creature hopped back home!")
				local dir = chrp.Position - hrp.Position
				dir = Vector3.new(dir.X, 0, dir.Z)
				dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(1, 0, 0)
				if carrier.player then
					S.Sync.effect(carrier, { kind = "Knockback", dir = dir * SN.BoopKnockback + Vector3.new(0, 30, 0) })
				end
				S.Sync.notify(owner, "BOOP! Your creature is hopping home!", "good", "Sneaky Pete")
			end
		end
	end
end

-- Cleanup when someone leaves --------------------------------------------------------

function Snatch.onOwnerRemoving(owner)
	-- They were carrying someone's creature: it hops home.
	if owner.carry then
		Snatch.cancelCarry(owner, nil)
	end
	-- Someone was carrying *their* creature: put it straight back in their data.
	for _, carrier in S.Plots.all() do
		local c = carrier.carry
		if c and c.from == owner then
			carrier.carry = nil
			clearCarryFx(carrier)
			S.Stacking.attachHeld(carrier)
			returnToOwner(owner, c.entry)
			S.Sync.notify(carrier, owner.name .. " left, so their " .. creatureName(c.entry) .. " hopped home.", "info")
			S.Sync.markDirty(carrier)
		end
		-- Someone was mid-snatch on their tower.
		local session = carrier.session
		if session and session.kind == "snatch" and session.target == owner then
			endSession(carrier)
			releaseCharacter(carrier, S.Map.snatchLandCF(owner.host.origin))
		end
	end
	-- Their own snatch in progress.
	local session = endSession(owner)
	if session then
		releaseCharacter(owner, nil)
	end
	owner.snatchLock = nil
end

function Snatch.init(services)
	S = services
	snatchStart = Remotes.get("SnatchStart")
	Remotes.get("RequestSnatch").OnServerEvent:Connect(function(player, plotIndex)
		local owner = S.Plots.get(player)
		if owner then
			Snatch.request(owner, plotIndex)
		end
	end)
	Remotes.get("SnatchResult").OnServerEvent:Connect(function(player, sessionId, success, stats)
		local owner = S.Plots.get(player)
		if owner then
			Snatch.result(owner, sessionId, success, stats)
		end
	end)
	Remotes.get("Boop").OnServerEvent:Connect(function(player)
		local owner = S.Plots.get(player)
		if owner then
			Snatch.boop(owner)
		end
	end)
end

function Snatch.start()
	while true do
		task.wait(0.2)
		local now = Util.now()
		for _, owner in S.Plots.all() do
			local c = owner.carry
			if c then
				local _, hrp = Util.character(owner.player)
				if not ownerStillHere(c.from) then
					owner.carry = nil
					clearCarryFx(owner)
					S.Stacking.attachHeld(owner)
				elseif not hrp then
					Snatch.cancelCarry(owner, "Oops! The creature hopped back home.")
				elseif S.Plots.onOwnPad(owner) then
					local ok, err = pcall(arrive, owner)
					if not ok then
						warn("[Snatch] arrive failed", err)
					end
				elseif now - c.start > SN.CarryTimeout then
					Snatch.cancelCarry(owner, "The creature got sleepy and hopped back home!")
				end
			end
			if owner.ticket and owner.ticket.expires < now then
				owner.ticket = nil
				S.Sync.markDirty(owner)
			end
		end
	end
end

return Snatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[--[[
	Social: friends (only the owner and their friends can boop a carrier) and
	quick emotes, so the game is fully playable without chat.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(script.Parent.Parent.Util)

local Social = {}

local S
local emoteTimes = {}

local function checkFriends(a: Player, b: Player): boolean
	if a.UserId <= 0 or b.UserId <= 0 then
		return false -- Studio test players
	end
	local ok, result = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	if not ok then
		ok, result = pcall(function()
			return (a :: any):IsFriendsWith(b.UserId)
		end)
	end
	return ok and result == true
end

function Social.onOwnerAdded(owner)
	if not owner.player then
		return
	end
	for _, other in S.Plots.all() do
		if other ~= owner and other.player then
			task.spawn(function()
				if checkFriends(owner.player, other.player) then
					owner.friends[other.userId] = true
					other.friends[owner.userId] = true
				end
			end)
		end
	end
end

function Social.areFriends(a, b): boolean
	return a.friends[b.userId] == true or b.friends[a.userId] == true
end

function Social.init(services)
	S = services
	Remotes.get("Emote").OnServerEvent:Connect(function(player, index)
		local text = type(index) == "number" and Config.Emotes[index]
		if not text or not Util.throttle(emoteTimes, player, Config.EmoteCooldown) then
			return
		end
		S.Sync.effectAll({ kind = "Emote", userId = player.UserId, text = text })
	end)
	Players.PlayerRemoving:Connect(function(player)
		emoteTimes[player] = nil
	end)
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Stacking</string>
            <string name="Source"><![CDATA[--[[
	Stacking: the creature in your hands, placing it on your tower, the Box,
	rearranging your tower, and the Comfy Cushion.

	Placement uses the swing: the ghost sways over your tower and you tap DROP.
	The server recomputes where it landed from the drop time (Wobble.swingOffset)
	and decides with the wobble rules whether it stacks or the tower topples.
	Toppling your own tower never loses anything: everyone hops back, and the
	creature you tried to add lands on the ground next to the tower.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Creatures = require(Shared.Creatures)
local CreatureModel = require(Shared.CreatureModel)
local Economy = require(Shared.Economy)
local Wobble = require(Shared.Wobble)
local Util = require(script.Parent.Parent.Util)

local Stacking = {}

local S
local rng = Random.new()

local function creatureName(entry): string
	local def = entry and Creatures.ById[entry.id]
	return def and def.Name or "creature"
end

local function plain(entry)
	return { u = entry.u, id = entry.id, m = entry.m }
end

function Stacking.newEntry(creatureId: string, mutation: string?)
	return { u = Util.uid(), id = creatureId, m = mutation }
end

function Stacking.handsFree(owner): boolean
	local snatching = owner.session ~= nil and owner.session.kind == "snatch"
	return owner.data.held == nil and owner.carry == nil and not snatching
end

-- The creature model riding above your head --------------------------------------

function Stacking.detachHeld(owner)
	if owner.heldModel then
		owner.heldModel:Destroy()
		owner.heldModel = nil
	end
end

function Stacking.attachHeld(owner)
	Stacking.detachHeld(owner)
	local held = owner.data.held or (owner.carry and owner.carry.entry)
	if not held then
		return
	end
	local character, hrp = Util.character(owner.player)
	if not character or not hrp then
		return
	end
	local model = CreatureModel.build(held.id, held.m)
	if not model then
		return
	end
	model.Name = "HeldCreature"
	model:PivotTo(hrp.CFrame * CFrame.new(0, 3.4, 0))
	CreatureModel.prepareForCarry(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	model.Parent = character
	owner.heldModel = model
end

-- Put a creature into an owner's hands. Returns false if their hands are full.
function Stacking.give(owner, entry, source: string?): boolean
	if not Stacking.handsFree(owner) then
		return false
	end
	owner.data.held = plain(entry)
	S.Progress.onCreatureGained(owner, owner.data.held, source)
	Stacking.attachHeld(owner)
	S.Sync.markDirty(owner)
	return true
end

local function afterTowerChange(owner)
	if owner.host then
		S.Towers.refresh(owner.host)
	end
	S.Progress.onTowerChanged(owner)
	S.Plots.refreshPlot(owner)
	S.Plots.updateLeaderstats(owner)
	S.Sync.markDirty(owner)
end

local function towerLocked(owner): boolean
	if owner.host and owner.host.toppling then
		S.Sync.notify(owner, "Wait a sec - your tower is still bouncing back!", "info")
		return true
	end
	if S.Snatch.isTowerBusy(owner) then
		S.Sync.notify(owner, "Someone's climbing your tower! Boop them first.", "warn", "Sneaky Pete")
		return true
	end
	return false
end

-- Drop the held creature on your tower -------------------------------------------

function Stacking.place(owner, dropTime: any)
	local data = owner.data
	local held = data.held
	if not held or not owner.plot or not owner.host then
		return
	end
	if towerLocked(owner) then
		return
	end
	if not S.Plots.onOwnPad(owner, 4) then
		S.Sync.notify(owner, "Stand on your base pad to stack!", "info")
		return
	end
	if #data.tower >= Economy.maxSlots(data) then
		S.Sync.notify(owner, "Your tower is full! Bricklebee can build you a bigger base.", "warn", "Bricklebee")
		return
	end

	local now = Util.now()
	if type(dropTime) ~= "number" or dropTime ~= dropTime or math.abs(dropTime - now) > Config.Pendulum.TimestampTolerance then
		dropTime = now
	end
	local n = #data.tower
	local x, z = Wobble.swingOffset(dropTime, n)
	local entry = { u = held.u, id = held.id, m = held.m, x = Wobble.roundOffset(x), z = Wobble.roundOffset(z) }
	if n == 0 then
		entry.x, entry.z = 0, 0
	end

	data.held = nil
	Stacking.detachHeld(owner)
	S.Protection.markActive(owner)

	if not Wobble.isStable(Wobble.withTop(data.tower, entry), Economy.glueReduce(data)) then
		-- Too wobbly: sproing! Nobody is lost; the new creature lands on the ground.
		table.insert(data.box, plain(entry))
		owner.ground = owner.ground or {}
		owner.ground[entry.u] = true
		data.stats.topples += 1
		S.Towers.topple(owner.host, function()
			S.Towers.renderGround(owner)
			S.Sync.markDirty(owner)
		end)
		S.Sync.effectAll({ kind = "Topple", key = owner.key, plot = owner.plot.index })
		S.Sync.notify(
			owner,
			"Wheeee! Too wobbly! Everyone hops back home. Your " .. creatureName(entry) .. " landed next to the tower.",
			"warn"
		)
		S.Plots.refreshPlot(owner)
		S.Sync.markDirty(owner)
		return
	end

	-- Sprinkle Rain: creatures stacked during the weather may get Sprinkled.
	if not entry.m and S.Weather.isActive() and rng:NextNumber() < Config.Weather.MutationChance then
		entry.m = "Sprinkled"
		S.Progress.recordIndex(owner, entry)
		S.Sync.notify(owner, "Sprinkle Rain made your " .. creatureName(entry) .. " Sprinkled! (x1.5 coins)", "rare")
	end

	table.insert(data.tower, entry)
	afterTowerChange(owner)
	local def = Creatures.ById[entry.id]
	S.Sync.effectAll({
		kind = "Stack",
		key = owner.key,
		plot = owner.plot.index,
		height = #data.tower,
		confetti = def and def.Confetti or nil,
	})
	S.Onboarding.onPlaced(owner)
end

-- The Box -----------------------------------------------------------------------------

function Stacking.storeHeld(owner)
	local data = owner.data
	if not data.held then
		return
	end
	if #data.box >= Economy.boxCapacity(data) then
		S.Sync.notify(owner, "Your Box is full! Stack something or upgrade your base.", "warn", "Bricklebee")
		return
	end
	table.insert(data.box, plain(data.held))
	data.held = nil
	Stacking.detachHeld(owner)
	S.Sync.markDirty(owner)
end

function Stacking.takeFromBox(owner, uid: any)
	if type(uid) ~= "string" then
		return
	end
	local data = owner.data
	if not Stacking.handsFree(owner) then
		S.Sync.notify(owner, "Your hands are full!", "info")
		return
	end
	local i = Util.findByUid(data.box, uid)
	if not i then
		return
	end
	local entry = table.remove(data.box, i)
	data.held = plain(entry)
	if owner.ground then
		owner.ground[uid] = nil
	end
	S.Towers.renderGround(owner)
	Stacking.attachHeld(owner)
	S.Sync.markDirty(owner)
end

function Stacking.pickUpGround(owner, uid: any)
	if type(uid) ~= "string" or not (owner.ground and owner.ground[uid]) then
		return
	end
	Stacking.takeFromBox(owner, uid)
end

-- Rearranging the tower -----------------------------------------------------------

local function freeCushionSlot(data): number?
	for slot = 1, Config.Protection.CushionSlots do
		if data.cushions[slot] == false or data.cushions[slot] == nil then
			return slot
		end
	end
	return nil
end

-- Try a new tower order; refuses changes that would leave the tower too wobbly.
local function tryTower(owner, newTower): boolean
	if not Wobble.isStable(newTower, Economy.glueReduce(owner.data)) then
		S.Sync.notify(owner, "That would make the tower too wobbly! Try another spot.", "warn", "Grandma Gloop")
		return false
	end
	owner.data.tower = newTower
	return true
end

function Stacking.towerAction(owner, action: any, uid: any)
	if type(action) ~= "string" then
		return
	end
	local data = owner.data
	S.Protection.markActive(owner)

	if action == "uncushion" then
		local slot = tonumber(uid)
		local entry = slot and data.cushions[slot]
		if type(entry) ~= "table" then
			return
		end
		if Stacking.handsFree(owner) then
			data.held = plain(entry)
			Stacking.attachHeld(owner)
		elseif #data.box < Economy.boxCapacity(data) then
			table.insert(data.box, plain(entry))
		else
			S.Sync.notify(owner, "Your hands and Box are full!", "info")
			return
		end
		data.cushions[slot] = false
		S.Towers.renderCushions(owner)
		S.Plots.refreshPlot(owner)
		S.Sync.markDirty(owner)
		return
	end

	if type(uid) ~= "string" then
		return
	end

	if action == "cushionFromBox" then
		local slot = freeCushionSlot(data)
		local i = Util.findByUid(data.box, uid)
		if not slot then
			S.Sync.notify(owner, "Your Comfy Cushion is taken! Move that creature off first.", "info", "Lou the Locksmith")
			return
		end
		if i then
			data.cushions[slot] = plain(table.remove(data.box, i))
			if owner.ground then
				owner.ground[uid] = nil
			end
			S.Towers.renderGround(owner)
			S.Towers.renderCushions(owner)
			S.Plots.refreshPlot(owner)
			S.Sync.markDirty(owner)
		end
		return
	end

	-- Everything below changes the tower itself.
	local i = Util.findByUid(data.tower, uid)
	if not i or towerLocked(owner) then
		return
	end
	local tower = data.tower

	if action == "take" then
		if not Stacking.handsFree(owner) then
			S.Sync.notify(owner, "Your hands are full!", "info")
			return
		end
		local newTower = table.clone(tower)
		local entry = table.remove(newTower, i)
		if tryTower(owner, newTower) then
			data.held = plain(entry)
			Stacking.attachHeld(owner)
			afterTowerChange(owner)
		end
	elseif action == "up" or action == "down" then
		local j = action == "up" and i + 1 or i - 1
		if j < 1 or j > #tower then
			return
		end
		local newTower = table.clone(tower)
		newTower[i], newTower[j] = newTower[j], newTower[i]
		if tryTower(owner, newTower) then
			afterTowerChange(owner)
		end
	elseif action == "cushion" then
		local slot = freeCushionSlot(data)
		if not slot then
			S.Sync.notify(owner, "Your Comfy Cushion is taken! Move that creature off first.", "info", "Lou the Locksmith")
			return
		end
		local newTower = table.clone(tower)
		local entry = table.remove(newTower, i)
		if tryTower(owner, newTower) then
			data.cushions[slot] = plain(entry)
			S.Towers.renderCushions(owner)
			afterTowerChange(owner)
		end
	end
end

function Stacking.init(services)
	S = services
	local Remotes = require(Shared.Remotes)
	Remotes.get("PlaceHeld").OnServerEvent:Connect(function(player, dropTime)
		local owner = S.Plots.get(player)
		if owner then
			Stacking.place(owner, dropTime)
		end
	end)
	Remotes.get("StoreHeld").OnServerEvent:Connect(function(player)
		local owner = S.Plots.get(player)
		if owner then
			Stacking.storeHeld(owner)
		end
	end)
	Remotes.get("TakeFromBox").OnServerEvent:Connect(function(player, uid)
		local owner = S.Plots.get(player)
		if owner then
			Stacking.takeFromBox(owner, uid)
		end
	end)
	Remotes.get("PickUpGround").OnServerEvent:Connect(function(player, uid)
		local owner = S.Plots.get(player)
		if owner then
			Stacking.pickUpGround(owner, uid)
		end
	end)
	Remotes.get("TowerAction").OnServerEvent:Connect(function(player, action, uid)
		local owner = S.Plots.get(player)
		if owner then
			Stacking.towerAction(owner, action, uid)
		end
	end)
end

return Stacking
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Sync</string>
            <string name="Source"><![CDATA[--[[
	Sync: sends each player their own state, plus notifications and effects.

	Full "State" snapshots go out when something changes (throttled); a light
	"Tick" goes out every second with coins, income and protection timers.
]]

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Remotes = require(Shared.Remotes)
local Util = require(script.Parent.Parent.Util)

local Sync = {}

local S
local dirty = {}
local stateRemote, tickRemote, notifyRemote, effectRemote, dialogRemote

function Sync.markDirty(owner)
	if owner and owner.player then
		dirty[owner] = true
	end
end

local function protectionInfo(owner)
	local st = S.Protection.state(owner)
	return {
		arrival = st.arrival,
		arrivalLeft = st.arrivalLeft,
		moved = owner.moved,
		newStacker = st.newStacker,
		newStackerLeft = st.newStackerLeft,
		napping = st.napping,
		ruffledLeft = st.ruffledLeft,
		shieldLeft = st.shieldLeft,
		shieldReadyIn = st.shieldReadyIn,
		devNoProtection = owner.devNoProtection,
	}
end

function Sync.buildState(owner)
	local data = owner.data
	local ground = {}
	if owner.ground then
		for uid in owner.ground do
			table.insert(ground, uid)
		end
	end
	local carrying = nil
	if owner.carry then
		carrying = {
			id = owner.carry.entry.id,
			m = owner.carry.entry.m,
			fromName = owner.carry.from.name,
			started = owner.carry.start,
		}
	end
	local ticket = nil
	if owner.ticket then
		local target = S.Plots.byKey[owner.ticket.targetKey]
		ticket = {
			name = owner.ticket.targetName,
			expires = owner.ticket.expires,
			plot = target and target.plot and target.plot.index or 0,
		}
	end
	return {
		coins = data.coins,
		rate = Economy.totalRate(data, owner.napping),
		tower = data.tower,
		box = data.box,
		cushions = data.cushions,
		held = data.held,
		upgrades = data.upgrades,
		index = data.index,
		ribbons = data.ribbons,
		quests = data.quests,
		stats = data.stats,
		settings = data.settings,
		tutorial = data.tutorial,
		ground = ground,
		carrying = carrying,
		ticket = ticket,
		plotIndex = owner.plot and owner.plot.index or 0,
		canSave = owner.canSave,
		isStudio = RunService:IsStudio(),
		protection = protectionInfo(owner),
		toppling = owner.host and owner.host.toppling or false,
		inSession = owner.session ~= nil,
	}
end

function Sync.tick(owner, rate: number)
	if owner.player then
		tickRemote:FireClient(owner.player, {
			coins = owner.data.coins,
			rate = rate,
			protection = protectionInfo(owner),
			napping = owner.napping,
		})
	end
end

-- kind: "info" | "good" | "warn" | "rare" | "legendary"
function Sync.notify(owner, text: string, kind: string?, npc: string?)
	if owner and owner.player then
		notifyRemote:FireClient(owner.player, { text = text, kind = kind or "info", npc = npc })
	end
end

function Sync.notifyAll(text: string, kind: string?, npc: string?)
	notifyRemote:FireAllClients({ text = text, kind = kind or "info", npc = npc })
end

function Sync.effect(owner, payload)
	if owner and owner.player then
		effectRemote:FireClient(owner.player, payload)
	end
end

function Sync.effectAll(payload)
	effectRemote:FireAllClients(payload)
end

function Sync.dialog(owner, payload)
	if owner and owner.player then
		dialogRemote:FireClient(owner.player, payload)
	end
end

function Sync.init(services)
	S = services
	stateRemote = Remotes.get("State")
	tickRemote = Remotes.get("Tick")
	notifyRemote = Remotes.get("Notify")
	effectRemote = Remotes.get("Effect")
	dialogRemote = Remotes.get("Dialog")
	Remotes.get("ClientReady").OnServerEvent:Connect(function(player)
		local owner = S.Plots.get(player)
		if owner then
			Sync.markDirty(owner)
			S.Onboarding.resend(owner)
		end
	end)
	Remotes.get("SaveSettings").OnServerEvent:Connect(function(player, settings)
		local owner = S.Plots.get(player)
		if owner and type(settings) == "table" then
			local s = owner.data.settings
			if type(settings.calm) == "boolean" then
				s.calm = settings.calm
			end
			if type(settings.sfx) == "boolean" then
				s.sfx = settings.sfx
			end
			if type(settings.uiScale) == "number" and settings.uiScale == settings.uiScale then
				s.uiScale = math.clamp(settings.uiScale, 0.7, 1.4)
			end
		end
	end)
end

function Sync.start()
	while true do
		task.wait(0.15)
		for owner in dirty do
			dirty[owner] = nil
			if owner.player and owner.player.Parent and S.Plots.byKey[owner.key] == owner then
				local ok, err = pcall(function()
					stateRemote:FireClient(owner.player, Sync.buildState(owner))
				end)
				if not ok then
					warn("[Sync]", err)
				end
			end
		end
	end
end

-- Server time helper for other services.
Sync.now = Util.now

return Sync
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Towers</string>
            <string name="Source"><![CDATA[--[[
	Towers: the creature models standing on each base pad.

	A "host" is anything with a tower: a player's base pad or Sneaky Pete's
	practice tower. The tower itself is just the ordered list in the saved data;
	this service keeps the models in sync with that list.

	Wobble is decided by rules (Wobble.luau). Real physics only runs during a
	topple, for the fun "sproing", and then every creature snaps back into place
	(design doc 5.2 #3). Clients add the jiggle animation on top.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local CreatureModel = require(Shared.CreatureModel)
local TowerLayout = require(Shared.TowerLayout)
local Wobble = require(Shared.Wobble)

local Towers = {}

local S
local rng = Random.new()

function Towers.newHost(params)
	return {
		key = params.key,
		origin = params.origin,
		folder = params.folder,
		attributeTarget = params.attributeTarget,
		getEntries = params.getEntries,
		getGlue = params.getGlue,
		models = {},
		toppling = false,
		destroyed = false,
	}
end

function Towers.destroyHost(host)
	host.destroyed = true
	for _, model in host.models do
		model:Destroy()
	end
	host.models = {}
end

local function setAttributes(host)
	local target = host.attributeTarget
	if not target then
		return
	end
	local entries = host.getEntries()
	target:SetAttribute("Wobble", Wobble.ratio(entries, host.getGlue()))
	target:SetAttribute("TowerHeight", TowerLayout.height(entries))
	target:SetAttribute("Height", #entries)
end

-- Make the models match the tower list (creates, moves and removes models).
function Towers.refresh(host)
	if host.destroyed then
		return
	end
	if host.toppling then
		host.pendingRefresh = true
		return
	end
	local entries = host.getEntries()
	local cframes = TowerLayout.layout(entries, host.origin)
	local keep = {}
	for i, entry in entries do
		keep[entry.u] = true
		local model = host.models[entry.u]
		if model and (model.Parent ~= host.folder or model:GetAttribute("Mutation") ~= (entry.m or "")) then
			model:Destroy()
			model = nil
		end
		if not model then
			model = CreatureModel.build(entry.id, entry.m)
			if model then
				model.Name = entry.u
				model:SetAttribute("Uid", entry.u)
				model:PivotTo(cframes[i])
				model.Parent = host.folder
				host.models[entry.u] = model
			end
		else
			model:PivotTo(cframes[i])
		end
		if model then
			model:SetAttribute("Layer", i)
			model:SetAttribute("BasePos", cframes[i].Position)
		end
	end
	for uid, model in host.models do
		if not keep[uid] then
			model:Destroy()
			host.models[uid] = nil
		end
	end
	setAttributes(host)
end

-- World position of the top of the tower (where the next creature goes).
function Towers.topHeight(host): number
	return TowerLayout.height(host.getEntries())
end

-- Sproing! Creatures bounce off with real physics, then hop back in order.
function Towers.topple(host, onDone: (() -> ())?)
	if host.toppling or host.destroyed then
		return false
	end
	host.toppling = true
	if host.attributeTarget then
		host.attributeTarget:SetAttribute("Toppling", true)
	end
	for _, model in host.models do
		local root = model.PrimaryPart
		if root then
			CreatureModel.setCollide(model, true)
			root.Anchored = false
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
			root.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-20, 20), rng:NextNumber(18, 38), rng:NextNumber(-20, 20))
			root.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
		end
	end

	task.delay(2, function()
		if host.destroyed then
			return
		end
		local entries = host.getEntries()
		local cframes = TowerLayout.layout(entries, host.origin)
		local info = TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		for i, entry in entries do
			local model = host.models[entry.u]
			local root = model and model.Parent and model.PrimaryPart
			if root then
				root.Anchored = true
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				CreatureModel.setCollide(model, false)
				task.delay((i - 1) * 0.04, function()
					if root.Parent then
						TweenService:Create(root, info, { CFrame = cframes[i] }):Play()
					end
				end)
			end
		end
		task.wait(0.75 + #entries * 0.04)
		if host.destroyed then
			return
		end
		host.toppling = false
		host.pendingRefresh = false
		if host.attributeTarget then
			host.attributeTarget:SetAttribute("Toppling", false)
		end
		Towers.refresh(host)
		S.Sync.markDirty(S.Plots.byKey[host.key]) -- clears the owner's "toppling" flag
		S.Sync.effectAll({ kind = "Restack", key = host.key, pos = host.origin.Position })
		if onDone then
			onDone()
		end
	end)
	return true
end

-- Comfy Cushion: favorites sit beside the tower and can never be snatched.
function Towers.renderCushions(owner)
	local plot = owner.plot
	if not plot then
		return
	end
	plot.cushionFolder:ClearAllChildren()
	for slot, entry in owner.data.cushions do
		if type(entry) == "table" then
			local model = CreatureModel.build(entry.id, entry.m)
			if model then
				model.Name = entry.u
				model:SetAttribute("Uid", entry.u)
				model:SetAttribute("Cushion", slot)
				model:PivotTo(plot.cushionCF * CFrame.new((slot - 1) * -5, 0, 0))
				model.Parent = plot.cushionFolder
			end
		end
	end
end

-- Creatures that bounced off your own tower land on the ground next to it.
function Towers.renderGround(owner)
	local plot = owner.plot
	if not plot then
		return
	end
	owner.ground = owner.ground or {}
	local inBox = {}
	for _, entry in owner.data.box do
		inBox[entry.u] = entry
	end
	for _, child in plot.groundFolder:GetChildren() do
		local uid = child:GetAttribute("Uid")
		if not (uid and owner.ground[uid] and inBox[uid]) then
			child:Destroy()
		end
	end
	local k = 0
	for uid in owner.ground do
		local entry = inBox[uid]
		if not entry then
			owner.ground[uid] = nil
		elseif not plot.groundFolder:FindFirstChild(uid) then
			k += 1
			local model = CreatureModel.build(entry.id, entry.m)
			if model then
				model.Name = uid
				model:SetAttribute("Uid", uid)
				model:SetAttribute("Ground", true)
				model:PivotTo(plot.groundCF * CFrame.new(k * 3.5, 0, 0) * CFrame.Angles(0, rng:NextNumber(-1, 1), 0))
				model.Parent = plot.groundFolder
			end
		end
	end
end

-- The dome over a base pad: solid-ish for a Bubble Shield, faint for other
-- protections (Arrival Bubble, Nap Mode, New Stacker, Ruffled Feathers).
local DOME_COLORS = {
	Shield = Color3.fromRGB(150, 225, 255),
	Arrival = Color3.fromRGB(255, 190, 230),
	Nap = Color3.fromRGB(200, 180, 255),
	NewStacker = Color3.fromRGB(180, 255, 180),
	Ruffled = Color3.fromRGB(255, 225, 150),
}
function Towers.setDome(owner, kind: string?)
	local plot = owner.plot
	if not plot then
		return
	end
	local dome = plot.dome
	if not kind then
		dome.Transparency = 1
		return
	end
	local h = TowerLayout.height(owner.data.tower) + 10
	local d = Config.Map.PlateRadius * 2 + 12
	dome.Size = Vector3.new(d, math.max(d, h * 1.15), d)
	dome.CFrame = plot.origin * CFrame.new(0, math.max(d, h * 1.15) / 2 - 3, 0)
	dome.Color = DOME_COLORS[kind] or DOME_COLORS.Shield
	dome.Transparency = kind == "Shield" and 0.55 or 0.82
end

function Towers.init(services)
	S = services
end

return Towers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather: every ~15 minutes the sky does something silly for 2 minutes.
	Launch has one type, Sprinkle Rain: creatures stacked during it can come out
	Sprinkled. State lives on ReplicatedStorage.GameState so clients can show it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(script.Parent.Parent.Util)

local Weather = {}

local S
local W = Config.Weather
local active = false
local endsAt = 0
local nextAt = 0

local function state()
	return ReplicatedStorage:WaitForChild("GameState")
end

function Weather.isActive(): boolean
	return active and Util.now() < endsAt
end

function Weather.begin(duration: number?)
	active = true
	endsAt = Util.now() + (duration or W.Duration)
	nextAt = endsAt + W.Interval
	local gs = state()
	gs:SetAttribute("WeatherActive", true)
	gs:SetAttribute("WeatherName", "Sprinkle Rain")
	gs:SetAttribute("WeatherEndsAt", endsAt)
	gs:SetAttribute("NextWeatherAt", nextAt)
	S.Sync.notifyAll("BONK-BONK! It's Sprinkle Rain! Stack creatures now for a chance at Sprinkled!", "rare", "DJ Bonk")
end

local function finish()
	active = false
	local gs = state()
	gs:SetAttribute("WeatherActive", false)
	gs:SetAttribute("NextWeatherAt", nextAt)
	S.Sync.notifyAll("The Sprinkle Rain stopped. See you next time!", "info", "DJ Bonk")
end

function Weather.init(services)
	S = services
end

function Weather.start()
	nextAt = Util.now() + W.FirstDelay
	local gs = state()
	gs:SetAttribute("WeatherActive", false)
	gs:SetAttribute("NextWeatherAt", nextAt)
	while true do
		task.wait(1)
		local now = Util.now()
		if active and now >= endsAt then
			finish()
		elseif not active and now >= nextAt then
			Weather.begin()
		end
	end
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util: small server helpers shared by the services.
]]

local HttpService = game:GetService("HttpService")

local Util = {}

-- Server clock shared with clients (workspace:GetServerTimeNow()).
function Util.now(): number
	return workspace:GetServerTimeNow()
end

-- Short unique id for every creature, so a creature can only ever be in one place.
function Util.uid(): string
	return string.sub(string.gsub(HttpService:GenerateGUID(false), "-", ""), 1, 12)
end

function Util.flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Util.character(player: Player?)
	if not player then
		return nil, nil, nil
	end
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return character, nil, nil
	end
	return character, hrp, humanoid
end

function Util.findIndex(list: { any }, predicate: (any) -> boolean): number?
	for i, v in list do
		if predicate(v) then
			return i
		end
	end
	return nil
end

function Util.findByUid(list: { any }, uid: string): number?
	for i, v in list do
		if type(v) == "table" and v.u == uid then
			return i
		end
	end
	return nil
end

function Util.deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = Util.deepCopy(v)
	end
	return copy
end

-- Rate limiter: returns true at most once every `seconds` per key.
function Util.throttle(store: { [any]: number }, key: any, seconds: number): boolean
	local t = os.clock()
	if store[key] and t - store[key] < seconds then
		return false
	end
	store[key] = t
	return true
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
