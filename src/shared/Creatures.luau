Creatures.ById = {}
Creatures.ByRarity = {}
for index, def in Creatures.List do
	def.Number = index
	def.Wobble = def.Wobble or {}
	def.Bonus = def.Bonus or {}
	Creatures.ById[def.Id] = def
	Creatures.ByRarity[def.Rarity] = Creatures.ByRarity[def.Rarity] or {}
	table.insert(Creatures.ByRarity[def.Rarity], def)
end

function Creatures.get(id: string)
	return Creatures.ById[id]
end

-- Pick a random creature of the given rarity.
function Creatures.randomOfRarity(rarity: string, rng: Random)
	local pool = Creatures.ByRarity[rarity] or Creatures.ByRarity.Common
	return pool[rng:NextInteger(1, #pool)]
end

return Creatures
